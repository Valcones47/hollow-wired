#!/bin/bash
set -e

# Detect target real user and HOME (even if run under sudo)
REAL_USER="${SUDO_USER:-$USER}"
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
if [ -z "$USER_HOME" ]; then
  USER_HOME="$HOME"
fi

echo "========================================================="
echo "   Configurando SDDM (SilentSDDM + Hyprland + Wallust)   "
echo "========================================================="

# Locate dots directory robustly
DOTS_DIR=""
for candidate in \
  "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." 2>/dev/null && pwd)/dots" \
  "$USER_HOME/projetos/hyprland-setup/dots" \
  "$USER_HOME/projetos/hollow-wired/dots" \
  "$USER_HOME/.hollow-wired/dots"; do
  if [ -d "$candidate/sddm" ]; then
    DOTS_DIR="$candidate"
    break
  fi
done

THEME_DIR="/usr/share/sddm/themes/SilentSDDM"
if [ ! -d "$THEME_DIR" ]; then
  echo "==> Criando diretório de tema em $THEME_DIR..."
  mkdir -p "$THEME_DIR"
fi

if [ -n "$DOTS_DIR" ] && [ -d "$DOTS_DIR/sddm" ]; then
  echo "==> Instalando componentes customizados a partir de $DOTS_DIR..."
  mkdir -p "$THEME_DIR/components" "$THEME_DIR/configs" "$THEME_DIR/icons" "$THEME_DIR/backgrounds"
  cp -r "$DOTS_DIR/sddm/components/"* "$THEME_DIR/components/" 2>/dev/null || true
  cp -r "$DOTS_DIR/sddm/configs/"* "$THEME_DIR/configs/" 2>/dev/null || true
  cp -r "$DOTS_DIR/sddm/icons/"* "$THEME_DIR/icons/" 2>/dev/null || true
  
  if [ -f "$DOTS_DIR/bin/rice-sddm-sync-wallpaper" ]; then
    mkdir -p "$USER_HOME/.local/bin"
    cp "$DOTS_DIR/bin/rice-sddm-sync-wallpaper" "$USER_HOME/.local/bin/"
    chmod +x "$USER_HOME/.local/bin/rice-sddm-sync-wallpaper"
    chown "$REAL_USER:$REAL_USER" "$USER_HOME/.local/bin/rice-sddm-sync-wallpaper" 2>/dev/null || true
  fi
  
  if [ -f "$DOTS_DIR/wallust/templates/sddm-theme.conf" ]; then
    mkdir -p "$USER_HOME/.config/wallust/templates"
    cp "$DOTS_DIR/wallust/templates/sddm-theme.conf" "$USER_HOME/.config/wallust/templates/"
    chown -R "$REAL_USER:$REAL_USER" "$USER_HOME/.config/wallust" 2>/dev/null || true
  fi
fi

# Ensure backgrounds directory and current.png exist
mkdir -p "$THEME_DIR/backgrounds"
if [ ! -f "$THEME_DIR/backgrounds/current.png" ]; then
  if [ -f "$USER_HOME/.config/quickshell/wallpaper.png" ]; then
    cp "$USER_HOME/.config/quickshell/wallpaper.png" "$THEME_DIR/backgrounds/current.png"
  fi
fi

# Switch display-manager service
echo "==> Desativando plasmalogin.service e habilitando sddm.service com --force..."
systemctl disable plasmalogin.service 2>/dev/null || true
systemctl enable --force sddm.service

# Configure SDDM theme drop-in
echo "==> Escrevendo /etc/sddm.conf.d/theme.conf.user..."
mkdir -p /etc/sddm.conf.d
cat << 'EOF' > /etc/sddm.conf.d/theme.conf.user
[Theme]
Current=SilentSDDM

[General]
InputMethod=
EOF

# Fix /etc/sddm.conf if Session=plasma was set
if [ -f /etc/sddm.conf ]; then
  sed -i 's/Session=plasma/Session=hyprland/g' /etc/sddm.conf 2>/dev/null || true
fi

echo ""
echo "========================================================="
echo "  ✔ SDDM configurado e ativado com sucesso no sistema!   "
echo "  ✔ Tema SilentSDDM definido como padrão.                "
echo "  ✔ Próximo boot entrará diretamente na tela do SDDM!   "
echo "========================================================="
