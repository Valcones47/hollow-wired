#!/bin/bash
set -e
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
DOTS_DIR="$REPO_ROOT/dots"

THEME_DIR="/usr/share/sddm/themes/SilentSDDM"
if [ ! -d "$THEME_DIR" ]; then
  echo "AVISO: $THEME_DIR não encontrado. Se necessário, clone ou instale o SilentSDDM primeiro."
  exit 1
fi

echo "==> Instalando componentes customizados no SilentSDDM..."
cp -r "$DOTS_DIR/sddm/components/"* "$THEME_DIR/components/"
cp -r "$DOTS_DIR/sddm/configs/"* "$THEME_DIR/configs/"
cp -r "$DOTS_DIR/sddm/icons/"* "$THEME_DIR/icons/"

echo "==> Instalando scripts e templates..."
cp "$DOTS_DIR/bin/rice-sddm-sync-wallpaper" ~/.local/bin/rice-sddm-sync-wallpaper
chmod +x ~/.local/bin/rice-sddm-sync-wallpaper
mkdir -p ~/.config/wallust/templates
cp "$DOTS_DIR/wallust/templates/sddm-theme.conf" ~/.config/wallust/templates/

echo "==> Sincronizando wallpaper do SDDM..."
~/.local/bin/rice-sddm-sync-wallpaper || true

echo "==> Configurando o SDDM como display-manager do sistema..."
if [ "$EUID" -eq 0 ]; then
  SUDO=""
else
  SUDO="sudo"
fi

$SUDO systemctl disable plasmalogin.service 2>/dev/null || true
$SUDO systemctl enable sddm.service 2>/dev/null || true

$SUDO mkdir -p /etc/sddm.conf.d
echo -e "[Theme]\nCurrent=SilentSDDM" | $SUDO tee /etc/sddm.conf.d/theme.conf.user > /dev/null

echo "==> SDDM configurado e ativado com sucesso!"
