#!/usr/bin/env python3
"""rice-snapshots: Gerenciador de pontos de restauração Btrfs / Snapper."""

import json
import re
import subprocess
import sys


def get_snapshots(limit=10):
    cmd = ["sudo", "-n", "snapper", "-c", "root", "list"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        lines = res.stdout.strip().split("\n")
    except Exception as e:
        return {"error": str(e), "snapshots": []}

    snapshots = []
    # Pula as linhas de cabeçalho
    for line in lines[2:]:
        parts = [p.strip() for p in line.split("│")]
        if len(parts) >= 8:
            snap_id = parts[0]
            snap_type = parts[1]
            date_str = parts[3]
            user = parts[4]
            desc = parts[7]

            if snap_id.isdigit():
                snapshots.append({
                    "id": int(snap_id),
                    "type": snap_type,
                    "date": date_str,
                    "user": user,
                    "description": desc or "Ponto do Sistema",
                })

    # Inverte para mostrar os mais recentes primeiro
    snapshots.reverse()
    return {"error": None, "snapshots": snapshots[:limit]}


def create_snapshot(desc=""):
    if not desc:
        desc = "Ponto de Restauração Manual"
    cmd = ["sudo", "-n", "snapper", "-c", "root", "create", "-d", desc]
    try:
        subprocess.run(cmd, check=True)
        subprocess.run(["notify-send", "-a", "Sistema", "-i", "drive-harddisk", "-r", "91194", "-t", "2500", "Snapshot Btrfs Criado", desc], check=False)
        print(f"[✓] Snapshot criado com sucesso: {desc}")
        return True
    except Exception as e:
        print(f"[-] Erro ao criar snapshot: {e}", file=sys.stderr)
        return False


def delete_snapshot(snap_id):
    cmd = ["sudo", "-n", "snapper", "-c", "root", "delete", str(snap_id)]
    try:
        subprocess.run(cmd, check=True)
        subprocess.run(["notify-send", "-a", "Sistema", "-i", "drive-harddisk", "-r", "91194", "-t", "2500", "Snapshot Removido", f"Snapshot #{snap_id} excluído"], check=False)
        print(f"[✓] Snapshot #{snap_id} excluído")
        return True
    except Exception as e:
        print(f"[-] Erro ao excluir snapshot: {e}", file=sys.stderr)
        return False


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"

    if cmd == "list":
        limit = int(args[1]) if len(args) > 1 and args[1].isdigit() else 10
        print(json.dumps(get_snapshots(limit), ensure_ascii=False, indent=2))
    elif cmd == "create":
        desc = " ".join(args[1:]) if len(args) > 1 else ""
        create_snapshot(desc)
    elif cmd == "delete":
        if len(args) > 1:
            delete_snapshot(args[1])
    else:
        print("Uso: rice-snapshots [list [limit]|create [desc]|delete <id>]")


if __name__ == "__main__":
    main()
