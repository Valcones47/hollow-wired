#!/usr/bin/env bash
# ==============================================================================
# rice-portals: Inicialização e reset de portais XDG e variáveis de ambiente DBus
# Elimina o congelamento de 25 segundos no início de aplicativos no Hyprland
# ==============================================================================
set -e

sleep 1

# 1. Exporta variáveis Wayland para o ambiente do DBus e systemd --user
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY \
        DISPLAY \
        XDG_CURRENT_DESKTOP=Hyprland \
        XDG_SESSION_TYPE=wayland \
        XDG_SESSION_DESKTOP=Hyprland \
        QT_QPA_PLATFORMTHEME \
        2>/dev/null || true
fi

if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment \
        WAYLAND_DISPLAY \
        DISPLAY \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_TYPE \
        XDG_SESSION_DESKTOP \
        QT_QPA_PLATFORMTHEME \
        2>/dev/null || true

    # 2. Desativa e mascara o portal do GNOME (nunca usado neste rice, causa timeout de 25s)
    if systemctl --user list-unit-files 2>/dev/null | grep -q xdg-desktop-portal-gnome; then
        systemctl --user stop xdg-desktop-portal-gnome 2>/dev/null || true
        systemctl --user mask xdg-desktop-portal-gnome 2>/dev/null || true
    fi

    # O portal do KDE é usado de propósito (FileChooser/AppChooser=kde em portals.conf
    # para o seletor de arquivos abrir o Dolphin em vez do GTK claro) — garante que
    # nunca fique mascarado, mesmo se uma versão antiga deste script já tiver mascarado.
    # Atenção: o unit systemd real chama "plasma-xdg-desktop-portal-kde.service"
    # (não "xdg-desktop-portal-kde.service" — esse nome nunca existiu como unit de verdade).
    for kde_unit in plasma-xdg-desktop-portal-kde.service xdg-desktop-portal-kde.service; do
        if systemctl --user list-unit-files 2>/dev/null | grep -q "^$kde_unit"; then
            systemctl --user unmask "$kde_unit" 2>/dev/null || true
        fi
    done

    # 3. Reinicia os serviços de portal na ordem correta
    # (o portal do KDE é ativado sob demanda via DBus quando um FileChooser é pedido,
    # não precisa nem deve ser iniciado manualmente aqui)
    systemctl --user stop xdg-desktop-portal-hyprland xdg-desktop-portal-gtk xdg-desktop-portal 2>/dev/null || true
    sleep 0.5
    systemctl --user start xdg-desktop-portal-hyprland 2>/dev/null || true
    systemctl --user start xdg-desktop-portal-gtk 2>/dev/null || true
    systemctl --user start xdg-desktop-portal 2>/dev/null || true
fi
