#!/bin/bash
# rice-doctor - Diagnóstico e reparação rápida do Rice e Sistema
# Feito para ser simples, visual e intuitivo para qualquer usuário.

C_RED='\033[1;31m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_BLUE='\033[1;34m'
C_CYAN='\033[1;36m'
C_RESET='\033[0m'
C_BOLD='\033[1m'

clear
echo -e "${C_CYAN}==============================================================${C_RESET}"
echo -e "${C_BOLD}          🏥 RICE DOCTOR — DIAGNÓSTICO & REPARADOR           ${C_RESET}"
echo -e "${C_CYAN}==============================================================${C_RESET}"
echo ""

# 1. Áudio (PipeWire / WirePlumber)
echo -ne "${C_BOLD}1. Servidor de Áudio (PipeWire)... ${C_RESET}"
if systemctl --user is-active --quiet pipewire && systemctl --user is-active --quiet wireplumber; then
  echo -e "${C_GREEN}[✔ ONLINE]${C_RESET}"
else
  echo -e "${C_RED}[✖ COM PROBLEMAS]${C_RESET}"
  BAD_AUDIO=1
fi

# 2. Banco do Pacman (db.lck)
echo -ne "${C_BOLD}2. Trava do Gerenciador de Pacotes (db.lck)... ${C_RESET}"
if [ -f /var/lib/pacman/db.lck ]; then
  echo -e "${C_RED}[✖ TRAVA ENCONTRADA]${C_RESET} (Pacman travado ou interrompido)"
  BAD_PACMAN=1
else
  echo -e "${C_GREEN}[✔ LIVRE]${C_RESET}"
fi

# 3. Cache do Pacman e Disco
echo -ne "${C_BOLD}3. Espaço em Disco (/)... ${C_RESET}"
DISK_USAGE=$(df -h / | awk 'NR==2 {print $5}')
DISK_FREE=$(df -h / | awk 'NR==2 {print $4}')
echo -e "${C_GREEN}[✔ $DISK_FREE LIVRE ($DISK_USAGE USADO)]${C_RESET}"

# 4. Display Manager (SDDM vs Plasmalogin)
echo -ne "${C_BOLD}4. Gerenciador de Login (Display Manager)... ${C_RESET}"
DM_LINK=$(readlink -f /etc/systemd/system/display-manager.service 2>/dev/null || echo "")
if [[ "$DM_LINK" =~ sddm ]]; then
  echo -e "${C_GREEN}[✔ SDDM ATIVO]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ INCONSISTENTE]${C_RESET} (Atual: $(basename "$DM_LINK"))"
  BAD_DM=1
fi

# 5. Memória e zRAM
echo -ne "${C_BOLD}5. Módulo zRAM / Swap Comprimido... ${C_RESET}"
if swapon --show | grep -q zram; then
  ZRAM_SIZE=$(swapon --show --bytes | awk '/zram/ {printf "%.1f GiB", $3/1073741824}')
  echo -e "${C_GREEN}[✔ ATIVO ($ZRAM_SIZE)]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ NÃO DETECTADO]${C_RESET}"
fi

# 6. Compositor Hyprland & Quickshell
echo -ne "${C_BOLD}6. Shell Gráfico (Quickshell)... ${C_RESET}"
if pgrep -x quickshell >/dev/null; then
  echo -e "${C_GREEN}[✔ RODANDO]${C_RESET}"
else
  echo -e "${C_RED}[✖ PARADO]${C_RESET}"
  BAD_QS=1
fi

# 7. Placa Gráfica
# Só cobra driver NVIDIA em quem tem NVIDIA: antes a checagem era fixa e todo
# PC AMD/Intel via um alarme vermelho de "driver não carregado" sem motivo.
HAS_NVIDIA=0
lspci 2>/dev/null | grep -Ei "vga|3d|display" | grep -qi "nvidia" && HAS_NVIDIA=1

if [ "$HAS_NVIDIA" = "1" ]; then
  GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -n 1)
  [ -z "$GPU_NAME" ] && GPU_NAME=$(lspci 2>/dev/null | grep -Ei "vga|3d" | grep -i "nvidia" | sed 's/.*: //g' | head -n 1)
  echo -ne "${C_BOLD}7. Placa Gráfica (${GPU_NAME:-NVIDIA})... ${C_RESET}"
  if nvidia-smi &>/dev/null; then
    echo -e "${C_GREEN}[✔ PRONTA (Driver Ativo)]${C_RESET}"
    if [ -f /sys/module/nvidia_drm/parameters/modeset ]; then
      MODESET=$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null)
      if [ "$MODESET" = "Y" ]; then
        echo -e "   ${C_CYAN}└─ DRM Kernel Modesetting (nvidia-drm.modeset=1): [✔ ATIVO]${C_RESET}"
      else
        echo -e "   ${C_YELLOW}└─ DRM Modeset: [⚠ INATIVO] (Configure nvidia-drm.modeset=1)${C_RESET}"
      fi
    fi
  else
    echo -e "${C_YELLOW}[⚠ DRIVER NÃO CARREGADO OU GPU SUSPENSA]${C_RESET}"
  fi
else
  GPU_NAME=$(lspci 2>/dev/null | grep -Ei "vga|3d|display" | sed 's/.*: //g' | head -n 1)
  echo -ne "${C_BOLD}7. Placa Gráfica (${GPU_NAME:-integrada})... ${C_RESET}"
  if [ -e /dev/dri/renderD128 ]; then
    echo -e "${C_GREEN}[✔ ACELERAÇÃO ATIVA (Mesa)]${C_RESET}"
  else
    echo -e "${C_YELLOW}[⚠ SEM NÓ DE RENDER EM /dev/dri]${C_RESET}"
  fi
fi

# 8. Tema de Ícones do Sistema
echo -ne "${C_BOLD}8. Tema de Ícones (Papirus / GTK)... ${C_RESET}"
if [ -d /usr/share/icons/Papirus ] || [ -d "$HOME/.local/share/icons/Papirus" ]; then
  echo -e "${C_GREEN}[✔ PAPIRUS DETECTADO]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ NÃO INSTALADO]${C_RESET} (Execute: sudo pacman -S --needed papirus-icon-theme)"
  BAD_ICONS=1
fi

# 9. Portais XDG & Comunicação DBus (Elimina delay de 25s)
echo -ne "${C_BOLD}9. Portais XDG & Comunicação DBus... ${C_RESET}"
if systemctl --user is-active --quiet xdg-desktop-portal && systemctl --user is-active --quiet xdg-desktop-portal-hyprland; then
  echo -e "${C_GREEN}[✔ PORTAIS ATIVOS]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ INCONSISTENTES / TIMEOUT]${C_RESET}"
  BAD_PORTALS=1
fi

# 10. Papel de parede (área de trabalho preta é o problema nº 1 de quem instala
# o rice sem o Wallpaper Engine)
echo -ne "${C_BOLD}10. Papel de Parede... ${C_RESET}"
if pgrep -f waywallen-layer-shell >/dev/null 2>&1; then
  echo -e "${C_GREEN}[✔ WALLPAPER ENGINE ATIVO]${C_RESET}"
elif pgrep -x hyprpaper >/dev/null 2>&1; then
  echo -e "${C_GREEN}[✔ WALLPAPER ESTÁTICO ATIVO]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ NENHUM WALLPAPER ATIVO]${C_RESET} (área de trabalho preta)"
  BAD_WALLPAPER=1
fi

# 11. Agente de autenticação (sem ele, nada que pede senha de administrador abre)
echo -ne "${C_BOLD}11. Janela de Senha (polkit)... ${C_RESET}"
if pgrep -f "polkit-.*authentication-agent" >/dev/null 2>&1 || pgrep -f polkit-kde >/dev/null 2>&1; then
  echo -e "${C_GREEN}[✔ ATIVO]${C_RESET}"
else
  echo -e "${C_YELLOW}[⚠ NÃO ESTÁ RODANDO]${C_RESET} (pedidos de senha podem falhar em silêncio)"
  BAD_POLKIT=1
fi

# 12. Persistência da área de transferência
echo -ne "${C_BOLD}12. Área de Transferência Persistente... ${C_RESET}"
if pgrep -x wl-clip-persist >/dev/null 2>&1; then
  echo -e "${C_GREEN}[✔ ATIVA]${C_RESET}"
elif command -v wl-clip-persist >/dev/null 2>&1; then
  echo -e "${C_YELLOW}[⚠ INSTALADA, MAS PARADA]${C_RESET}"
  BAD_CLIP=1
else
  echo -e "${C_YELLOW}[⚠ NÃO INSTALADA]${C_RESET} (o que você copia some ao fechar o programa)"
  BAD_CLIP=1
fi

echo ""
echo -e "${C_CYAN}--------------------------------------------------------------${C_RESET}"
echo -e "${C_BOLD}AÇÕES DE REPARAÇÃO RÁPIDA:${C_RESET}"
echo -e " [1] Reiniciar sistema de áudio (PipeWire & WirePlumber)"
echo -e " [2] Destravar o Pacman (remover db.lck)"
echo -e " [3] Limpar cache de pacotes antigos do pacman (liberar espaço)"
echo -e " [4] Configurar e ativar a tela de login SDDM + Limine"
echo -e " [5] Reiniciar o Quickshell (recarregar barras e menus)"
echo -e " [6] Reparar tema de ícones e compatibilidade de pixmaps"
echo -e " [7] Reparar e reiniciar portais XDG (elimina delay de 25s em apps)"
echo -e " [8] Definir um papel de parede (resolve área de trabalho preta)"
echo -e " [9] Instalar/ativar área de transferência persistente e janela de senha"
echo -e " [A] Executar limpeza e reparos recomendados automaticamente"
echo -e " [0] Sair"
echo -e "${C_CYAN}--------------------------------------------------------------${C_RESET}"
echo -n "Escolha uma opção [0-9 / A]: "
read -r OPT

case "$OPT" in
  1)
    echo -e "\n${C_BLUE}==> Reiniciando áudio PipeWire...${C_RESET}"
    systemctl --user restart pipewire pipewire-pulse wireplumber
    echo -e "${C_GREEN}✔ Áudio reiniciado com sucesso!${C_RESET}"
    ;;
  2)
    echo -e "\n${C_BLUE}==> Removendo trava do pacman...${C_RESET}"
    sudo rm -f /var/lib/pacman/db.lck
    echo -e "${C_GREEN}✔ Pacman destravado!${C_RESET}"
    ;;
  3)
    echo -e "\n${C_BLUE}==> Limpando cache do pacman...${C_RESET}"
    sudo paccache -rk2 2>/dev/null || sudo pacman -Sc --noconfirm
    echo -e "${C_GREEN}✔ Cache limpo!${C_RESET}"
    ;;
  4)
    echo -e "\n${C_BLUE}==> Configurando SDDM e Limine...${C_RESET}"
    sudo rice-apply-boot-login
    ;;
  5)
    echo -e "\n${C_BLUE}==> Reiniciando o Quickshell...${C_RESET}"
    rice-restart
    ;;
  6)
    echo -e "\n${C_BLUE}==> Reparando tema de ícones e pixmaps...${C_RESET}"
    sudo pacman -S --needed --noconfirm papirus-icon-theme breeze-icons 2>/dev/null || true
    sudo ln -sf /usr/share/icons/*.png /usr/share/pixmaps/ 2>/dev/null || true
    if command -v gsettings >/dev/null 2>&1; then
      gsettings set org.gnome.desktop.interface icon-theme "Papirus-Dark" 2>/dev/null || true
    fi
    echo -e "${C_GREEN}✔ Tema de ícones configurado!${C_RESET}"
    ;;
  7)
    echo -e "\n${C_BLUE}==> Reparando e reiniciando portais XDG...${C_RESET}"
    sudo pacman -S --needed --noconfirm xdg-desktop-portal-gtk 2>/dev/null || true
    rice-portals
    echo -e "${C_GREEN}✔ Portais XDG reiniciados com sucesso!${C_RESET}"
    ;;
  8)
    echo -e "\n${C_BLUE}==> Abrindo o seletor de papel de parede...${C_RESET}"
    if command -v rice-wallpaper-set >/dev/null 2>&1; then
      rice-wallpaper-set || rice-wallpaper-set --generate
    else
      echo -e "${C_YELLOW}rice-wallpaper-set não encontrado (rode o install.sh de novo).${C_RESET}"
    fi
    ;;
  9)
    echo -e "\n${C_BLUE}==> Instalando e ativando serviços de sessão...${C_RESET}"
    sudo pacman -S --needed --noconfirm wl-clip-persist polkit-kde-agent 2>/dev/null || true
    pgrep -x wl-clip-persist >/dev/null 2>&1 || (setsid wl-clip-persist --clipboard regular >/dev/null 2>&1 &)
    pgrep -f "polkit-.*authentication-agent" >/dev/null 2>&1 || (setsid /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &)
    echo -e "${C_GREEN}✔ Serviços de sessão ativos!${C_RESET}"
    ;;
  [aA])
    echo -e "\n${C_BLUE}==> Executando rotina automática de reparos...${C_RESET}"
    systemctl --user restart pipewire pipewire-pulse wireplumber 2>/dev/null || true
    if [ -f /var/lib/pacman/db.lck ]; then
      sudo rm -f /var/lib/pacman/db.lck 2>/dev/null || true
    fi
    sudo paccache -rk2 2>/dev/null || true
    if [ "$BAD_ICONS" = "1" ]; then
      sudo pacman -S --needed --noconfirm papirus-icon-theme breeze-icons 2>/dev/null || true
      sudo ln -sf /usr/share/icons/*.png /usr/share/pixmaps/ 2>/dev/null || true
      gsettings set org.gnome.desktop.interface icon-theme "Papirus-Dark" 2>/dev/null || true
    fi
    if [ "$BAD_PORTALS" = "1" ]; then
      sudo pacman -S --needed --noconfirm xdg-desktop-portal-gtk 2>/dev/null || true
      rice-portals
    fi
    if [ "$BAD_CLIP" = "1" ]; then
      sudo pacman -S --needed --noconfirm wl-clip-persist 2>/dev/null || true
      pgrep -x wl-clip-persist >/dev/null 2>&1 || (setsid wl-clip-persist --clipboard regular >/dev/null 2>&1 &)
    fi
    if [ "$BAD_POLKIT" = "1" ]; then
      sudo pacman -S --needed --noconfirm polkit-kde-agent 2>/dev/null || true
      pgrep -f "polkit-.*authentication-agent" >/dev/null 2>&1 || (setsid /usr/lib/polkit-kde-authentication-agent-1 >/dev/null 2>&1 &)
    fi
    if [ "$BAD_WALLPAPER" = "1" ] && command -v rice-wallpaper-set >/dev/null 2>&1; then
      rice-wallpaper-set --ensure >/dev/null 2>&1 || true
    fi
    echo -e "${C_GREEN}✔ Reparos automáticos concluídos!${C_RESET}"
    ;;
  *)
    echo -e "\nSaindo..."
    ;;
esac

echo ""
read -n 1 -s -r -p "Pressione qualquer tecla para finalizar..."
echo ""
