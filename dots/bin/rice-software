#!/usr/bin/env bash
# ==============================================================================
# rice-software — estado das atualizações e kits de aplicativos do rice.
#
# Esta ferramenta NÃO tenta ser uma loja de aplicativos: o Shelly (ou outro
# gerenciador gráfico instalado) já faz isso muito melhor, com busca, AUR,
# Flatpak, AppImage, detalhes e remoção. O antigo catálogo de 22 aplicativos
# soltos aqui dentro era uma versão pior disso — e ainda instalava com `yay`
# fixo, sem olhar qual AUR helper a pessoa tem.
#
# O que sobrou é o que a loja não faz:
#   • contagem unificada de atualizações (oficiais + AUR + Flatpak + dotfiles do rice);
#   • atualização das dotfiles do próprio rice;
#   • atalho para abrir o gerenciador gráfico que estiver instalado.
#
# Uso:
#   rice-software status        # JSON com atualizações pendentes
#   rice-software install <pkg...>
#   rice-software open-store    # abre o gerenciador gráfico de programas
#   rice-software update-system # atualiza tudo em uma janela de terminal
#   rice-software update-rice   # atualiza as dotfiles do rice
# ==============================================================================

set -uo pipefail

# Gerenciador gráfico de programas preferido do usuário. Shelly primeiro: está
# no repositório do CachyOS e é recompilado junto com o pacman. O Pamac vem do
# AUR, não tem suporte oficial no Arch e quebra a cada atualização da libalpm
# até alguém recompilar — continua na lista só para quem ainda o tem.
STORE_CANDIDATES=(shelly-ui pamac-manager octopi discover gnome-software)

# yay primeiro (escolha do projeto); paru só quando não houver yay.
aur_helper() {
    if command -v yay >/dev/null 2>&1; then echo "yay"
    elif command -v paru >/dev/null 2>&1; then echo "paru"
    elif command -v shelly >/dev/null 2>&1; then echo "shelly"
    elif command -v pamac >/dev/null 2>&1; then echo "pamac"
    else echo ""; fi
}

find_store() {
    for s in "${STORE_CANDIDATES[@]}"; do
        if command -v "$s" >/dev/null 2>&1; then
            echo "$s"
            return 0
        fi
    done
    echo ""
}

check_updates() {
    local repo_count=0 repo_pkgs="[]" aur_count=0 flatpak_count=0

    if command -v checkupdates >/dev/null 2>&1; then
        local raw
        raw=$(checkupdates 2>/dev/null || true)
        if [ -n "$raw" ]; then
            repo_count=$(printf '%s\n' "$raw" | grep -c . || true)
            repo_pkgs=$(printf '%s\n' "$raw" | head -n 12 | awk '{print $1}' | jq -R . | jq -s .)
        fi
    fi

    # AUR e Flatpak não apareciam na contagem antiga — o painel dizia "tudo em
    # dia" com dezenas de pacotes do AUR pendentes.
    local helper
    helper=$(aur_helper)
    if [ "$helper" = "paru" ]; then
        aur_count=$(paru -Qua 2>/dev/null | grep -c . || true)
    elif [ "$helper" = "yay" ]; then
        aur_count=$(yay -Qua 2>/dev/null | grep -c . || true)
    fi

    if command -v flatpak >/dev/null 2>&1; then
        flatpak_count=$(flatpak remote-ls --updates 2>/dev/null | grep -c . || true)
    fi

    local rice_updates=0 rice_info="{}"
    if command -v rice-update >/dev/null 2>&1; then
        rice_info=$(rice-update check 2>/dev/null || echo '{}')
        rice_updates=$(echo "$rice_info" | jq -r '.count // 0' 2>/dev/null || echo 0)
    fi

    # Blinda contra saída vazia ou com quebras de linha vinda dos comandos acima.
    for var in repo_count aur_count flatpak_count rice_updates; do
        value=$(printf '%s' "${!var}" | head -1 | tr -cd '0-9')
        printf -v "$var" '%s' "${value:-0}"
    done

    local store
    store=$(find_store)

    local sys_count=$((repo_count + aur_count + flatpak_count))
    local total_count=$((sys_count + rice_updates))

    jq -n \
        --argjson count "$total_count" \
        --argjson sys_count "$sys_count" \
        --argjson repo_count "$repo_count" \
        --argjson aur_count "$aur_count" \
        --argjson flatpak_count "$flatpak_count" \
        --argjson packages "$repo_pkgs" \
        --argjson rice_updates "$rice_updates" \
        --argjson rice_info "$rice_info" \
        --arg store "$store" \
        --arg checked_at "$(date +'%d/%m %H:%M')" \
        '{count: $count, sys_count: $sys_count, repo_count: $repo_count, aur_count: $aur_count,
          flatpak_count: $flatpak_count, packages: $packages, rice_updates: $rice_updates,
          rice_info: $rice_info, store: $store, checked_at: $checked_at}'
}

install_packages() {
    local pkgs=("$@")
    [ ${#pkgs[@]} -eq 0 ] && { echo "Nada a instalar" >&2; return 1; }

    local helper
    helper=$(aur_helper)
    local cmd
    if [ "$helper" = "paru" ]; then
        cmd="paru -S --needed ${pkgs[*]}"
    elif [ "$helper" = "yay" ]; then
        cmd="yay -S --needed ${pkgs[*]}"
    elif [ "$helper" = "shelly" ]; then
        cmd="shelly install ${pkgs[*]}"
    elif [ "$helper" = "pamac" ]; then
        cmd="pamac install ${pkgs[*]}"
    else
        cmd="sudo pacman -S --needed ${pkgs[*]}"
    fi

    notify-send -a "Programas" -i system-software-install -r 91197 -t 3000 \
        "Instalando ${#pkgs[@]} programa(s)..." "Acompanhe na janela do terminal que abriu." 2>/dev/null

    local term="${TERMINAL:-kitty}"
    command -v "$term" >/dev/null 2>&1 || term="kitty"
    "$term" --title "Instalando programas" -e bash -c "
echo '===================================================='
echo '  Instalando: ${pkgs[*]}'
echo '===================================================='
echo
$cmd
echo
echo 'Pronto! Pressione ENTER para fechar.'
read" &
}

open_store() {
    local store
    store=$(find_store)
    if [ -n "$store" ]; then
        nohup "$store" >/dev/null 2>&1 &
        return 0
    fi
    # Nenhum gerenciador gráfico: oferece instalar o Shelly. Ele está no
    # repositório do CachyOS; em outras distros Arch vem do AUR.
    notify-send -a "Programas" -i dialog-information -t 5000 \
        "Nenhuma loja de programas instalada" "Abrindo a instalação do Shelly..." 2>/dev/null
    install_packages shelly
}

update_system() {
    local helper
    helper=$(aur_helper)
    local cmd="sudo pacman -Syu"
    [ "$helper" = "paru" ] && cmd="paru -Syu"
    [ "$helper" = "yay" ] && cmd="yay -Syu"
    [ "$helper" = "shelly" ] && cmd="shelly upgrade -a"
    [ "$helper" = "pamac" ] && cmd="pamac update -a"

    notify-send -a "Atualização do Sistema" -i system-software-update -r 91197 -t 3000 \
        "Iniciando atualização..." "Uma janela do terminal foi aberta." 2>/dev/null

    local term="${TERMINAL:-kitty}"
    command -v "$term" >/dev/null 2>&1 || term="kitty"
    "$term" --title "Atualização do Sistema" -e bash -c "
echo '===================================================='
echo '  Atualização geral do sistema'
echo '===================================================='
echo
$cmd
if command -v flatpak >/dev/null 2>&1; then
    echo
    echo '--- Flatpak ---'
    flatpak update -y
fi
echo
echo 'Atualização concluída! Pressione ENTER para fechar.'
read" &
}

cmd="${1:-status}"

case "$cmd" in
    status|updates)
        check_updates
        ;;
    install)
        shift
        install_packages "$@"
        ;;
    open-store|store)
        open_store
        ;;
    launch|run)
        target="${2:-}"
        [ -z "$target" ] && { echo "Uso: $(basename "$0") launch <programa>" >&2; exit 1; }
        nohup "$target" >/dev/null 2>&1 &
        ;;
    update-system)
        update_system
        ;;
    update-rice)
        rice-update gui
        ;;
    *)
        sed -n '2,26p' "$0"
        exit 1
        ;;
esac
