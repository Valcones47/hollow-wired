check_updates() {
    local count=0
    local raw=""
    local pkgs="[]"

    if command -v checkupdates &>/dev/null; then
        raw=$(checkupdates 2>/dev/null || true)
        if [ -n "$raw" ]; then
            count=$(echo "$raw" | grep -c . || echo 0)
            pkgs=$(echo "$raw" | head -n 12 | awk '{print $1}' | jq -R . | jq -s .)
        fi
    fi

    local rice_updates=0
    local rice_info="{}"
    if command -v rice-update &>/dev/null; then
        rice_info=$(rice-update check 2>/dev/null || echo '{}')
        rice_updates=$(echo "$rice_info" | jq -r '.count // 0' 2>/dev/null || echo 0)
    fi

    local total_count=$((count + rice_updates))
    local date_str
    date_str=$(date +"%d/%m %H:%M")

    echo "{\"count\": $total_count, \"packages\": $pkgs, \"sys_count\": $count, \"rice_updates\": $rice_updates, \"rice_info\": $rice_info, \"checked_at\": \"$date_str\"}"
}

list_apps() {
    python3 -c '
import json, shutil, subprocess, sys

catalog = json.loads("""'"$APPS_CATALOG"'""")
results = []

for app in catalog:
    exe = app.get("exec", "")
    pkg = app.get("pkg", "")
    installed = False

    # Checagem rapida por binary
    if shutil.which(exe):
        installed = True
    elif shutil.which(app["id"]):
        installed = True
    else:
        # Checagem pacman
        res = subprocess.run(["pacman", "-Qq", pkg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if res.returncode == 0:
            installed = True

    app["installed"] = installed
    results.append(app)

print(json.dumps(results, indent=2))
'
}

install_app() {
    local target="$1"
    local pkg=""
    pkg=$(echo "$APPS_CATALOG" | jq -r --arg id "$target" '.[] | select(.id == $id or .pkg == $id) | .pkg')
    if [ -z "$pkg" ] || [ "$pkg" = "null" ]; then
        pkg="$target"
    fi

    notify-send -a "Central de Softwares" -i system-software-install -r 91197 -t 3000 "Instalando $pkg..." "Uma janela de terminal foi aberta para acompanhar a instalação."

    kitty --title "Instalação: $pkg" -e bash -c "
echo -e '\e[1;36m====================================================\e[0m'
echo -e '\e[1;32m  Central de Softwares: Instalando $pkg  \e[0m'
echo -e '\e[1;36m====================================================\e[0m'
echo ''
yay -S --needed $pkg
echo ''
echo -e '\e[1;32mInstalação finalizada!\e[0m Pressione ENTER para fechar.'
read
" &
}

uninstall_app() {
    local target="$1"
    local pkg=""
    pkg=$(echo "$APPS_CATALOG" | jq -r --arg id "$target" '.[] | select(.id == $id or .pkg == $id) | .pkg')
    if [ -z "$pkg" ] || [ "$pkg" = "null" ]; then
        pkg="$target"
    fi

    kitty --title "Desinstalação: $pkg" -e bash -c "
echo -e '\e[1;31m====================================================\e[0m'
echo -e '\e[1;33m  Central de Softwares: Desinstalar $pkg  \e[0m'
echo -e '\e[1;31m====================================================\e[0m'
echo ''
sudo pacman -Rns $pkg
echo ''
echo -e '\e[1;32mConcluído!\e[0m Pressione ENTER para fechar.'
read
" &
}

launch_app() {
    local target="$1"
    local exe=""
    exe=$(echo "$APPS_CATALOG" | jq -r --arg id "$target" '.[] | select(.id == $id or .exec == $id) | .exec')
    if [ -z "$exe" ] || [ "$exe" = "null" ]; then
        exe="$target"
    fi

    nohup "$exe" &>/dev/null &
    notify-send -a "Aplicativo" -i application-x-executable -r 91198 -t 2000 "Iniciando $target" "O aplicativo está sendo iniciado..."
}

update_system() {
    notify-send -a "Atualização do Sistema" -i system-software-update -r 91197 -t 3000 "Iniciando Atualização..." "Uma janela do terminal foi aberta para aplicar os pacotes com segurança."

    kitty --title "Atualização do Sistema Arch Linux" -e bash -c "
echo -e '\e[1;35m====================================================\e[0m'
echo -e '\e[1;32m  Atualização Geral do Sistema (Arch Linux / CachyOS)  \e[0m'
echo -e '\e[1;35m====================================================\e[0m'
echo ''
yay -Syu
echo ''
echo -e '\e[1;32mAtualização concluída com sucesso!\e[0m Pressione ENTER para fechar.'
read
" &
}

cmd="${1:-status}"

case "$cmd" in
    status|updates)
        check_updates
        ;;
    apps|catalog)
        list_apps
        ;;
    install)
        target="${2:-}"
        if [ -z "$target" ]; then
            echo "Uso: $(basename "$0") install <id_ou_pacote>" >&2
            exit 1
        fi
        install_app "$target"
        ;;
    uninstall|remove)
        target="${2:-}"
        if [ -z "$target" ]; then
            echo "Uso: $(basename "$0") uninstall <id_ou_pacote>" >&2
            exit 1
        fi
        uninstall_app "$target"
        ;;
    launch|run)
        target="${2:-}"
        if [ -z "$target" ]; then
            echo "Uso: $(basename "$0") launch <id_ou_exec>" >&2
            exit 1
        fi
        launch_app "$target"
        ;;
    update-system)
        update_system
        ;;
    update-rice)
        rice-update gui
        ;;
    *)
        echo "Uso: $(basename "$0") [status|apps|install <id>|uninstall <id>|launch <id>|update-system|update-rice]"
        exit 1
        ;;
esac
