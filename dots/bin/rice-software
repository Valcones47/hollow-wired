#!/usr/bin/env bash
# ==============================================================================
# rice-software — estado das atualizações e kits de aplicativos do rice.
#
# Esta ferramenta NÃO tenta ser uma loja de aplicativos: o Shelly (ou outro
# gerenciador gráfico instalado) já faz isso muito melhor, com busca, AUR,
# Flatpak, AppImage, detalhes e remoção. O antigo catálogo de 22 aplicativos
# soltos aqui dentro era uma versão pior disso — e ainda instalava com `yay`
# fixo, sem olhar qual AUR helper a pessoa tem.
#
# O que sobrou é o que a loja não faz:
#   • contagem unificada de atualizações (oficiais + AUR + Flatpak + dotfiles do rice);
#   • atualização das dotfiles do próprio rice;
#   • atalho para abrir o gerenciador gráfico que estiver instalado.
#
# Uso:
#   rice-software status        # JSON com atualizações pendentes
#   rice-software install <pkg...>
#   rice-software open-store    # abre o gerenciador gráfico de programas
#   rice-software update-system [--no-confirm]  # atualiza tudo em um terminal
#   rice-software update-mode [quick|full]      # modo do botão de atualizar
#   rice-software update-default                # abre o modo escolhido
#   rice-software update-rice   # atualiza as dotfiles do rice
#   rice-software list          # JSON com os pacotes pendentes por origem
#   rice-software update-selected repo,aur,flatpak,rice [--terminal]
#                               # atualiza só as origens marcadas, sem perguntas
# ==============================================================================

set -uo pipefail

# Gerenciador gráfico de programas preferido do usuário. Shelly primeiro: está
# no repositório do CachyOS e é recompilado junto com o pacman. O Pamac vem do
# AUR, não tem suporte oficial no Arch e quebra a cada atualização da libalpm
# até alguém recompilar — continua na lista só para quem ainda o tem.
STORE_CANDIDATES=(shelly-ui pamac-manager octopi discover gnome-software)

# yay primeiro (escolha do projeto); paru só quando não houver yay.
aur_helper() {
    if command -v yay >/dev/null 2>&1; then echo "yay"
    elif command -v paru >/dev/null 2>&1; then echo "paru"
    elif command -v shelly >/dev/null 2>&1; then echo "shelly"
    elif command -v pamac >/dev/null 2>&1; then echo "pamac"
    else echo ""; fi
}

find_store() {
    for s in "${STORE_CANDIDATES[@]}"; do
        if command -v "$s" >/dev/null 2>&1; then
            echo "$s"
            return 0
        fi
    done
    echo ""
}

check_updates() {
    local repo_count=0 repo_pkgs="[]" aur_count=0 flatpak_count=0

    if command -v checkupdates >/dev/null 2>&1; then
        local raw
        raw=$(checkupdates 2>/dev/null || true)
        if [ -n "$raw" ]; then
            repo_count=$(printf '%s\n' "$raw" | grep -c . || true)
            repo_pkgs=$(printf '%s\n' "$raw" | head -n 12 | awk '{print $1}' | jq -R . | jq -s .)
        fi
    fi

    # AUR e Flatpak não apareciam na contagem antiga — o painel dizia "tudo em
    # dia" com dezenas de pacotes do AUR pendentes.
    local helper
    helper=$(aur_helper)
    if [ "$helper" = "paru" ]; then
        aur_count=$(paru -Qua 2>/dev/null | grep -c . || true)
    elif [ "$helper" = "yay" ]; then
        aur_count=$(yay -Qua 2>/dev/null | grep -c . || true)
    fi

    if command -v flatpak >/dev/null 2>&1; then
        flatpak_count=$(flatpak remote-ls --updates 2>/dev/null | grep -c . || true)
    fi

    local rice_updates=0 rice_info="{}"
    if command -v rice-update >/dev/null 2>&1; then
        rice_info=$(rice-update check 2>/dev/null || echo '{}')
        rice_updates=$(echo "$rice_info" | jq -r '.count // 0' 2>/dev/null || echo 0)
    fi

    # Blinda contra saída vazia ou com quebras de linha vinda dos comandos acima.
    for var in repo_count aur_count flatpak_count rice_updates; do
        value=$(printf '%s' "${!var}" | head -1 | tr -cd '0-9')
        printf -v "$var" '%s' "${value:-0}"
    done

    local store
    store=$(find_store)

    local sys_count=$((repo_count + aur_count + flatpak_count))
    local total_count=$((sys_count + rice_updates))

    jq -n \
        --argjson count "$total_count" \
        --argjson sys_count "$sys_count" \
        --argjson repo_count "$repo_count" \
        --argjson aur_count "$aur_count" \
        --argjson flatpak_count "$flatpak_count" \
        --argjson packages "$repo_pkgs" \
        --argjson rice_updates "$rice_updates" \
        --argjson rice_info "$rice_info" \
        --arg store "$store" \
        --arg checked_at "$(date +'%d/%m %H:%M')" \
        '{count: $count, sys_count: $sys_count, repo_count: $repo_count, aur_count: $aur_count,
          flatpak_count: $flatpak_count, packages: $packages, rice_updates: $rice_updates,
          rice_info: $rice_info, store: $store, checked_at: $checked_at}'
}

install_packages() {
    local pkgs=("$@")
    [ ${#pkgs[@]} -eq 0 ] && { echo "Nada a instalar" >&2; return 1; }

    local helper
    helper=$(aur_helper)
    local cmd
    if [ "$helper" = "paru" ]; then
        cmd="paru -S --needed ${pkgs[*]}"
    elif [ "$helper" = "yay" ]; then
        cmd="yay -S --needed ${pkgs[*]}"
    elif [ "$helper" = "shelly" ]; then
        cmd="shelly install ${pkgs[*]}"
    elif [ "$helper" = "pamac" ]; then
        cmd="pamac install ${pkgs[*]}"
    else
        cmd="sudo pacman -S --needed ${pkgs[*]}"
    fi

    notify-send -a "Programas" -i system-software-install -r 91197 -t 3000 \
        "Instalando ${#pkgs[@]} programa(s)..." "Acompanhe na janela do terminal que abriu." 2>/dev/null

    local term="${TERMINAL:-kitty}"
    command -v "$term" >/dev/null 2>&1 || term="kitty"
    "$term" --title "Instalando programas" -e bash -c "
echo '===================================================='
echo '  Instalando: ${pkgs[*]}'
echo '===================================================='
echo
$cmd
echo
echo 'Pronto! Pressione ENTER para fechar.'
read" &
}

open_store() {
    local store
    store=$(find_store)
    if [ -n "$store" ]; then
        nohup "$store" >/dev/null 2>&1 &
        return 0
    fi
    # Nenhum gerenciador gráfico: oferece instalar o Shelly. Ele está no
    # repositório do CachyOS; em outras distros Arch vem do AUR.
    notify-send -a "Programas" -i dialog-information -t 5000 \
        "Nenhuma loja de programas instalada" "Abrindo a instalação do Shelly..." 2>/dev/null
    install_packages shelly
}

# Modo de atualização escolhido no painel: "full" abre o cachy-update
# (arch-update: pergunta em cada etapa, cuida de órfãos, cache e .pacnew) e
# "quick" atualiza tudo sem perguntar — só a senha do sudo. Guardado em
# ~/.config/hollow-wired/update.json (estado do usuário, não vem das dotfiles).
UPDATE_PREFS="${XDG_CONFIG_HOME:-$HOME/.config}/hollow-wired/update.json"

update_mode() {
    local m
    m=$(jq -r '.mode // "full"' "$UPDATE_PREFS" 2>/dev/null)
    [ "$m" = "quick" ] && echo quick || echo full
}

set_update_mode() {
    case "$1" in quick|full) ;; *) echo "Uso: $(basename "$0") update-mode [quick|full]" >&2; return 1 ;; esac
    mkdir -p "$(dirname "$UPDATE_PREFS")"
    local tmp="$UPDATE_PREFS.tmp"
    jq -n --arg m "$1" '{mode: $m}' > "$tmp" && mv "$tmp" "$UPDATE_PREFS"
}

# Sem --no-confirm: cada gerenciador pergunta como sempre. Com --no-confirm:
# pacman/yay/paru com --noconfirm (e sem revisar PKGBUILD), Flatpak com -y.
# Um conflito que precisa de resposta ("remover X?") faz o --noconfirm
# responder o padrão (não) e o pacman parar; aí o fim mostra o erro e manda
# para o cachy-update, que pergunta.
update_system() {
    local quick=0
    [ "${1:-}" = "--no-confirm" ] && quick=1
    local helper
    helper=$(aur_helper)
    local cmd="sudo pacman -Syu"
    [ "$helper" = "paru" ] && cmd="paru -Syu"
    [ "$helper" = "yay" ] && cmd="yay -Syu"
    [ "$helper" = "shelly" ] && cmd="shelly upgrade -a"
    [ "$helper" = "pamac" ] && cmd="pamac update -a"
    if [ "$quick" = 1 ]; then
        case "$helper" in
            yay)  cmd="yay -Syu --noconfirm --sudoloop --answerclean None --answerdiff None --answeredit None" ;;
            paru) cmd="paru -Syu --noconfirm --sudoloop --skipreview" ;;
            *)    cmd="sudo pacman -Syu --noconfirm" ;;
        esac
    fi

    notify-send -a "Atualização do Sistema" -i system-software-update -r 91197 -t 3000 \
        "Iniciando atualização..." "Uma janela do terminal foi aberta." 2>/dev/null

    local term="${TERMINAL:-kitty}"
    command -v "$term" >/dev/null 2>&1 || term="kitty"
    # shellcheck disable=SC2016  # o script roda dentro do terminal
    local script='
cmd="$1"; quick="$2"
echo "===================================================="
if [ "$quick" = 1 ]; then
    echo "  Atualização sem perguntas (só a senha do sudo)"
else
    echo "  Atualização geral do sistema"
fi
echo "===================================================="
echo
ok=1
$cmd || ok=0
if [ "$ok" = 1 ] && command -v flatpak >/dev/null 2>&1; then
    echo
    echo "--- Flatpak ---"
    flatpak update -y || ok=0
fi
echo
if [ "$ok" = 1 ]; then
    echo "Atualização concluída."
    # Kernel novo instalado: os módulos do kernel em uso somem de /usr/lib/modules.
    if [ ! -d "/usr/lib/modules/$(uname -r)" ]; then
        echo "O kernel foi atualizado: reinicie o computador para usar a versão nova."
    fi
else
    echo "A atualização parou com erro (veja acima)."
    if [ "$quick" = 1 ]; then
        echo "Se o pacman pediu uma resposta (conflito ou pacote a remover), rode o"
        echo "cachy-update, que pergunta em cada etapa:  cachy-update"
    fi
fi
echo
read -r -p "Pressione ENTER para fechar. "'
    "$term" --title "Atualização do Sistema" -e bash -c "$script" _ "$cmd" "$quick" &
}

# ------------------------------------------------------------------------------
# Janela de atualizações (Updater.qml): lista por origem e atualiza só o que a
# pessoa marcou, sem perguntas. O trabalho roda solto do Quickshell (setsid):
# um reload do shell no meio do pacman não pode matar a transação.
# Estado em $XDG_RUNTIME_DIR/hollow-wired/update-job.json, saída em update-job.log.
# ------------------------------------------------------------------------------
JOB_DIR="${XDG_RUNTIME_DIR:-/tmp}/hollow-wired"
JOB_STATE="$JOB_DIR/update-job.json"
JOB_LOG="$JOB_DIR/update-job.log"
JOB_LOCK="$JOB_DIR/update-job.lock"
ASKPASS_PW="$JOB_DIR/askpass.pw"
ASKPASS_BIN="$JOB_DIR/askpass"

# "nome velha -> nova" (checkupdates, yay/paru -Qua) → [{name, old, new}]
pkg_lines_json() {
    awk 'NF>=4 && $3=="->" {print $1"\t"$2"\t"$4}' |
        jq -R -s 'split("\n") | map(select(length>0) | split("\t") | {name: .[0], old: .[1], new: .[2]})'
}

list_updates() {
    local repo="[]" aur="[]" flatpak="[]" helper
    command -v checkupdates >/dev/null 2>&1 && repo=$(checkupdates 2>/dev/null | pkg_lines_json)
    helper=$(aur_helper)
    case "$helper" in
        yay)  aur=$(yay -Qua 2>/dev/null | pkg_lines_json) ;;
        paru) aur=$(paru -Qua 2>/dev/null | pkg_lines_json) ;;
        *)    helper="" ;;
    esac
    if command -v flatpak >/dev/null 2>&1; then
        local installed
        installed=$(flatpak list --columns=application,version 2>/dev/null)
        flatpak=$(flatpak remote-ls --updates --columns=name,application,version 2>/dev/null |
            jq -R -s --arg inst "$installed" '
                ($inst | split("\n") | map(select(length>0) | split("\t") | {key: .[0], value: (.[1] // "")}) | from_entries) as $v
                | split("\n") | map(select(length>0) | split("\t")
                | {name: .[0], id: .[1], old: ($v[.[1]] // ""), new: (.[2] // "")})')
    fi
    local rice="{}"
    command -v rice-update >/dev/null 2>&1 && rice=$(rice-update check 2>/dev/null || echo '{}')
    jq -n --argjson repo "${repo:-[]}" --argjson aur "${aur:-[]}" --argjson flatpak "${flatpak:-[]}" \
        --argjson rice "$rice" --arg helper "$helper" --arg checked_at "$(date +'%H:%M')" \
        --argjson has_flatpak "$(command -v flatpak >/dev/null 2>&1 && echo true || echo false)" \
        '{repo: $repo, aur: $aur, flatpak: $flatpak, rice: $rice, aur_helper: $helper,
          has_flatpak: $has_flatpak, checked_at: $checked_at}'
}

job_running() {
    [ -e "$JOB_LOCK" ] || return 1
    ! flock -n "$JOB_LOCK" true 2>/dev/null
}

# Askpass de uma tentativa só: se o mesmo sudo pedir de novo, a senha estava
# errada — devolver a mesma senha três vezes travaria a conta no faillock.
write_askpass() {
    mkdir -p "$JOB_DIR" && chmod 700 "$JOB_DIR"
    cat > "$ASKPASS_BIN" <<ASK
#!/bin/sh
seen="$JOB_DIR/askpass.ppid"
[ -r "$ASKPASS_PW" ] || exit 1
[ "\$(cat "\$seen" 2>/dev/null)" = "\$PPID" ] && exit 1
echo "\$PPID" > "\$seen"
cat "$ASKPASS_PW"
ASK
    chmod 700 "$ASKPASS_BIN"
}

job_set() {   # job_set <filtro jq> [args jq...]
    local f="$1"; shift
    local tmp="$JOB_STATE.tmp"
    # No mesmo arquivo (sem mv): quem observa (a janela) segue o mesmo inode.
    jq "$@" "$f" "$JOB_STATE" > "$tmp" 2>/dev/null && cat "$tmp" > "$JOB_STATE"
    rm -f "$tmp"
}

# run-job <origens separadas por vírgula> [--tty]
run_job() {
    local sources="$1" tty=0
    [ "${2:-}" = "--tty" ] && tty=1
    mkdir -p "$JOB_DIR"
    exec 9>"$JOB_LOCK"
    flock -n 9 || { echo "Já existe uma atualização rodando." >&2; return 3; }

    local sudo_cmd="sudo" yay_sudo=()
    if [ "$tty" = 0 ]; then
        export SUDO_ASKPASS="$ASKPASS_BIN"
        sudo_cmd="sudo -A"
        yay_sudo=(--sudoflags -A)
        trap 'rm -f "$ASKPASS_PW" "$JOB_DIR/askpass.ppid"' EXIT
        : > "$JOB_LOG"
        exec >>"$JOB_LOG" 2>&1 </dev/null
    fi

    local steps
    steps=$(printf '%s' "$sources" | tr ',' '\n' | grep -xE 'repo|aur|flatpak|rice' |
        jq -R -s 'split("\n") | map(select(length>0)) | map({id: ., state: "pending"})')
    jq -n --argjson steps "$steps" --arg mode "$([ "$tty" = 1 ] && echo terminal || echo window)" \
        '{state: "running", mode: $mode, steps: $steps, kernel: false, started: now}' > "$JOB_STATE"

    local helper ok_all=1 id rc
    helper=$(aur_helper)
    for id in $(jq -r '.steps[].id' "$JOB_STATE"); do
        job_set '(.steps[] | select(.id == $i) | .state) = "running"' --arg i "$id"
        echo; echo "=== $id ==="
        rc=0
        case "$id" in
            repo) $sudo_cmd pacman -Syu --noconfirm || rc=$? ;;
            aur)
                case "$helper" in
                    yay)  yay -Sua --noconfirm --answerclean None --answerdiff None --answeredit None \
                              --removemake "${yay_sudo[@]}" || rc=$? ;;
                    paru) paru -Sua --noconfirm --skipreview --removemake "${yay_sudo[@]}" || rc=$? ;;
                    *)    echo "Nenhum AUR helper (yay ou paru) instalado."; rc=1 ;;
                esac ;;
            flatpak) flatpak update -y --noninteractive || rc=$? ;;
            rice) rice-update auto || rc=$? ;;
        esac
        if [ "$rc" = 0 ]; then
            job_set '(.steps[] | select(.id == $i) | .state) = "ok"' --arg i "$id"
        else
            ok_all=0
            job_set '(.steps[] | select(.id == $i) | .state) = "error"' --arg i "$id"
        fi
    done

    # Kernel novo instalado: os módulos do kernel em uso somem de /usr/lib/modules.
    [ -d "/usr/lib/modules/$(uname -r)" ] || job_set '.kernel = true'
    job_set '.state = $s | .finished = now' --arg s "$([ "$ok_all" = 1 ] && echo done || echo error)"
    echo; echo "=== fim ==="

    # O passo do rice reinicia o Quickshell; reabre a janela para mostrar o fim.
    if [ "$tty" = 0 ] && printf '%s' "$sources" | grep -qw rice; then
        sleep 4
        qs ipc call updater open >/dev/null 2>&1 || true
    fi
    if [ "$tty" = 1 ]; then
        echo
        read -r -p "Pressione ENTER para fechar. " _ || true
    fi
    return 0
}

# update-selected <origens> [--terminal]
# Na janela: a senha do sudo chega pela entrada padrão (só quando o sudo pede),
# é conferida uma vez e fica num arquivo 0600 em $XDG_RUNTIME_DIR, apagado no fim.
# Saída: 0 iniciado, 2 senha errada, 3 já rodando.
update_selected() {
    local sources="$1" where="${2:-}"
    [ -n "$sources" ] || { echo "Uso: $(basename "$0") update-selected repo,aur,flatpak,rice [--terminal]" >&2; return 1; }
    job_running && return 3
    if [ "$where" = "--terminal" ]; then
        local term="${TERMINAL:-kitty}"
        command -v "$term" >/dev/null 2>&1 || term="kitty"
        setsid -f "$term" --title "Atualização do Sistema" -e "$0" run-job "$sources" --tty >/dev/null 2>&1
        return 0
    fi
    mkdir -p "$JOB_DIR" && chmod 700 "$JOB_DIR"
    write_askpass
    rm -f "$JOB_DIR/askpass.ppid"
    local pw=""
    IFS= read -r pw || true
    if printf '%s' "$sources" | grep -qwE 'repo|aur' && ! sudo -n true 2>/dev/null; then
        ( umask 077; printf '%s\n' "$pw" > "$ASKPASS_PW" )
        if ! SUDO_ASKPASS="$ASKPASS_BIN" sudo -k -A true 2>/dev/null; then
            rm -f "$ASKPASS_PW" "$JOB_DIR/askpass.ppid"
            return 2
        fi
        rm -f "$JOB_DIR/askpass.ppid"
    fi
    pw=""
    setsid -f "$0" run-job "$sources" >/dev/null 2>&1 </dev/null
    return 0
}

cmd="${1:-status}"

case "$cmd" in
    status|updates)
        check_updates
        ;;
    install)
        shift
        install_packages "$@"
        ;;
    open-store|store)
        open_store
        ;;
    launch|run)
        target="${2:-}"
        [ -z "$target" ] && { echo "Uso: $(basename "$0") launch <programa>" >&2; exit 1; }
        nohup "$target" >/dev/null 2>&1 &
        ;;
    update-system)
        update_system "${2:-}"
        ;;
    update-mode)
        if [ -n "${2:-}" ]; then set_update_mode "$2"; else update_mode; fi
        ;;
    # O que o botão de atualizar abre, conforme o modo escolhido no painel.
    update-default)
        if [ "$(update_mode)" = "quick" ]; then
            update_system --no-confirm
            wait    # quem chamou (barra lateral) reconta ao fechar
        elif command -v cachy-update >/dev/null 2>&1; then
            kitty --class cachy-update --title cachy-update -e cachy-update
        else
            update_system
        fi
        ;;
    list)
        list_updates
        ;;
    update-selected)
        update_selected "${2:-}" "${3:-}"
        ;;
    run-job)
        run_job "${2:-}" "${3:-}"
        ;;
    update-rice)
        rice-update gui
        ;;
    *)
        sed -n '2,29p' "$0"
        exit 1
        ;;
esac
