#!/usr/bin/env python3
"""rice-audio: Gerenciador de dispositivos de áudio, microfone e volume para PipeWire/WirePlumber."""

import json
import subprocess
import sys


def run_cmd(cmd):
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, check=True)
        return res.stdout.strip()
    except Exception:
        return ""


def get_status():
    default_sink = run_cmd(["pactl", "get-default-sink"])
    default_source = run_cmd(["pactl", "get-default-source"])

    sinks_raw = run_cmd(["pactl", "-f", "json", "list", "sinks"])
    sources_raw = run_cmd(["pactl", "-f", "json", "list", "sources"])

    sinks = []
    sources = []
    sink_vol = 100
    source_vol = 100
    sink_muted = False
    source_muted = False

    try:
        sinks_data = json.loads(sinks_raw) if sinks_raw else []
        for s in sinks_data:
            props = s.get("properties", {})
            desc = (
                props.get("device.description")
                or props.get("node.nick")
                or props.get("api.alsa.card.name")
                or s.get("description")
                or s.get("name")
            )
            if "(null)" in desc or not desc.strip():
                desc = props.get("node.nick") or "Áudio Interno"

            vol_dict = s.get("volume", {})
            vol_pct = 100
            for ch in ("front-left", "mono", "front-right"):
                if ch in vol_dict and "value_percent" in vol_dict[ch]:
                    try:
                        vol_pct = int(vol_dict[ch]["value_percent"].replace("%", ""))
                        break
                    except ValueError:
                        pass

            name = s.get("name", "")
            is_default = name == default_sink
            if is_default:
                sink_vol = vol_pct
                sink_muted = s.get("mute", False)

            sinks.append({
                "name": name,
                "description": desc,
                "volume": vol_pct,
                "mute": s.get("mute", False),
                "is_default": is_default,
            })
    except Exception:
        pass

    try:
        sources_data = json.loads(sources_raw) if sources_raw else []
        for s in sources_data:
            # Exclui monitores de saída (ex: alsa_output.pci...monitor)
            if s.get("name", "").endswith(".monitor"):
                continue

            props = s.get("properties", {})
            desc = (
                props.get("device.description")
                or props.get("node.nick")
                or props.get("api.alsa.card.name")
                or s.get("description")
                or s.get("name")
            )
            if "(null)" in desc or not desc.strip():
                desc = props.get("node.nick") or "Microfone Interno"

            vol_dict = s.get("volume", {})
            vol_pct = 100
            for ch in ("mono", "front-left", "front-right"):
                if ch in vol_dict and "value_percent" in vol_dict[ch]:
                    try:
                        vol_pct = int(vol_dict[ch]["value_percent"].replace("%", ""))
                        break
                    except ValueError:
                        pass

            name = s.get("name", "")
            is_default = name == default_source
            if is_default:
                source_vol = vol_pct
                source_muted = s.get("mute", False)

            sources.append({
                "name": name,
                "description": desc,
                "volume": vol_pct,
                "mute": s.get("mute", False),
                "is_default": is_default,
            })
    except Exception:
        pass

    return {
        "sinks": sinks,
        "sources": sources,
        "default_sink": default_sink,
        "default_source": default_source,
        "sink_volume": sink_vol,
        "source_volume": source_vol,
        "sink_muted": sink_muted,
        "source_muted": source_muted,
    }


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"

    if cmd == "status":
        print(json.dumps(get_status(), ensure_ascii=False, indent=2))
    elif cmd == "set-sink":
        if len(args) > 1:
            subprocess.run(["pactl", "set-default-sink", args[1]], check=False)
            print(f"[✓] Saída de áudio alterada para: {args[1]}")
    elif cmd == "set-source":
        if len(args) > 1:
            subprocess.run(["pactl", "set-default-source", args[1]], check=False)
            print(f"[✓] Microfone alterado para: {args[1]}")
    elif cmd == "set-sink-volume":
        if len(args) > 1:
            pct = max(0, min(150, int(args[1])))
            subprocess.run(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{pct}%"], check=False)
            print(f"[✓] Volume da saída: {pct}%")
    elif cmd == "set-source-volume":
        if len(args) > 1:
            pct = max(0, min(150, int(args[1])))
            subprocess.run(["pactl", "set-source-volume", "@DEFAULT_SOURCE@", f"{pct}%"], check=False)
            print(f"[✓] Volume do microfone: {pct}%")
    elif cmd == "toggle-sink-mute":
        subprocess.run(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle"], check=False)
    elif cmd == "toggle-source-mute":
        subprocess.run(["pactl", "set-source-mute", "@DEFAULT_SOURCE@", "toggle"], check=False)
    elif cmd == "test":
        # Toca teste estéreo de 1 passada
        subprocess.Popen(["speaker-test", "-t", "wav", "-c", "2", "-l", "1"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("[✓] Teste de som estéreo iniciado...")
    else:
        print("Uso: rice-audio [status|set-sink <name>|set-source <name>|set-sink-volume <0-150>|set-source-volume <0-150>|test]")


if __name__ == "__main__":
    main()
