#!/usr/bin/env bash
# ==============================================================================
# rice-wallpaper-fade — esconde o engasgo da troca de papel de parede.
#
# Trocar um wallpaper animado mata o renderizador atual e sobe outro. Isso custa
# de alguns quadros a quase um segundo, dependendo do wallpaper, e aparece como
# travada ou flash preto.
#
# Este script cobre a tela com o preview estático do wallpaper que está entrando
# ANTES de mandar trocar. O wallpaper antigo continua animando por baixo
# enquanto a imagem aparece; a troca acontece com a tela já coberta; depois a
# camada some e revela o novo wallpaper rodando.
#
# Uso:
#   rice-wallpaper-fade <preview> -- <comando que troca o wallpaper...>
#   rice-wallpaper-fade --cover <preview>     # só cobre (quem troca é o chamador)
#   rice-wallpaper-fade --dismiss             # tira a camada na hora
#
# Sem o Quickshell rodando o comando é executado direto, sem transição.
# ==============================================================================

set -uo pipefail

qs_bin=""
for c in qs quickshell; do
    command -v "$c" >/dev/null 2>&1 && { qs_bin="$c"; break; }
done

qs_call() {
    [ -n "$qs_bin" ] || return 1
    "$qs_bin" ipc call wallfade "$@" 2>/dev/null
}

PREFS="$HOME/.config/hypr/user-prefs.json"
LOG="/tmp/rice-wallfade.log"

# Sem isto, "a transição não funciona" vira adivinhação: não dá para saber se o
# problema é quem chama, a imagem, o IPC ou o tempo. Mesma ideia do log dos
# atalhos do Discord.
trace() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG" 2>/dev/null || true; }

# Grava a preferência sem depender de jq: o arquivo é o mesmo dos gaps/blur e
# não pode ser reescrito do zero, senão o resto das preferências se perde.
save_style() {
    python3 -c '
import json, os, sys
path, style = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path, encoding="utf-8")) if os.path.isfile(path) else {}
except Exception:
    data = {}
data["wallpaper_transition"] = style
os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
' "$PREFS" "$1"
}

case "${1:-}" in
    --style)
        # Sem argumento, só informa o estilo em uso.
        if [ -z "${2:-}" ]; then
            qs_call currentStyle 2>/dev/null || echo "fade"
            exit 0
        fi
        case "$2" in
            fade|wipe|wave|grow) ;;
            *) echo "estilos: fade, wipe, wave, grow" >&2; exit 2 ;;
        esac
        save_style "$2" || { echo "não consegui gravar a preferência" >&2; exit 1; }
        # O QML observa o arquivo, mas avisar direto faz valer na hora.
        qs_call setStyle "$2" >/dev/null 2>&1 || true
        echo "OK"
        exit 0
        ;;
    --reveal-when-ready)
        # Tira a camada quando o wallpaper novo estiver de fato no ar E assentado.
        #
        #   rice-wallpaper-fade --reveal-when-ready <pasta do item> [--colors <imagem>]
        #
        # O waywallen sobe um processo por wallpaper —
        # `waywallen-video-renderer --path <arquivo>` para vídeo e
        # `waywallen-wescene-renderer --path <scene.pkg>` para cena — com o
        # caminho do item na linha de comando. A presença dele é o primeiro sinal.
        #
        # Só a presença não basta: o processo aparece e passa ainda um ou dois
        # segundos carregando texturas e shaders, com quadros engasgando. Antes
        # a camada saía 0,45s depois de ele aparecer, e esse carregamento ficava
        # à vista como "microlag depois da transição". Agora ela espera o uso
        # de CPU do renderizador baixar e estabilizar.
        #
        # Com --colors, a paleta nova (wallust) também é gerada aqui, com a tela
        # ainda coberta: recolorir o shell inteiro redesenha todas as superfícies,
        # e fazer isso com o wallpaper novo já à vista era o segundo tranco.
        target="${2:-}"
        colors=""
        [ "${3:-}" = "--colors" ] && colors="${4:-}"
        [ -n "$target" ] || { qs_call reveal >/dev/null 2>&1; exit 0; }

        wallust_pid=""
        if [ -n "$colors" ] && [ -f "$colors" ] && command -v wallust >/dev/null 2>&1; then
            if command -v rice-wallust-config >/dev/null 2>&1; then
                nice -n 10 rice-wallust-config run "$colors" >/dev/null 2>&1 &
            else
                nice -n 10 wallust run "$colors" >/dev/null 2>&1 &
            fi
            wallust_pid=$!
        fi

        deadline=$(( $(date +%s) + 8 ))
        pid=""
        while [ "$(date +%s)" -lt "$deadline" ]; do
            # Comparação de texto exata: nomes de arquivo com ( ) [ ] (comuns
            # em vídeos baixados) quebravam o `pgrep -f` com regex.
            pid=""
            for p in $(pgrep -f "waywallen-[a-z]*-renderer" 2>/dev/null); do
                if tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -qF -- "$target"; then
                    pid=$p
                    break
                fi
            done
            [ -n "$pid" ] && break
            sleep 0.03
        done

        if [ -n "$pid" ]; then
            trace "renderizador pronto e ativo: $target"
        else
            trace "renderizador novo NÃO apareceu em 8s: $target"
        fi

        # Revela imediatamente o wallpaper; a paleta do wallust roda em segundo
        # plano sem segurar a tela coberta nem introduzir atraso na transição.
        qs_call reveal >/dev/null 2>&1 || true

        # Fundo da tela de login: invisível para o usuário, então roda depois,
        # com prioridade mínima, para não disputar CPU com o wallpaper que
        # acabou de subir.
        if [ -n "$colors" ] && [ -x "$HOME/.local/bin/rice-sddm-sync-wallpaper" ]; then
            sleep 1.5
            nice -n 19 "$HOME/.local/bin/rice-sddm-sync-wallpaper" --quiet >/dev/null 2>&1 || true
        fi
        exit 0
        ;;
    --dismiss)
        qs_call dismiss >/dev/null || true
        exit 0
        ;;
    --cover)
        # Cobre a tela e imprime, em ms, quanto o chamador deve esperar antes de
        # trocar o wallpaper de verdade. Imprime 0 quando não houve transição.
        [ -n "${2:-}" ] || { echo "uso: rice-wallpaper-fade --cover <preview>" >&2; exit 2; }
        if [ ! -f "$2" ]; then
            trace "cover FALHOU: imagem inexistente: $2"
            echo 0
            exit 0
        fi
        if ! qs_call cover "$2" >/dev/null; then
            trace "cover FALHOU: IPC do quickshell não respondeu (qs_bin='$qs_bin')"
            echo 0
            exit 0
        fi
        trace "cover ok: $2"
        d=$(qs_call coverDelay 2>/dev/null | tr -cd '0-9')
        [ -n "$d" ] || d=820
        echo "$d"
        exit 0
        ;;
esac

preview="${1:-}"
shift || true
[ "${1:-}" = "--" ] && shift

if [ "$#" -eq 0 ]; then
    echo "uso: rice-wallpaper-fade <preview> -- <comando...>" >&2
    exit 2
fi

# Sem preview utilizável não há o que desenhar: troca direto.
if [ -z "$preview" ] || [ ! -f "$preview" ] || [ -z "$qs_bin" ]; then
    exec "$@"
fi

if ! qs_call cover "$preview" >/dev/null; then
    exec "$@"
fi

# O próprio painel diz quanto tempo leva pra imagem cobrir a tela, então mudar a
# duração da animação no QML não exige mexer aqui.
delay_ms=$(qs_call coverDelay 2>/dev/null | tr -cd '0-9')
[ -n "$delay_ms" ] || delay_ms=820
sleep "$(awk -v ms="$delay_ms" 'BEGIN { printf "%.3f", ms / 1000 }')"

"$@"
status=$?

# A camada some sozinha por tempo (e tem um limite de segurança no QML), mas se
# a troca falhou não faz sentido segurar a tela coberta.
[ "$status" -ne 0 ] && qs_call dismiss >/dev/null

exit "$status"
