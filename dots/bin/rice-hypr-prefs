#!/usr/bin/env bash
# rice-hypr-prefs
# Gerencia e persiste preferências de aparência, tela e periféricos do Hyprland em tempo real.
# Lê e salva em ~/.config/hypr/user-prefs.json e aplica via `hyprctl eval`.

set -euo pipefail

PREFS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/user-prefs.json"

# Layout de teclado do próprio sistema (/etc/vconsole.conf). O padrão fixo "br"
# fazia quem instalasse o rice com teclado de outro país perder acentuação e
# símbolos assim que o Quickshell aplicasse as preferências no autostart.
system_kb_layout() {
    local layout=""
    if [ -f /etc/vconsole.conf ]; then
        layout=$(sed -n 's/^XKBLAYOUT=\"\?\([^\"]*\)\"\?/\1/p' /etc/vconsole.conf | head -1)
    fi
    if [ -z "$layout" ] && command -v localectl >/dev/null 2>&1; then
        layout=$(localectl status 2>/dev/null | sed -n 's/.*X11 Layout: *//p' | head -1)
    fi
    echo "${layout:-br}"
}

ensure_prefs_file() {
    if [ ! -f "$PREFS_FILE" ]; then
        mkdir -p "$(dirname "$PREFS_FILE")"
        cat <<JSON > "$PREFS_FILE"
{
  "rounding": 8,
  "border_size": 2,
  "gaps_in": 6,
  "gaps_out": 9,
  "inactive_opacity": 1.0,
  "dim_inactive": false,
  "dim_strength": 0.2,
  "anim_enabled": true,
  "anim_preset": "smooth",
  "kb_layout": "$(system_kb_layout)",
  "kb_variant": "",
  "mouse_sensitivity": 0.0,
  "mouse_accel": "flat",
  "numlock": true,
  "vrr": 0,
  "blur": true,
  "blur_quality": "padrao",
  "monitor_hz": 0,
  "monitor_scale": 1
}
JSON
    fi
}

get_instance() {
    local run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$run/hypr" 2>/dev/null | head -1 || true)
        export HYPRLAND_INSTANCE_SIGNATURE
    fi
}

apply_all() {
    ensure_prefs_file
    get_instance

    local rounding border_size gaps_in gaps_out inactive_opacity dim_inactive dim_strength anim_enabled anim_preset
    local kb_layout kb_variant mouse_sensitivity mouse_accel numlock vrr monitor_hz

    rounding=$(jq -r '.rounding // 8' "$PREFS_FILE")
    border_size=$(jq -r '.border_size // 2' "$PREFS_FILE")
    gaps_in=$(jq -r '.gaps_in // 6' "$PREFS_FILE")
    gaps_out=$(jq -r '.gaps_out // 9' "$PREFS_FILE")
    inactive_opacity=$(jq -r '.inactive_opacity // 1.0' "$PREFS_FILE")
    dim_inactive=$(jq -r '.dim_inactive // false' "$PREFS_FILE")
    dim_strength=$(jq -r '.dim_strength // 0.2' "$PREFS_FILE")
    # Booleanos com padrão `true` NÃO podem usar `.x // true`: no jq o `//`
    # troca `false` pelo padrão também, então "desligado" virava "ligado". Era
    # isso que religava o blur logo depois de desligar (Super+B, sidebar).
    anim_enabled=$(jq -r 'if .anim_enabled == false then false else true end' "$PREFS_FILE")
    anim_preset=$(jq -r '.anim_preset // "smooth"' "$PREFS_FILE")

    local kb_layout kb_variant mouse_sensitivity mouse_accel numlock vrr monitor_hz monitor_scale
    local repeat_rate repeat_delay touchpad_tap touchpad_natural touchpad_dwt

    kb_layout=$(jq -r ".kb_layout // \"$(system_kb_layout)\"" "$PREFS_FILE")
    kb_variant=$(jq -r '.kb_variant // ""' "$PREFS_FILE")
    mouse_sensitivity=$(jq -r '.mouse_sensitivity // 0.0' "$PREFS_FILE")
    mouse_accel=$(jq -r '.mouse_accel // "flat"' "$PREFS_FILE")
    numlock=$(jq -r 'if .numlock == false then false else true end' "$PREFS_FILE")
    # Teclado e touchpad: antes só dava pra mudar a disposição do teclado.
    repeat_rate=$(jq -r '.repeat_rate // 25' "$PREFS_FILE")
    repeat_delay=$(jq -r '.repeat_delay // 600' "$PREFS_FILE")
    touchpad_tap=$(jq -r 'if .touchpad_tap == false then false else true end' "$PREFS_FILE")
    touchpad_natural=$(jq -r '.touchpad_natural_scroll // false' "$PREFS_FILE")
    touchpad_dwt=$(jq -r '.touchpad_dwt // false' "$PREFS_FILE")
    vrr=$(jq -r '.vrr // 0' "$PREFS_FILE")
    blur=$(jq -r 'if .blur == false then false else true end' "$PREFS_FILE")
    # Qualidade do desfoque: leve (integradas fracas), padrao, forte.
    blur_quality=$(jq -r '.blur_quality // "padrao"' "$PREFS_FILE")
    case "$blur_quality" in
        leve)  blur_size=2; blur_passes=1; blur_xray=true;  blur_ign=false; blur_vib=0.10 ;;
        forte) blur_size=6; blur_passes=3; blur_xray=false; blur_ign=true;  blur_vib=0.25 ;;
        manual)
            # Controles finos do painel (aba Efeitos & Janelas).
            blur_size=$(jq -r '.blur_size // 3' "$PREFS_FILE")
            blur_passes=$(jq -r '.blur_passes // 1' "$PREFS_FILE")
            blur_vib=$(jq -r '.blur_vibrancy // 0.20' "$PREFS_FILE")
            blur_xray=$(jq -r 'if .blur_xray == true then true else false end' "$PREFS_FILE")
            blur_ign=$(jq -r 'if .blur_ignore_opacity == false then false else true end' "$PREFS_FILE")
            ;;
        *)     blur_size=3; blur_passes=1; blur_xray=false; blur_ign=true;  blur_vib=0.20 ;;
    esac
    local run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    if [ "$blur" = "false" ]; then
        touch "$run/rice-blur-disabled" 2>/dev/null || true
    else
        rm -f "$run/rice-blur-disabled" 2>/dev/null || true
    fi
    # 0 = usa a taxa preferida do próprio monitor. O padrão antigo (144) vinha do
    # notebook do autor e era aplicado à força em telas de 60Hz.
    monitor_hz=$(jq -r '.monitor_hz // 0' "$PREFS_FILE")
    monitor_scale=$(jq -r '.monitor_scale // 1' "$PREFS_FILE")

    local gaps_out_sides=$(( gaps_out + 10 ))

    # 1. Configurações gerais de janelas, layout e periféricos
    hyprctl eval "
hl.config({
    general = {
        border_size = $border_size,
        gaps_in = $gaps_in,
        gaps_out = { top = $gaps_out, right = $gaps_out_sides, bottom = $gaps_out_sides, left = $gaps_out_sides }
    },
    decoration = {
        rounding = $rounding,
        inactive_opacity = $inactive_opacity,
        dim_inactive = $dim_inactive,
        dim_strength = $dim_strength,
        blur = {
            enabled = $blur,
            size = $blur_size,
            passes = $blur_passes,
            xray = $blur_xray,
            ignore_opacity = $blur_ign,
            vibrancy = $blur_vib
        }
    },
    animations = {
        enabled = $anim_enabled
    },
    misc = {
        vrr = $vrr
    },
    input = {
        kb_layout = '$kb_layout',
        kb_variant = '$kb_variant',
        numlock_by_default = $numlock,
        accel_profile = '$mouse_accel',
        sensitivity = $mouse_sensitivity,
        repeat_rate = $repeat_rate,
        repeat_delay = $repeat_delay,

        touchpad = {
            natural_scroll = $touchpad_natural,
            tap_to_click = $touchpad_tap,
            disable_while_typing = $touchpad_dwt
        }
    }
})
" &>/dev/null

    # 2. Configurações para dispositivos de mouse conhecidos
    hyprctl eval "
hl.device({
    name = 'usb-gaming-mouse',
    accel_profile = '$mouse_accel',
    sensitivity = $mouse_sensitivity
})
" &>/dev/null

    # 3. Monitor, escala e taxa de atualização
    # Aplica escala global para qualquer monitor (evita o bug de zoom 300% do 'auto')
    hyprctl eval "hl.monitor({ output = '', mode = 'preferred', position = 'auto', scale = '$monitor_scale' })" &>/dev/null || true

    # Configuração por monitor (resolução, taxa, escala e rotação), salva pelo
    # painel em .monitors["<nome>"]. Tem prioridade sobre o ajuste global antigo,
    # que só sabia mexer na taxa de atualização de uma tela.
    local saved_monitors
    saved_monitors=$(jq -r '.monitors // {} | keys[]?' "$PREFS_FILE" 2>/dev/null || true)
    if [ -n "$saved_monitors" ]; then
        local connected
        connected=$(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
        while IFS= read -r mon; do
            [ -z "$mon" ] && continue
            # Não tenta configurar monitor que não está conectado agora.
            printf '%s\n' "$connected" | grep -qx "$mon" || continue
            local m_mode m_scale m_transform
            m_mode=$(jq -r --arg m "$mon" '.monitors[$m].mode // "preferred"' "$PREFS_FILE")
            m_scale=$(jq -r --arg m "$mon" '.monitors[$m].scale // 1' "$PREFS_FILE")
            m_transform=$(jq -r --arg m "$mon" '.monitors[$m].transform // 0' "$PREFS_FILE")
            hyprctl eval "hl.monitor({ output = '$mon', mode = '$m_mode', position = 'auto', scale = '$m_scale', transform = $m_transform })" &>/dev/null || true
        done <<< "$saved_monitors"
        apply_anim_preset "$anim_preset"
        return 0
    fi

    local mon_name
    mon_name=$(hyprctl monitors -j 2>/dev/null | jq -r '[.[] | select(.focused == true)][0].name // .[0].name // empty' 2>/dev/null || true)
    if [ -n "$mon_name" ]; then
        local mode_str="preferred"
        if [ -n "$monitor_hz" ] && [ "$monitor_hz" != "0" ] && [ "$monitor_hz" != "null" ]; then
            local matched_mode
            matched_mode=$(hyprctl monitors -j 2>/dev/null | jq -r --arg name "$mon_name" --arg hz "$monitor_hz" \
                '.[] | select(.name == $name) | .availableModes[]? | select(test("@" + $hz + "(\\.[0-9]+)?Hz"))' 2>/dev/null | head -1 || true)
            if [ -n "$matched_mode" ]; then
                mode_str="$matched_mode"
            fi
            # Sem modo compatível, fica em "preferred": forçar "preferred@144Hz"
            # numa tela que não tem 144Hz fazia o Hyprland recusar o modo (e em
            # alguns monitores dava tela preta até religar).
        fi
        # position continua 'auto': fixar '0x0' empilhava monitores em quem usa
        # mais de uma tela.
        hyprctl eval "hl.monitor({ output = '$mon_name', mode = '$mode_str', position = 'auto', scale = '$monitor_scale' })" &>/dev/null || true
    fi

    # 4. Preset de animação
    apply_anim_preset "$anim_preset"
}

apply_anim_preset() {
    # As curvas moram no rice-anim (presets, modo personalizado e o arquivo
    # animations.lua que o hyprland.lua carrega). O preset recebido aqui já
    # foi salvo em anim_preset; só falta regravar e aplicar.
    get_instance
    if command -v rice-anim >/dev/null 2>&1; then
        rice-anim apply >/dev/null 2>&1 || true
    fi
}

cmd="${1:-get}"

case "$cmd" in
    get|status)
        ensure_prefs_file
        cat "$PREFS_FILE"
        ;;
    apply)
        apply_all
        ;;
    set)
        key="${2:-}"
        val="${3:-}"
        if [ -z "$key" ] || [ -z "$val" ]; then
            echo "Uso: $(basename "$0") set <chave> <valor>" >&2
            exit 1
        fi
        ensure_prefs_file
        if [[ "$val" =~ ^(true|false|[0-9]+(\.[0-9]+)?)$ ]]; then
            tmp=$(jq --arg k "$key" --argjson v "$val" '.[$k] = $v' "$PREFS_FILE")
        else
            tmp=$(jq --arg k "$key" --arg v "$val" '.[$k] = $v' "$PREFS_FILE")
        fi
        echo "$tmp" > "$PREFS_FILE"
        apply_all
        # As regras de camada (quais painéis têm desfoque) só saem do arquivo de
        # configuração: o eval do apply_all não as alcança.
        case "$key" in blur_quality|blur_size|blur_passes|blur_vibrancy|blur_xray|blur_ignore_opacity) blur_changed=1 ;; *) blur_changed=0 ;; esac
        if [ "$blur_changed" = 1 ]; then
            hyprctl reload >/dev/null 2>&1 || true
            notify-send -a "Hyprland" -i preferences-desktop-theme -r 91197 -t 2500 \
                "Desfoque atualizado" "$([ "$val" = leve ] && echo 'Mais leve para placas integradas' || echo 'Aparência atualizada')" 2>/dev/null || true
        fi
        if [ "$key" = "monitor_scale" ]; then
            command -v rice-wallpaper-reload >/dev/null 2>&1 && rice-wallpaper-reload >/dev/null 2>&1 &
        fi
        ;;
    monitor)
        # rice-hypr-prefs monitor <nome> <modo> [escala] [rotação]
        #   modo:    1920x1080@144.03  |  preferred
        #   escala:  1 | 1.25 | 1.5 ...
        #   rotação: 0 (normal) | 1 (90°) | 2 (180°) | 3 (270°)
        mon="${2:-}"
        mode="${3:-preferred}"
        scale="${4:-1}"
        transform="${5:-0}"
        if [ -z "$mon" ]; then
            echo "Uso: $(basename "$0") monitor <nome> <modo> [escala] [rotação]" >&2
            exit 1
        fi
        ensure_prefs_file
        get_instance
        # Aplica primeiro: se o modo não existir, o Hyprland recusa e mantém o
        # atual — aí nem chega a ser salvo como preferência.
        if ! hyprctl eval "hl.monitor({ output = '$mon', mode = '$mode', position = 'auto', scale = '$scale', transform = $transform })" &>/dev/null; then
            echo "[!] Hyprland recusou o modo $mode em $mon" >&2
            exit 1
        fi
        tmp=$(jq --arg m "$mon" --arg mode "$mode" --argjson scale "$scale" --argjson tr "$transform" \
            '.monitors = ((.monitors // {}) | .[$m] = { mode: $mode, scale: $scale, transform: $tr })' "$PREFS_FILE")
        [ -n "$tmp" ] && echo "$tmp" > "$PREFS_FILE"
        echo "OK"
        ;;
    monitor-forget)
        # Volta o monitor para a configuração automática (usado pelo "reverter").
        mon="${2:-}"
        ensure_prefs_file
        if [ -n "$mon" ]; then
            tmp=$(jq --arg m "$mon" 'if .monitors then .monitors |= del(.[$m]) else . end' "$PREFS_FILE")
            [ -n "$tmp" ] && echo "$tmp" > "$PREFS_FILE"
            get_instance
            hyprctl eval "hl.monitor({ output = '$mon', mode = 'preferred', position = 'auto', scale = '1', transform = 0 })" &>/dev/null || true
        fi
        echo "OK"
        ;;
    preset)
        p="${2:-smooth}"
        ensure_prefs_file
        tmp=$(jq --arg p "$p" '.anim_preset = $p' "$PREFS_FILE")
        echo "$tmp" > "$PREFS_FILE"
        apply_all
        notify-send -a "Hyprland" -i preferences-desktop-theme -r 91196 -t 2000 "Estilo de Animação: $p" "Curvas e velocidade atualizadas"
        ;;
    reset)
        ensure_prefs_file
        cat <<JSON > "$PREFS_FILE"
{
  "rounding": 8,
  "border_size": 2,
  "gaps_in": 6,
  "gaps_out": 9,
  "inactive_opacity": 1.0,
  "dim_inactive": false,
  "dim_strength": 0.2,
  "anim_enabled": true,
  "anim_preset": "smooth",
  "kb_layout": "$(system_kb_layout)",
  "kb_variant": "",
  "mouse_sensitivity": 0.0,
  "mouse_accel": "flat",
  "numlock": true,
  "vrr": 0,
  "blur": true,
  "monitor_hz": 0,
  "monitor_scale": 1
}
JSON
        apply_all
        notify-send -a "Hyprland" -i view-refresh -r 91196 -t 2000 "Aparência Redefinida" "Padrões do rice restaurados"
        ;;
    *)
        echo "Uso: $(basename "$0") [get|set <key> <val>|apply|monitor <nome> <modo> [escala] [rotação]|monitor-forget <nome>|preset <name>|reset]" >&2
        exit 1
        ;;
esac
