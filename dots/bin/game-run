#!/usr/bin/env bash
# game-run — roda um programa na melhor GPU disponível.
#
# Em laptop híbrido (Intel/AMD + NVIDIA), manda para a dedicada:
#   OpenGL: variáveis de render offload da NVIDIA (mesma ideia do prime-run)
#   Vulkan: o __VK_LAYER_NV_optimus sozinho NÃO filtra neste driver (a iGPU
#           continuava aparecendo como 1ª placa); a camada device_select do Mesa
#           com FORCE_DEFAULT_DEVICE deixa só a NVIDIA visível.
#   DLSS:   PROTON_ENABLE_NVAPI=1 → Proton liga DXVK-NVAPI e copia nvngx.dll.
#           Jogos sem DLSS só ignoram. Se algum jogo bugar, nas opções dele:
#           PROTON_DISABLE_NVAPI=1 %command%
#
# Em máquina sem NVIDIA (AMD, Intel ou desktop com placa única) o programa é
# executado direto, sem variável nenhuma: o ID da RTX 3050 do autor era fixo
# aqui (MESA_VK_DEVICE_SELECT=10de:25a2) e, num PC diferente, apontava para uma
# placa inexistente e travava jogos e navegador na largada.
#
# Uso: game-run <comando>   (Steam/Heroic já recebem essas variáveis direto)

# Primeira GPU NVIDIA do sistema, no formato "vendor:device" que o Mesa espera.
nvidia_id() {
    command -v lspci >/dev/null 2>&1 || return 1
    # 0300 = VGA; em muitos notebooks híbridos a NVIDIA aparece como
    # "controlador 3D" (0302), e aí nada ia para a placa dedicada.
    { lspci -n -d 10de::0300; lspci -n -d 10de::0302; } 2>/dev/null | awk '{print $3; exit}'
}

NVIDIA_PCI_ID="$(nvidia_id)"

if [ -n "$NVIDIA_PCI_ID" ] && { [ -e /dev/nvidiactl ] || [ -d /proc/driver/nvidia ]; }; then
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __VK_LAYER_NV_optimus=NVIDIA_only
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export MESA_VK_DEVICE_SELECT="$NVIDIA_PCI_ID"
    export MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE=1
    export PROTON_ENABLE_NVAPI=1
fi

exec "$@"
