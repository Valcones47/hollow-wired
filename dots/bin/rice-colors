#!/usr/bin/env python3
"""rice-colors — permite trocar cores individuais da paleta do wallust.

O wallust extrai a paleta do wallpaper e não tem como dizer "gostei de tudo,
menos do vermelho". Este utilitário guarda substituições por cor e regenera os
mesmos arquivos que o wallust geraria, usando os mesmos templates:

    paleta efetiva = paleta extraída do wallpaper + cores trocadas à mão

As trocas ficam em ~/.config/hypr/color-overrides.json (arquivo do usuário,
nunca sobrescrito pelo rice) e sobrevivem a trocas de wallpaper: o que muda é
só a base.

Uso:
    rice-colors get                    # JSON: base, overrides e paleta efetiva
    rice-colors set color4 '#ff0055'   # troca uma cor
    rice-colors set accent2 '#ffb300'  # destaque livre da interface (accent1/accent2)
    rice-colors unset color4           # volta a usar a cor do wallpaper
    rice-colors reset                  # remove todas as trocas
    rice-colors snapshot               # guarda a paleta atual como base
    rice-colors apply                  # regenera os arquivos e recarrega tudo
    rice-colors auto                   # 1 = cores seguem o wallpaper, 0 = travadas
    rice-colors auto 0                 # congela a paleta atual
"""
import json
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".config/hypr/colors-base.json")
OVERRIDES = os.path.join(HOME, ".config/hypr/color-overrides.json")
WALLUST_JSON = os.path.join(HOME, ".cache/wallust/colors-quickshell.json")
TEMPLATES = os.path.join(HOME, ".config/wallust/templates")

KEYS = ["background", "foreground", "cursor"] + ["color%d" % i for i in range(16)]

# Mesmos destinos declarados em ~/.config/wallust/wallust.toml. Repetidos aqui
# porque o wallust não expõe um "re-render" com paleta customizada.
TARGETS = [
    ("hyprland-colors.conf", os.path.join(HOME, ".config/hypr/colors.conf")),
    ("waybar-colors.css", os.path.join(HOME, ".cache/wallust/colors-waybar.css")),
    ("kitty-colors.conf", os.path.join(HOME, ".config/kitty/colors-wallust.conf")),
    ("mako-colors", os.path.join(HOME, ".config/mako/colors")),
    ("quickshell-colors.json", WALLUST_JSON),
    ("hyprlock-colors.conf", os.path.join(HOME, ".config/hypr/hyprlock-colors.conf")),
    ("sddm-theme.conf", "/usr/share/sddm/themes/SilentSDDM/configs/default-left.conf"),
]

FALLBACK = {
    "background": "#111218", "foreground": "#e2e8f0", "cursor": "#e2e8f0",
    "color0": "#181922", "color1": "#f43f5e", "color2": "#10b981", "color3": "#f59e0b",
    "color4": "#3b82f6", "color5": "#d946ef", "color6": "#06b6d4", "color7": "#94a3b8",
    "color8": "#475569", "color9": "#fb7185", "color10": "#ff2a85", "color11": "#ef4444",
    "color12": "#60a5fa", "color13": "#e879f9", "color14": "#22d3ee", "color15": "#f8fafc",
}

# Destaques da interface escolhidos à mão. Não são cores da paleta: só o
# Quickshell (Theme.qml) lê, direto do color-overrides.json, então trocar um
# deles não regenera os templates.
ACCENT_KEYS = ["accent1", "accent2"]

HEX_RE = re.compile(r'^#?[0-9a-fA-F]{6}$')

# Chave reservada dentro do color-overrides.json: quando falsa, trocar de
# wallpaper deixa de mexer nas cores da interface (pedido de quem monta a
# própria paleta à mão e não quer perdê-la ao trocar o papel de parede).
AUTO_KEY = "__auto_from_wallpaper"


def auto_enabled():
    value = load_json(OVERRIDES).get(AUTO_KEY)
    return True if value is None else bool(value)


def set_auto(enabled):
    ov = load_json(OVERRIDES)
    ov[AUTO_KEY] = bool(enabled)
    save_json(OVERRIDES, ov)


def load_json(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")


def norm(value):
    v = str(value).strip()
    if not HEX_RE.match(v):
        return None
    return "#" + v.lstrip("#").upper()


# ------------------------------------------------- fundo sempre escuro

# O rice é um tema escuro: fundo claro deixa o painel, a barra e as
# notificações ilegíveis, porque todo o resto do shell assume texto claro.
# O wallust não resolve isso sozinho — a chave `style = "dark"` existia até o
# wallust 3 e virou no-op no 4.x (as paletas agora são só salience/ansi/kmeans),
# então um wallpaper branco produzia um fundo branco sem reclamar de nada.
# Só o fundo é forçado; as cores de destaque continuam saindo do wallpaper.
MAX_BG_LUM = 0.16
DARK_BG_VALUE = 0.075
MIN_FG_LUM = 0.55


def _rgb(hex_color):
    h = hex_color.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


def _hex(rgb):
    return "#%02X%02X%02X" % tuple(max(0, min(255, int(round(c * 255)))) for c in rgb)


def luminance(hex_color):
    """Luminância relativa (WCAG) — 0 = preto, 1 = branco."""
    out = []
    for c in _rgb(hex_color):
        out.append(c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4)
    return 0.2126 * out[0] + 0.7152 * out[1] + 0.0722 * out[2]


def _set_value(hex_color, value):
    """Reescala a cor para um brilho alvo, preservando matiz e saturação."""
    r, g, b = _rgb(hex_color)
    peak = max(r, g, b)
    if peak <= 0:
        return _hex((value, value, value))
    k = value / peak
    return _hex((r * k, g * k, b * k))


def enforce_dark_background(data):
    """Escurece o fundo quando o wallpaper é claro, sem mexer nos destaques."""
    if not isinstance(data, dict):
        return data
    bg = norm(data.get("background", ""))
    if bg and luminance(bg) > MAX_BG_LUM:
        data["background"] = _set_value(bg, DARK_BG_VALUE)
        # color0 é o "preto" do terminal; num tema claro ele vem quase branco e
        # sumiria contra o fundo novo.
        c0 = norm(data.get("color0", ""))
        if c0 and luminance(c0) > MAX_BG_LUM:
            data["color0"] = _set_value(c0, DARK_BG_VALUE + 0.06)
        # Com o fundo escuro, um texto escuro fica ilegível.
        fg = norm(data.get("foreground", ""))
        if fg and luminance(fg) < MIN_FG_LUM:
            data["foreground"] = _set_value(fg, 0.93)
    return data


# ------------------------------------------------- modo claro

# rice-theme-mode grava a escolha em ~/.config/hollow-wired/theme-mode.json:
# {"mode": "dark"|"light"|"auto", "light_from": "07:00", "dark_from": "18:00"}.
# No claro, a mesma paleta do wallpaper vira fundo claro e texto escuro, e os
# destaques são escurecidos até terem contraste com o fundo. O Theme.qml já
# troca o sentido do contraste sozinho quando o fundo é claro.
THEME_MODE = os.path.join(HOME, ".config/hollow-wired/theme-mode.json")


def _minutes(hhmm, default):
    try:
        h, m = str(hhmm).split(":")
        return int(h) * 60 + int(m)
    except (ValueError, AttributeError):
        return default


def theme_mode():
    """"light" ou "dark" (o "auto" já resolvido pelo horário)."""
    d = load_json(THEME_MODE)
    mode = d.get("mode", "dark")
    if mode == "auto":
        import datetime
        now = datetime.datetime.now()
        cur = now.hour * 60 + now.minute
        lf = _minutes(d.get("light_from"), 7 * 60)
        df = _minutes(d.get("dark_from"), 18 * 60)
        if lf <= df:
            return "light" if lf <= cur < df else "dark"
        return "dark" if df <= cur < lf else "light"
    return "light" if mode == "light" else "dark"


def _hls_set(hex_color, light=None, max_sat=None):
    import colorsys
    h, l, sat = colorsys.rgb_to_hls(*_rgb(hex_color))
    if light is not None:
        l = light
    if max_sat is not None:
        sat = min(sat, max_sat)
    return _hex(colorsys.hls_to_rgb(h, l, sat))


def to_light(p):
    """Variante clara da paleta (fundo claro, texto e destaques escuros)."""
    import colorsys
    out = dict(p)
    out["background"] = _hls_set(p["background"], 0.94, 0.22)
    out["foreground"] = _hls_set(p["foreground"], 0.14, 0.25)
    out["cursor"] = out["foreground"]
    # "preto" e "branco" do terminal trocam de papel: preto vira texto escuro,
    # branco vira cinza médio (como nos temas claros comuns).
    out["color0"] = _hls_set(p["color0"], 0.22, 0.2)
    out["color8"] = _hls_set(p["color8"], 0.48, 0.2)
    out["color7"] = _hls_set(p["color7"], 0.40, 0.2)
    out["color15"] = _hls_set(p["color15"], 0.30, 0.2)
    for i in (1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14):
        k = "color%d" % i
        h, l, sat = colorsys.rgb_to_hls(*_rgb(p[k]))
        out[k] = _hex(colorsys.hls_to_rgb(h, min(l, 0.40), sat))
    return out


def darken(hex_color, factor):
    """Contrário do lighten: mistura com preto (os templates pedem lighten
    para o texto do terminal ficar legível no escuro; no claro é o inverso)."""
    r, g, b = _rgb(hex_color)
    return _hex((r * (1 - factor), g * (1 - factor), b * (1 - factor)))


def base_palette():
    """Paleta vinda do wallpaper, sem as trocas do usuário."""
    data = enforce_dark_background(load_json(BASE))
    if not data:
        # Primeira execução: a saída atual do wallust ainda é limpa.
        data = load_json(WALLUST_JSON)
        if data:
            enforce_dark_background(data)
            save_json(BASE, data)
    out = dict(FALLBACK)
    for k in KEYS:
        v = norm(data.get(k, ""))
        if v:
            out[k] = v
    if not norm(data.get("cursor", "")):
        out["cursor"] = out["foreground"]
    if theme_mode() == "light":
        out = to_light(out)
    return out


def effective():
    palette = base_palette()
    for k, v in load_json(OVERRIDES).items():
        n = norm(v)
        if k in KEYS and n:
            palette[k] = n
    return palette


# ---------------------------------------------------------------- templates

def lighten(hex_color, factor):
    """Mesma conta do wallust: mistura a cor com branco em sRGB."""
    h = hex_color.lstrip("#")
    out = []
    for i in (0, 2, 4):
        c = int(h[i:i + 2], 16)
        out.append(min(255, int(round(c + factor * (255 - c)))))
    return "#%02X%02X%02X" % tuple(out)


PLACEHOLDER = re.compile(r'\{\{\s*([a-zA-Z0-9_]+)\s*((?:\|[^}]*)?)\}\}')


def render(text, palette):
    light = theme_mode() == "light"

    def sub(m):
        key, filters = m.group(1), m.group(2)
        value = palette.get(key)
        if value is None:
            return m.group(0)
        for f in [x.strip() for x in filters.split("|") if x.strip()]:
            if f == "strip":
                value = value.lstrip("#")
            else:
                lm = re.match(r'lighten\(\s*([0-9.]+)\s*\)', f)
                if lm:
                    f_ = float(lm.group(1))
                    value = darken(value, f_) if light else lighten(value, f_)
                else:
                    # Filtro desconhecido: melhor deixar a cor crua do que
                    # escrever lixo num arquivo de configuração.
                    pass
        return value
    return PLACEHOLDER.sub(sub, text)


def write_target(path, content):
    """Escreve o arquivo, usando sudo -n só quando for fora do $HOME."""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        return True
    except OSError:
        pass
    if not path.startswith(HOME) and shutil.which("sudo"):
        try:
            r = subprocess.run(["sudo", "-n", "tee", path], input=content.encode(),
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return r.returncode == 0
        except OSError:
            return False
    return False


def reload_apps():
    for cmd in (["pkill", "-SIGUSR1", "kitty"],
                ["makoctl", "reload"],
                ["hyprctl", "reload"]):
        if shutil.which(cmd[0]):
            subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    # Apps Qt/KDE e GTK (kdeglobals + gtk.css); ele mesmo respeita o interruptor.
    if shutil.which("rice-app-colors"):
        subprocess.run(["rice-app-colors", "apply"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply(quiet=False):
    palette = effective()
    written, skipped = [], []
    for name, target in TARGETS:
        tpl = os.path.join(TEMPLATES, name)
        if not os.path.isfile(tpl):
            skipped.append(name)
            continue
        with open(tpl, "r", encoding="utf-8") as f:
            content = render(f.read(), palette)
        (written if write_target(target, content) else skipped).append(os.path.basename(target))
    reload_apps()
    if not quiet:
        print(json.dumps({"written": written, "skipped": skipped}, ensure_ascii=False))
    return 0


# ------------------------------------------------- algoritmo da paleta

WALLUST_TOML = os.path.join(HOME, ".config/wallust/wallust.toml")

# kmeans devolve as cores que a imagem realmente tem (inclusive branco);
# salience caça as mais vívidas e, com intensity=vibrant, inventa saturação
# onde não há — foi o que deixava wallpaper claro com paleta toda vermelha.
PALETTES = {
    "kmeans": 'palette = "kmeans"',
    "salience": 'palette = "salience"\nsalience = { sampling = "high", intensity = "vibrant" }\nsaturation = 65',
    "ansi": 'palette = "ansi"',
}


def palette_mode(new_mode=None):
    if not os.path.isfile(WALLUST_TOML):
        return None
    with open(WALLUST_TOML, encoding="utf-8") as f:
        content = f.read()

    if new_mode is None:
        m = re.search(r'^palette\s*=\s*"(\w+)"', content, re.MULTILINE)
        return m.group(1) if m else None

    if new_mode not in PALETTES:
        return None

    # Tira as linhas do modo anterior antes de escrever o novo, senão um
    # `salience = {...}` órfão fica valendo junto com o kmeans.
    content = re.sub(r'^salience\s*=.*$\n?', '', content, flags=re.MULTILINE)
    content = re.sub(r'^saturation\s*=.*$\n?', '', content, flags=re.MULTILINE)
    content = re.sub(r'^palette\s*=\s*"\w+"$', PALETTES[new_mode], content,
                     count=1, flags=re.MULTILINE)
    with open(WALLUST_TOML, "w", encoding="utf-8") as f:
        f.write(content)
    return new_mode


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "get"

    if cmd == "get":
        print(json.dumps({
            "base": base_palette(),
            "overrides": {k: v for k, v in load_json(OVERRIDES).items() if k in KEYS or k in ACCENT_KEYS},
            "effective": effective(),
            "keys": KEYS,
            "auto": auto_enabled(),
        }, ensure_ascii=False))
        return 0

    if cmd == "palette":
        if len(args) < 2:
            print(palette_mode() or "desconhecido")
            return 0
        chosen = palette_mode(args[1])
        if not chosen:
            print("modos: %s" % ", ".join(sorted(PALETTES)), file=sys.stderr)
            return 2
        print("OK")
        return 0

    if cmd == "snapshot":
        data = load_json(WALLUST_JSON)
        if not data:
            print("sem paleta do wallust para guardar", file=sys.stderr)
            return 1
        enforce_dark_background(data)
        save_json(BASE, data)
        print("OK")
        return 0

    if cmd == "set":
        if len(args) < 3:
            print("Uso: rice-colors set <chave> <#RRGGBB>", file=sys.stderr)
            return 2
        key, value = args[1], norm(args[2])
        if key not in KEYS and key not in ACCENT_KEYS:
            print("chave desconhecida: %s" % key, file=sys.stderr)
            return 2
        if not value:
            print("cor inválida: %s" % args[2], file=sys.stderr)
            return 2
        ov = load_json(OVERRIDES)
        ov[key] = value
        save_json(OVERRIDES, ov)
        if key in ACCENT_KEYS:
            print("OK")
            return 0
        return apply(quiet=True) or (print("OK") or 0)

    if cmd == "unset":
        if len(args) < 2:
            return 2
        ov = load_json(OVERRIDES)
        ov.pop(args[1], None)
        save_json(OVERRIDES, ov)
        if args[1] in ACCENT_KEYS:
            print("OK")
            return 0
        return apply(quiet=True) or (print("OK") or 0)

    if cmd == "reset":
        save_json(OVERRIDES, {})
        return apply(quiet=True) or (print("OK") or 0)

    if cmd == "auto":
        if len(args) < 2:
            print("1" if auto_enabled() else "0")
            return 0
        set_auto(args[1] not in ("0", "false", "off", "nao", "não"))
        print("1" if auto_enabled() else "0")
        return 0

    if cmd == "apply":
        return apply()

    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
