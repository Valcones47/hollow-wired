#!/usr/bin/env bash
# rice-sddm-sync-wallpaper: Captura o frame estático em 1080p do wallpaper
# ativo do Waywallen e aplica na tela de login (SDDM / SilentSDDM).

TARGET_DIR="/usr/share/sddm/themes/SilentSDDM/backgrounds"
TARGET_IMG="$TARGET_DIR/current.png"

mkdir -p "$TARGET_DIR" 2>/dev/null || true

CURRENT_WS=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 1')

qs ipc call bar setBarVisible false 2>/dev/null || true
hyprctl dispatch "hl.dsp.focus({ workspace = 99 })" >/dev/null 2>&1
sleep 0.25

grim "$TARGET_IMG"

hyprctl dispatch "hl.dsp.focus({ workspace = $CURRENT_WS })" >/dev/null 2>&1
qs ipc call bar setBarVisible true 2>/dev/null || true

echo "[✓] Wallpaper do SDDM sincronizado com o Waywallen: $TARGET_IMG"
