#!/usr/bin/env python3
"""
rice-calc — Avaliador de expressões matemáticas seguro via AST para o Quickshell Launcher.
Não utiliza eval() arbitrário; apenas nós de constantes numéricas, operações aritméticas e funções math seguras.
"""

import sys
import ast
import math
import operator

SAFE_OPS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
    ast.USub: operator.neg,
    ast.UAdd: operator.pos,
}

SAFE_FUNCS = {
    'sqrt': math.sqrt,
    'sin': math.sin,
    'cos': math.cos,
    'tan': math.tan,
    'asin': math.asin,
    'acos': math.acos,
    'atan': math.atan,
    'abs': abs,
    'round': round,
    'log': math.log,
    'log10': math.log10,
    'log2': math.log2,
    'exp': math.exp,
    'ceil': math.ceil,
    'floor': math.floor,
    'min': min,
    'max': max,
    'pi': math.pi,
    'e': math.e,
}

def eval_node(node):
    if isinstance(node, ast.Constant):
        if isinstance(node.value, (int, float)):
            return node.value
        raise ValueError("Constante não numérica")
    elif isinstance(node, ast.BinOp):
        op = type(node.op)
        if op not in SAFE_OPS:
            raise ValueError(f"Operador binário não suportado: {op.__name__}")
        left = eval_node(node.left)
        right = eval_node(node.right)
        return SAFE_OPS[op](left, right)
    elif isinstance(node, ast.UnaryOp):
        op = type(node.op)
        if op not in SAFE_OPS:
            raise ValueError(f"Operador unário não suportado: {op.__name__}")
        return SAFE_OPS[op](eval_node(node.operand))
    elif isinstance(node, ast.Call):
        if not isinstance(node.func, ast.Name):
            raise ValueError("Chamada de função inválida")
        fn_name = node.func.id
        if fn_name not in SAFE_FUNCS or not callable(SAFE_FUNCS[fn_name]):
            raise ValueError(f"Função desconhecida: {fn_name}")
        args = [eval_node(arg) for arg in node.args]
        return SAFE_FUNCS[fn_name](*args)
    elif isinstance(node, ast.Name):
        if node.id in SAFE_FUNCS and not callable(SAFE_FUNCS[node.id]):
            return SAFE_FUNCS[node.id]
        raise ValueError(f"Identificador não permitido: {node.id}")
    else:
        raise ValueError(f"Expressão não suportada: {type(node).__name__}")

def format_result(val):
    if isinstance(val, float):
        if val.is_integer():
            return str(int(val))
        return f"{val:.6g}"
    return str(val)

def main():
    if len(sys.argv) < 2:
        sys.exit(1)
    
    expr = " ".join(sys.argv[1:]).strip()
    if not expr:
        sys.exit(1)
    
    import re
    # Substituições comuns de conveniência
    expr = expr.replace('×', '*').replace('÷', '/').replace('^', '**')
    expr = re.sub(r'(\d+),(\d+)', r'\1.\2', expr)
    
    try:
        tree = ast.parse(expr, mode='eval')
        res = eval_node(tree.body)
        print(format_result(res))
    except Exception:
        sys.exit(1)

if __name__ == '__main__':
    main()
