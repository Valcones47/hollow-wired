#!/usr/bin/env python3
"""rice-display-mode — o "Projetar" (Win + P) do rice: como as telas são usadas.

Modos:
  internal  só a tela do notebook (as externas desligam)
  mirror    as externas espelham a tela do notebook
  extend    uma área de trabalho em cada tela (padrão)
  external  só as telas externas (a do notebook desliga)

Uso:
  rice-display-mode get              # JSON: modo salvo, efetivo e telas
  rice-display-mode set <modo>       # aplica e volta sozinho em 15 s sem "keep"
  rice-display-mode keep             # confirma o último "set"
  rice-display-mode apply            # reaplica o modo salvo (monitor entrou/saiu)
  rice-display-mode next             # próximo modo da lista (Super + P de novo)

O modo fica em ~/.config/hypr/user-prefs.json ("display_mode") e o
hyprland.lua o respeita ao carregar. Tela preta não pode ficar: sem tela
externa conectada, "external" vira "internal" na hora de aplicar (o salvo não
muda: ao religar o monitor, volta a valer).
"""
import json
import os
import subprocess
import sys
import time

PREFS = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "hypr/user-prefs.json")
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "hollow-wired")
PENDING = os.path.join(RUN, "display-mode-pending.json")
MODES = ["internal", "mirror", "extend", "external"]
CONFIRM_S = 15
POSITIONS = ("auto", "auto-left", "auto-right", "auto-up", "auto-down",
             "auto-center-left", "auto-center-right", "auto-center-up", "auto-center-down")


def prefs():
    try:
        with open(PREFS) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(p):
    with open(PREFS, "w") as f:
        f.write(json.dumps(p, indent=2, ensure_ascii=False) + "\n")


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "all", "-j"], capture_output=True, text=True, timeout=5).stdout
        return json.loads(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return []


def is_internal(name):
    return name.startswith(("eDP", "LVDS", "DSI"))


def entry_for(p, m):
    """Configuração salva da tela; sem ela, a atual (e passa a ficar salva,
    para o hyprland.lua conseguir reaplicar o modo no próximo login)."""
    mons = p.setdefault("monitors", {})
    e = mons.get(m["name"])
    if not e:
        e = {
            "mode": "%dx%d@%.2f" % (m["width"], m["height"], m["refreshRate"]),
            "scale": m.get("scale", 1),
            "transform": m.get("transform", 0),
        }
        mons[m["name"]] = e
    return e


def effective(mode, mons):
    has_internal = any(is_internal(m["name"]) for m in mons)
    has_external = any(not is_internal(m["name"]) for m in mons)
    if not has_internal or not has_external:
        return "extend"  # uma tela só (ou nenhuma interna): nada a escolher
    return mode if mode in MODES else "extend"


def hypr_eval(code):
    subprocess.run(["hyprctl", "eval", code], capture_output=True, timeout=10)


def apply_mode(mode):
    p = prefs()
    mons = monitors()
    eff = effective(mode, mons)
    internal = next((m["name"] for m in mons if is_internal(m["name"])), "")
    # Liga primeiro quem vai ficar ligado, depois desliga o resto: nunca passa
    # por um instante sem nenhuma tela.
    plan = []
    for m in mons:
        e = entry_for(p, m)
        name = m["name"]
        off = (eff == "internal" and not is_internal(name)) or (eff == "external" and is_internal(name))
        mirror = internal if (eff == "mirror" and not is_internal(name)) else ""
        pos = e.get("position", "auto")
        if pos not in POSITIONS:
            pos = "auto"
        code = ("hl.monitor({ output = '%s', mode = '%s', position = '%s', scale = '%s', transform = %d, "
                "disabled = %s, mirror = '%s' })") % (
            name, e.get("mode", "preferred"), pos, e.get("scale", 1), int(e.get("transform", 0)),
            "true" if off else "false", mirror)
        plan.append((off, code))
    save(p)
    for off, code in sorted(plan, key=lambda x: x[0]):
        hypr_eval(code)
    return eff


def set_mode(mode):
    if mode not in MODES:
        raise SystemExit("modo inválido: " + mode)
    p = prefs()
    previous = p.get("display_mode", "extend")
    p["display_mode"] = mode
    save(p)
    apply_mode(mode)
    if mode == previous:
        return
    # Confirmação: sem "keep" em 15 s, volta ao anterior (tela que não acendeu,
    # espelho num monitor que não aceita o modo...). Roda solto do chamador.
    os.makedirs(RUN, exist_ok=True)
    token = str(time.time())
    with open(PENDING, "w") as f:
        json.dump({"previous": previous, "mode": mode, "token": token, "deadline": time.time() + CONFIRM_S}, f)
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "_revert", token],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


def revert_later(token):
    time.sleep(CONFIRM_S)
    try:
        with open(PENDING) as f:
            pend = json.load(f)
    except (OSError, ValueError):
        return
    if pend.get("token") != token:
        return
    os.remove(PENDING)
    p = prefs()
    p["display_mode"] = pend.get("previous", "extend")
    save(p)
    apply_mode(p["display_mode"])
    subprocess.run(["notify-send", "-a", "Telas", "-i", "video-display", "-t", "4000",
                    "Telas: configuração anterior de volta", "A mudança não foi confirmada."],
                   capture_output=True)


def keep():
    try:
        os.remove(PENDING)
    except OSError:
        pass


def get():
    p = prefs()
    mons = monitors()
    mode = p.get("display_mode", "extend")
    pend = None
    try:
        with open(PENDING) as f:
            pend = json.load(f)
    except (OSError, ValueError):
        pass
    print(json.dumps({
        "mode": mode,
        "effective": effective(mode, mons),
        "pending": max(0, int(pend["deadline"] - time.time())) if pend else 0,
        "monitors": [{"name": m["name"], "internal": is_internal(m["name"]),
                      "disabled": m.get("disabled", False)} for m in mons],
    }, ensure_ascii=False))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "get"
    if cmd == "get":
        get()
    elif cmd == "set" and len(sys.argv) > 2:
        set_mode(sys.argv[2])
    elif cmd == "keep":
        keep()
    elif cmd == "apply":
        apply_mode(prefs().get("display_mode", "extend"))
    elif cmd == "next":
        cur = prefs().get("display_mode", "extend")
        set_mode(MODES[(MODES.index(cur) + 1) % len(MODES)] if cur in MODES else "extend")
    elif cmd == "_revert" and len(sys.argv) > 2:
        revert_later(sys.argv[2])
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
