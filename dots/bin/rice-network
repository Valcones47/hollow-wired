#!/usr/bin/env python3
"""
rice-network: Gerenciamento CLI e JSON de Wi-Fi e Rede para o Rice Hyprland / Quickshell
Uso:
  rice-network status
  rice-network scan
  rice-network toggle-wifi
  rice-network connect <SSID> [PASSWORD]
  rice-network disconnect
  rice-network ping
"""

import os
import sys
import subprocess
import json
import re

def notify(msg, title="Rede & Wi-Fi", icon="network-wireless"):
    try:
        subprocess.run(["notify-send", "-a", "Rede", "-i", icon, "-t", "2500", title, msg], check=False)
    except Exception:
        pass

def get_status():
    wifi_enabled = False
    try:
        rad = subprocess.check_output(["nmcli", "radio", "wifi"], text=True, stderr=subprocess.DEVNULL).strip()
        wifi_enabled = (rad.lower() in ("enabled", "habilitado"))
    except Exception:
        pass

    connected_ssid = None
    signal = 0
    security = ""
    freq = ""
    bars = ""
    iface = "wlan0"

    try:
        dev_out = subprocess.check_output(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], text=True, stderr=subprocess.DEVNULL)
        for d in dev_out.strip().split("\n"):
            if ":wifi" in d:
                iface = d.split(":")[0]
                break
    except Exception:
        pass

    if wifi_enabled:
        try:
            lines = subprocess.check_output(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY,BARS,FREQ", "dev", "wifi", "list"], text=True, stderr=subprocess.DEVNULL).split("\n")
            for l in lines:
                if not l.strip():
                    continue
                parts = l.split(":")
                if len(parts) >= 6 and parts[0].lower() in ("yes", "sim"):
                    connected_ssid = parts[1]
                    signal = int(parts[2]) if parts[2].isdigit() else 0
                    security = parts[3]
                    bars = parts[4]
                    freq = parts[5]
                    break
        except Exception:
            pass

    ip_addr = ""
    gateway = ""
    if connected_ssid:
        try:
            route_out = subprocess.check_output(["ip", "-j", "-4", "route", "get", "1.1.1.1"], text=True, stderr=subprocess.DEVNULL)
            route_data = json.loads(route_out)
            if route_data and len(route_data) > 0:
                ip_addr = route_data[0].get("prefsrc", "")
                gateway = route_data[0].get("gateway", "")
        except Exception:
            pass

    return {
        "wifi_enabled": wifi_enabled,
        "interface": iface,
        "connected_ssid": connected_ssid,
        "signal": signal,
        "security": security,
        "bars": bars,
        "freq": freq,
        "ip": ip_addr,
        "gateway": gateway,
        "is_5g": ("5" in freq or "5GHz" in freq) if freq else False
    }

def get_scan():
    networks = []
    seen = set()
    try:
        lines = subprocess.check_output(["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY,BARS,FREQ", "dev", "wifi", "list", "--rescan", "no"], text=True, stderr=subprocess.DEVNULL).split("\n")
        for l in lines:
            if not l.strip():
                continue
            parts = l.split(":")
            if len(parts) >= 6:
                active = parts[0].lower() in ("yes", "sim")
                ssid = parts[1].strip()
                if not ssid or ssid in seen:
                    continue
                seen.add(ssid)
                sig = int(parts[2]) if parts[2].isdigit() else 0
                sec = parts[3].strip()
                freq = parts[5].strip()
                networks.append({
                    "ssid": ssid,
                    "signal": sig,
                    "security": sec,
                    "protected": bool(sec and sec != "--"),
                    "active": active,
                    "is_5g": "5" in freq or (freq.isdigit() and int(freq) > 4000)
                })
    except Exception:
        pass
    networks.sort(key=lambda x: (not x["active"], -x["signal"]))
    return networks

def measure_ping():
    try:
        out = subprocess.check_output(["env", "LANG=C", "ping", "-c", "1", "-W", "2", "1.1.1.1"], text=True, stderr=subprocess.DEVNULL)
        match = re.search(r"time=([0-9.]+)\s*ms", out)
        if match:
            return round(float(match.group(1)), 1)
    except Exception:
        pass
    return None

def split_terse(line):
    """Divide uma linha do `nmcli -t` nos ':' que não estão escapados (\\:)."""
    parts = re.split(r'(?<!\\):', line)
    return [p.replace('\\:', ':').replace('\\\\', '\\') for p in parts]


def connections():
    """Conexões salvas do NetworkManager: nome, uuid, tipo e se está ativa."""
    out = []
    try:
        txt = subprocess.check_output(
            ["nmcli", "-t", "-f", "NAME,UUID,TYPE,ACTIVE", "connection", "show"],
            text=True, stderr=subprocess.DEVNULL)
    except Exception:
        return out
    for line in txt.splitlines():
        f = split_terse(line)
        if len(f) >= 4:
            out.append({"name": f[0], "uuid": f[1], "type": f[2], "active": f[3] in ("yes", "sim")})
    return out


# VPN pelo NetworkManager: plugins (OpenVPN, WireGuard via NM...) e WireGuard nativo.
VPN_TYPES = ("vpn", "wireguard")


# Economia de energia do Wi-Fi: a placa "cochila" entre pacotes. Medido aqui:
# ligada, ~400 Mbit/s e oscilando; desligada, ~460 Mbit/s. O rice deixa
# desligada por padrão (install.sh). A escolha fica no NetworkManager
# (wifi.powersave: 2 = desligada, 3 = ligada), que vale em toda conexão e
# sobrevive a reinícios; o `iw` aplica na hora.
POWERSAVE_CONF = "/etc/NetworkManager/conf.d/99-hollow-wired-wifi-powersave.conf"


def wifi_ifaces():
    try:
        out = subprocess.check_output(["nmcli", "-t", "-f", "DEVICE,TYPE", "device"], text=True, stderr=subprocess.DEVNULL)
        return [l.split(":")[0] for l in out.splitlines() if l.split(":")[1:2] == ["wifi"]]
    except Exception:
        return []


def powersave_status():
    on = None
    for dev in wifi_ifaces():
        try:
            out = subprocess.check_output(["iw", "dev", dev, "get", "power_save"], text=True, stderr=subprocess.DEVNULL)
            on = "on" in out.lower()
            break
        except Exception:
            pass
    saved = None
    try:
        with open(POWERSAVE_CONF) as f:
            m = re.search(r"wifi\.powersave\s*=\s*(\d)", f.read())
            if m:
                saved = m.group(1) == "3"
    except OSError:
        pass
    return {"enabled": on, "saved": saved, "ifaces": wifi_ifaces()}


def powersave_set(enable):
    val = "3" if enable else "2"
    conf = f"[connection]\n# hollow-wired: economia de energia do Wi-Fi (2 = desligada, 3 = ligada)\nwifi.powersave = {val}\n"
    script = f"printf '%s' \"$1\" > {POWERSAVE_CONF} && chmod 644 {POWERSAVE_CONF}"
    for dev in wifi_ifaces():
        script += f" && iw dev {dev} set power_save {'on' if enable else 'off'}"
    # Uma senha só (janela do polkit); no terminal, sudo.
    runner = ["sudo"] if os.geteuid() != 0 and sys.stdin.isatty() else ([] if os.geteuid() == 0 else ["pkexec"])
    res = subprocess.run(runner + ["sh", "-c", script, "_", conf], capture_output=True, text=True)
    return res.returncode == 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"

    if cmd == "powersave":
        if len(sys.argv) > 2 and sys.argv[2] in ("on", "off"):
            ok = powersave_set(sys.argv[2] == "on")
            print(json.dumps({"success": ok, **powersave_status()}))
        else:
            print(json.dumps(powersave_status()))
        return

    if cmd == "vpn-list":
        print(json.dumps([c for c in connections() if c["type"] in VPN_TYPES]))
        return

    if cmd == "saved-wifi":
        print(json.dumps([c for c in connections() if c["type"] == "802-11-wireless"]))
        return

    if cmd in ("vpn-up", "vpn-down", "forget") and len(sys.argv) > 2:
        uuid = sys.argv[2]
        con = next((c for c in connections() if c["uuid"] == uuid), None)
        if not con:
            print(json.dumps({"success": False, "error": "conexão não encontrada"}))
            return
        if cmd == "forget" and con["type"] != "802-11-wireless":
            print(json.dumps({"success": False, "error": "só redes Wi-Fi podem ser esquecidas aqui"}))
            return
        action = {"vpn-up": "up", "vpn-down": "down", "forget": "delete"}[cmd]
        res = subprocess.run(["nmcli", "connection", action, "uuid", uuid], capture_output=True, text=True)
        ok = res.returncode == 0
        if not ok:
            notify(res.stderr.strip()[:120] or "Falha", con["name"], icon="dialog-error")
        print(json.dumps({"success": ok}))
        return

    if cmd == "status":
        print(json.dumps(get_status(), indent=2))
        return

    if cmd == "scan":
        print(json.dumps(get_scan(), indent=2))
        return

    if cmd == "ping":
        p = measure_ping()
        print(json.dumps({"ping_ms": p}))
        return

    if cmd == "toggle-wifi":
        st = get_status()
        new_state = "off" if st["wifi_enabled"] else "on"
        subprocess.run(["nmcli", "radio", "wifi", new_state], check=False)
        notify(f"Wi-Fi {'Ligado' if new_state == 'on' else 'Desligado'}")
        print(json.dumps({"wifi_enabled": new_state == "on"}))
        return

    if cmd == "disconnect":
        st = get_status()
        if st["interface"]:
            subprocess.run(["nmcli", "device", "disconnect", st["interface"]], check=False)
            notify("Desconectado do Wi-Fi")
            print(json.dumps({"success": True}))
        return

    if cmd == "connect" and len(sys.argv) > 2:
        ssid = sys.argv[2]
        password = sys.argv[3] if len(sys.argv) > 3 else None
        notify(f"Conectando a {ssid}...")
        
        args = ["nmcli", "device", "wifi", "connect", ssid]
        if password:
            args.extend(["password", password])
            
        res = subprocess.run(args, capture_output=True, text=True)
        if res.returncode == 0:
            notify(f"Conectado com sucesso a {ssid}!")
            print(json.dumps({"success": True}))
        else:
            notify(f"Erro ao conectar a {ssid}: {res.stderr.strip()[:60]}", "Falha de Conexão", icon="dialog-error")
            print(json.dumps({"success": False, "error": res.stderr.strip()}))
        return

    print("Uso: rice-network [status|scan|ping|toggle-wifi|connect <SSID> [PASS]|disconnect|vpn-list|vpn-up <uuid>|vpn-down <uuid>|saved-wifi|forget <uuid>|powersave [on|off]]")

if __name__ == "__main__":
    main()
