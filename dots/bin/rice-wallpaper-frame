#!/usr/bin/env bash
# ==============================================================================
# rice-wallpaper-frame — devolve a melhor imagem estática de um wallpaper.
#
# O Wallpaper Engine guarda um `preview` minúsculo e QUADRADO junto de cada
# item: na biblioteca daqui eles vão de 140x140 a 1024x1024. Esticar isso para
# a tela inteira fica horrível, e alimentar o wallust com um thumbnail quadrado
# também não representa o wallpaper de verdade.
#
# Quando o wallpaper é vídeo (mp4/webm/mkv), dá para extrair um quadro na
# resolução real com o ffmpeg — 1920x1080 em vez de 924x924. O quadro fica em
# cache, então só a primeira vez custa alguma coisa.
#
# Para cenas (scene.pkg) não há vídeo para extrair e o preview é o que existe.
#
# Uso:
#   rice-wallpaper-frame [--cached-only] <diretório do wallpaper> [preview de reserva]
#
# --cached-only: só consulta o cache, nunca roda o ffmpeg (usado no clique do
# seletor, que não pode esperar uma extração).
# Imprime o caminho da melhor imagem, ou nada se não houver nenhuma.
# ==============================================================================

set -uo pipefail

cached_only=0
[ "${1:-}" = "--cached-only" ] && { cached_only=1; shift; }
dir="${1:-}"
fallback="${2:-}"

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hollow-wired/frames"

emit_fallback() {
    if [ -n "$fallback" ] && [ -f "$fallback" ]; then
        printf '%s\n' "$fallback"
    elif [ -n "$dir" ]; then
        for p in "$dir"/preview.jpg "$dir"/preview.png "$dir"/preview.gif; do
            [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
        done
    fi
}

[ -n "$dir" ] && [ -d "$dir" ] || { emit_fallback; exit 0; }

# Cenas (scene.pkg) não têm vídeo para extrair, mas podem ter sido fotografadas
# em tela cheia por `rice-wallpaper-previews scenes`. Essa foto é o melhor que
# existe para elas e vale mais que o preview quadrado.
scene_shot="$CACHE/scene-$(basename "$dir").jpg"
if [ -s "$scene_shot" ]; then
    printf '%s\n' "$scene_shot"
    exit 0
fi

command -v ffmpeg >/dev/null 2>&1 || { emit_fallback; exit 0; }

video=""
for ext in mp4 webm mkv; do
    # O nome do arquivo varia por item (inclusive com caracteres não-ASCII),
    # então é uma busca, não um nome fixo.
    found=$(find "$dir" -maxdepth 1 -type f -iname "*.$ext" -print -quit 2>/dev/null)
    [ -n "$found" ] && { video="$found"; break; }
done

[ -n "$video" ] || { emit_fallback; exit 0; }

mkdir -p "$CACHE"
key=$(printf '%s' "$video" | sha256sum | cut -c1-32)
# JPEG, não PNG: o PNG do mesmo quadro sai com 1 a 4 MB e demora para o QML
# decodificar bem na hora em que a transição precisa desenhar. Em JPEG de
# qualidade alta o arquivo fica na casa das centenas de KB e a diferença não
# aparece numa imagem que fica menos de dois segundos na tela.
out="$CACHE/$key.jpg"

# Reaproveita o cache, a menos que o vídeo tenha sido trocado por baixo.
if [ -f "$out" ] && [ "$out" -nt "$video" ]; then
    printf '%s\n' "$out"
    exit 0
fi

[ "$cached_only" = 1 ] && { emit_fallback; exit 0; }

# 3s evita fade-in preto que muitos wallpapers têm no começo. Se o vídeo for
# mais curto que isso o ffmpeg falha, e aí tenta de novo no primeiro quadro.
if ! ffmpeg -y -ss 3 -i "$video" -frames:v 1 -q:v 3 "$out" >/dev/null 2>&1 || [ ! -s "$out" ]; then
    ffmpeg -y -i "$video" -frames:v 1 -q:v 3 "$out" >/dev/null 2>&1
fi

if [ -s "$out" ]; then
    printf '%s\n' "$out"
else
    rm -f "$out"
    emit_fallback
fi
