#!/usr/bin/env bash
# ==============================================================================
# rice-wallpaper-frame — devolve a melhor imagem estática de um wallpaper.
#
# O Wallpaper Engine guarda um `preview` minúsculo e QUADRADO junto de cada
# item: na biblioteca daqui eles vão de 140x140 a 1024x1024. Esticar isso para
# a tela inteira fica horrível, e alimentar o wallust com um thumbnail quadrado
# também não representa o wallpaper de verdade.
#
# Quando o wallpaper é vídeo (mp4/webm/mkv), dá para extrair um quadro na
# resolução real com o ffmpeg — 1920x1080 em vez de 924x924. O quadro fica em
# cache, então só a primeira vez custa alguma coisa.
#
# Para cenas (scene.pkg) não há vídeo para extrair e o preview é o que existe.
#
# Uso:
#   rice-wallpaper-frame [--cached-only] <diretório do wallpaper> [preview de reserva]
#   rice-wallpaper-frame [--cached-only] <arquivo de vídeo ou imagem>
#
# O arquivo direto é para os itens das pastas comuns do Waywallen (plugins
# "video" e "image"): uma pasta dessas tem vários vídeos, e procurar "o vídeo
# da pasta" pegaria sempre o primeiro. Imagem sai como está.
#
# --cached-only: só consulta o cache, nunca roda o ffmpeg (usado no clique do
# seletor, que não pode esperar uma extração).
# Imprime o caminho da melhor imagem, ou nada se não houver nenhuma.
# ==============================================================================

set -uo pipefail

cached_only=0
[ "${1:-}" = "--cached-only" ] && { cached_only=1; shift; }
dir="${1:-}"
fallback="${2:-}"

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/hollow-wired/frames"

emit_fallback() {
    if [ -n "$fallback" ] && [ -f "$fallback" ]; then
        printf '%s\n' "$fallback"
    elif [ -n "$dir" ]; then
        for p in "$dir"/preview.jpg "$dir"/preview.png "$dir"/preview.gif; do
            [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
        done
    fi
}

video=""
if [ -n "$dir" ] && [ -f "$dir" ]; then
    case "${dir,,}" in
        *.mp4|*.webm|*.mkv|*.mov|*.avi) video="$dir" ;;
        *.png|*.jpg|*.jpeg|*.webp|*.bmp|*.gif) printf '%s\n' "$dir"; exit 0 ;;
        *) exit 0 ;;
    esac
fi

if [ -z "$video" ]; then
[ -n "$dir" ] && [ -d "$dir" ] || { emit_fallback; exit 0; }

# Cenas (scene.pkg) não têm vídeo para extrair, mas podem ter sido fotografadas
# em tela cheia por `rice-wallpaper-previews scenes`. Essa foto é o melhor que
# existe para elas e vale mais que o preview quadrado.
scene_shot="$CACHE/scene-$(basename "$dir").jpg"
if [ -s "$scene_shot" ]; then
    printf '%s\n' "$scene_shot"
    exit 0
fi

command -v ffmpeg >/dev/null 2>&1 || { emit_fallback; exit 0; }

for ext in mp4 webm mkv; do
    # O nome do arquivo varia por item (inclusive com caracteres não-ASCII),
    # então é uma busca, não um nome fixo.
    found=$(find "$dir" -maxdepth 1 -type f -iname "*.$ext" -print -quit 2>/dev/null)
    [ -n "$found" ] && { video="$found"; break; }
done

fi

[ -n "$video" ] || { emit_fallback; exit 0; }

mkdir -p "$CACHE"

# Chave do cache = caminho do vídeo. O Waywallen (Flatpak) enxerga as pastas
# comuns pelo portal de documentos (/run/user/<uid>/doc/<id>/...), e é por esse
# caminho que o seletor pede o quadro na transição. Quem extrai pela pasta real
# (painel, "pasta escolhida") chegaria com outro caminho, outra chave, e o
# quadro nunca seria achado. Então um caminho real dentro de uma pasta
# exportada vira o caminho do portal antes de virar chave. O mapa vem de
# `flatpak documents` e fica guardado por 10 min (a consulta leva ~50 ms).
map="$CACHE/doc-map.tsv"
if [ -z "$(find "$map" -mmin -10 2>/dev/null)" ] && command -v flatpak >/dev/null 2>&1; then
    flatpak documents --columns=path,origin 2>/dev/null > "$map.tmp" && mv -f "$map.tmp" "$map"
fi
keypath="$video"
if [ -f "$map" ]; then
    while IFS=$'\t' read -r portal host; do
        [ -n "$host" ] || continue
        case "$video" in
            "$host"/*) keypath="$portal/${video#"$host"/}"; break ;;
        esac
    done < "$map"
fi
key=$(printf '%s' "$keypath" | sha256sum | cut -c1-32)
# JPEG, não PNG: o PNG do mesmo quadro sai com 1 a 4 MB e demora para o QML
# decodificar bem na hora em que a transição precisa desenhar. Em JPEG de
# qualidade alta o arquivo fica na casa das centenas de KB e a diferença não
# aparece numa imagem que fica menos de dois segundos na tela.
# "-f0": primeiro quadro. Os de antes eram dos 3 s e ficam para trás no cache
# (nome diferente), sem risco de a transição usar o quadro errado.
out="$CACHE/$key-f0.jpg"

# Reaproveita o cache, a menos que o vídeo tenha sido trocado por baixo.
if [ -f "$out" ] && [ "$out" -nt "$video" ]; then
    printf '%s\n' "$out"
    exit 0
fi

[ "$cached_only" = 1 ] && { emit_fallback; exit 0; }

# O PRIMEIRO quadro exato: o vídeo começa dele, então a imagem que cobre a
# tela na transição emenda sem pulo quando o vídeo aparece. (Antes era o
# quadro dos 3 s, para fugir do começo preto — e a transição dava um salto.)
# Exceção: começo praticamente preto (fade-in) daria uma paleta toda escura
# para o wallust; aí vale o quadro dos 3 s.
ffmpeg -y -i "$video" -frames:v 1 -q:v 2 "$out" >/dev/null 2>&1
if [ -s "$out" ] && command -v magick >/dev/null 2>&1; then
    lum=$(magick "$out" -colorspace Gray -format "%[fx:mean]" info: 2>/dev/null)
    if awk -v l="${lum:-1}" 'BEGIN { exit !(l < 0.035) }'; then
        ffmpeg -y -ss 3 -i "$video" -frames:v 1 -q:v 2 "$out.tmp.jpg" >/dev/null 2>&1 \
            && [ -s "$out.tmp.jpg" ] && mv -f "$out.tmp.jpg" "$out"
        rm -f "$out.tmp.jpg"
    fi
fi

# Paleta pré-calculada em segundo plano: na troca o wallust roda com a tela
# coberta, e sem cache ele levava 1 a 4 s — a transição esperava e revelava
# no meio da recoloração, com o vídeo engasgando. Com cache são milissegundos.
precompute_palette() {
    command -v wallust >/dev/null 2>&1 || return 0
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wallust/wallust.toml" pre="$CACHE/wallust-precompute.toml"
    [ -f "$cfg" ] || return 0
    # Cópia sem [templates] e [hooks]: só calcula e guarda, sem aplicar cores
    # nem recarregar kitty/mako.
    if [ ! -f "$pre" ] || [ "$cfg" -nt "$pre" ]; then
        awk '/^\[(templates|hooks)\]/{skip=1; next} /^\[/{skip=0} !skip' "$cfg" > "$pre"
    fi
    ( nice -n 15 wallust run -s -T -q -C "$pre" "$1" >/dev/null 2>&1 & )
}

if [ -s "$out" ]; then
    precompute_palette "$out"
    printf '%s\n' "$out"
else
    rm -f "$out"
    emit_fallback
fi
