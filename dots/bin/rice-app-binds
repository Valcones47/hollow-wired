#!/usr/bin/env python3
"""rice-app-binds — atalhos de teclado para abrir aplicativos, sem editar código.

Até agora, "personalizar atalhos" abria o user-binds.lua num editor de texto e
esperava que a pessoa soubesse escrever Lua. Quem vem do Windows ou do KDE
espera outra coisa: escolher o programa, apertar a combinação de teclas e
pronto.

Este utilitário é o lado de trás disso. Ele mantém um bloco próprio dentro do
~/.config/hypr/user-binds.lua, delimitado por marcadores, e nunca encosta no
que a pessoa escreveu à mão fora dele.

Uso:
    rice-app-binds list                          # JSON com os atalhos
    rice-app-binds add "SUPER + K" kitty --name Kitty
    rice-app-binds remove "SUPER + K"
    rice-app-binds record [--timeout 12]         # captura uma combinação

A captura de teclas reaproveita o gravador do rice-discord-binds, que já lê o
/dev/input e devolve a combinação pronta no formato do Hyprland.
"""
import json
import os
import re
import subprocess
import sys

HOME = os.path.expanduser("~")
USER_BINDS = os.path.join(HOME, ".config/hypr/user-binds.lua")
HYPR_LUA = os.path.join(HOME, ".config/hypr/hyprland.lua")

BEGIN = "-- >>> rice-app-binds: atalhos criados pelo painel (Super + I) >>>"
END = "-- <<< rice-app-binds <<<"

HEADER = BEGIN + """
-- Este bloco é reescrito pelo painel. Para atalhos seus, escreva FORA dele:
-- o que estiver fora nunca é tocado.
"""

LINE_RE = re.compile(
    r'^hl\.bind\("(?P<combo>[^"]+)",\s*hl\.dsp\.exec_cmd\("(?P<cmd>[^"]*)"\)\)'
    r'\s*--\s*@app=(?P<name>.*)$'
)


def read_file():
    try:
        with open(USER_BINDS, "r", encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def split_block(text):
    """Devolve (antes, corpo_do_bloco, depois)."""
    i = text.find(BEGIN)
    if i == -1:
        return text, "", ""
    j = text.find(END, i)
    if j == -1:
        return text[:i], text[i + len(BEGIN):], ""
    return text[:i], text[i + len(BEGIN):j], text[j + len(END):]


# Atalhos que abrem programas e que NÃO foram criados por aqui: os que o rice
# já traz no hyprland.lua e os que a pessoa escreveu à mão no user-binds.lua
# fora do bloco gerenciado. Sem varrer os dois, o painel dizia "você ainda não
# criou nenhum atalho" com três atalhos funcionando na máquina.
SCAN_RE = re.compile(
    r'hl\.bind\(\s*"(?P<combo>[^"]+)"\s*,\s*hl\.dsp\.exec_cmd\((?P<expr>.+?)\)\s*\)'
)

RUNTIMES = {"python", "python3", "bash", "sh", "node", "flatpak", "env"}


def expr_to_command(expr):
    """Transforma a expressão Lua num comando legível."""
    parts = re.findall(r'"([^"]*)"|(\bhome\b)', expr)
    out = []
    for literal, is_home in parts:
        out.append("~" if is_home else literal)
    text = "".join(out).strip()
    return re.sub(r"\s+", " ", text)


def command_to_name(command):
    tokens = [t for t in command.split(" ") if t]
    if not tokens:
        return command
    first = os.path.basename(tokens[0])
    # "python .../tray.py" fica mais claro como "tray" do que como "python".
    if first in RUNTIMES and len(tokens) > 1:
        for t in tokens[1:]:
            if not t.startswith("-"):
                first = os.path.basename(t)
                break
    return os.path.splitext(first)[0] or command


# ---------------------------------------------------------------- overrides
#
# Trocar um atalho que o rice já traz. O hyprland.lua é do repositório e não
# pode ser editado por usuário, então a troca vira duas linhas no bloco
# gerenciado do user-binds.lua, lidas depois dele:
#
#     hl.unbind("SUPER + Q")
#     hl.bind("SUPER + ALT + T", hl.dsp.exec_cmd("kitty"))
#
# A ação é copiada verbatim do hyprland.lua, então não existe tabela de
# ações para manter em dia. O que não pode ser copiado é o que depende de
# variáveis locais de lá (o comando do launcher, as funções do Discord) ou o
# que nasce dentro de um laço (Super + 1..9): esses ficam marcados como não
# customizáveis em vez de gerar um atalho quebrado.
BIND_RE = re.compile(r'^hl\.bind\(\s*(?P<combo>"[^"]+"|mainMod\s*\.\.\s*"[^"]+")\s*,\s*(?P<action>.+?)\s*(?:,\s*\{.*\})?\s*\)\s*$')

SAFE_IDENTS = {"hl", "home", "mainMod", "true", "false", "nil"}

# `hl.dsp.exec_cmd(terminal)` não pode ser copiado assim para o user-binds.lua,
# mas `local terminal = "kitty"` está logo ali no mesmo arquivo. Resolver essas
# locais de texto simples transforma a maioria dos atalhos do rice em
# customizáveis (12 viravam 60) sem tabela nenhuma para manter à mão.
LOCAL_STR_RE = re.compile(r'^local\s+([A-Za-z_][A-Za-z0-9_]*)\s*=\s*"([^"]*)"\s*$',
                          re.MULTILINE)


def lua_locals():
    try:
        with open(HYPR_LUA, "r", encoding="utf-8") as f:
            return dict(LOCAL_STR_RE.findall(f.read()))
    except OSError:
        return {}


def inline_locals(action, locals_map):
    def sub(m):
        name = m.group(0)
        if name in locals_map:
            return '"%s"' % locals_map[name]
        return name
    # só identificadores soltos: nada precedido por ponto, dois-pontos ou aspas
    return re.sub(r'(?<![.:\w"])\b[A-Za-z_][A-Za-z0-9_]*\b', sub, action)
IDENT_RE = re.compile(r'\b([A-Za-z_][A-Za-z0-9_]*)\b')


def combo_from_lua(expr):
    """`mainMod .. " + Q"` e `"CTRL + slash"` viram "SUPER + Q" / "CTRL + slash"."""
    expr = expr.strip()
    if expr.startswith("mainMod"):
        m = re.search(r'"([^"]+)"', expr)
        return normalize("SUPER " + m.group(1)) if m else None
    m = re.match(r'^"([^"]+)"$', expr)
    return normalize(m.group(1)) if m else None


def action_is_portable(action):
    """A ação só pode ir para o user-binds.lua se não depender de locais de lá."""
    # Sem isso, o conteúdo das aspas ("kitty", "dolphin") era lido como nome de
    # variável e praticamente tudo era marcado como não customizável.
    action = re.sub(r'"[^"]*"', '""', action)
    for ident in IDENT_RE.findall(action):
        if ident in SAFE_IDENTS:
            continue
        # campos depois de ponto (hl.dsp.exec_cmd) e chaves de tabela não contam
        if re.search(r'[.:]\s*' + re.escape(ident), action):
            continue
        if re.search(r'\b' + re.escape(ident) + r'\s*=', action):
            continue
        if ident.isdigit():
            continue
        return False
    return True


def system_binds():
    try:
        with open(HYPR_LUA, "r", encoding="utf-8") as f:
            lines = f.read().split("\n")
    except OSError:
        return []
    locals_map = lua_locals()
    out = []
    seen = set()
    for raw in lines:
        line = raw.strip()
        if not line.startswith("hl.bind(") or line.startswith("--"):
            continue
        m = BIND_RE.match(line)
        if not m:
            continue
        combo = combo_from_lua(m.group("combo"))
        if not combo or combo in seen:
            continue
        seen.add(combo)
        action = inline_locals(m.group("action").strip(), locals_map)
        out.append({
            "combo": combo,
            "action": action,
            "customizable": action_is_portable(action),
        })
    return out


def load_overrides():
    _, body, _ = split_block(read_file())
    out = {}
    for line in body.split("\n"):
        m = re.match(r'^hl\.bind\("(?P<new>[^"]+)",\s*(?P<action>.+)\)\s*--\s*@override=(?P<old>.+)$',
                     line.strip())
        if m:
            out[m.group("old").strip()] = {
                "new": m.group("new"),
                "action": m.group("action").strip(),
            }
    return out


def scan_external():
    found = []
    seen = set()

    # user-binds.lua, só o que está FORA do bloco gerenciado
    before, _, after = split_block(read_file())
    sources = [(before + "\n" + after, "user")]
    try:
        with open(HYPR_LUA, "r", encoding="utf-8") as f:
            sources.append((f.read(), "system"))
    except OSError:
        pass

    for text, origin in sources:
        for line in text.split("\n"):
            stripped = line.strip()
            if stripped.startswith("--"):
                continue  # linha comentada (os exemplos do arquivo)
            m = SCAN_RE.search(stripped)
            if not m:
                continue
            command = expr_to_command(m.group("expr"))
            if not command:
                continue
            # Só o que abre programa: comandos internos do shell não contam.
            if command.startswith(("quickshell ", "hyprctl ", "rice-", "qs ")):
                continue
            combo = normalize(m.group("combo"))
            if combo in seen:
                continue
            seen.add(combo)
            found.append({
                "combo": combo,
                "command": command,
                "name": command_to_name(command),
                "source": origin,
            })
    return found


def load_binds():
    _, body, _ = split_block(read_file())
    out = []
    for line in body.split("\n"):
        m = LINE_RE.match(line.strip())
        if m:
            out.append({
                "combo": m.group("combo"),
                "command": m.group("cmd"),
                "name": m.group("name").strip() or m.group("cmd"),
            })
    return out


def save_binds(binds, overrides=None):
    before, _, after = split_block(read_file())
    if not before.strip() and not after.strip() and not os.path.isfile(USER_BINDS):
        before = ("-- ~/.config/hypr/user-binds.lua\n"
                  "-- Seus atalhos personalizados. Nunca é sobrescrito pelo rice-update.\n\n")

    lines = [HEADER]
    for b in binds:
        lines.append('hl.bind("%s", hl.dsp.exec_cmd("%s")) -- @app=%s'
                     % (b["combo"], b["command"], b["name"]))
    for old, ov in (overrides if overrides is not None else load_overrides()).items():
        lines.append('hl.unbind("%s")' % old)
        lines.append('hl.bind("%s", %s) -- @override=%s' % (ov["new"], ov["action"], old))
    lines.append(END)

    content = before.rstrip("\n") + "\n\n" + "\n".join(lines) + "\n" + after.lstrip("\n")
    os.makedirs(os.path.dirname(USER_BINDS), exist_ok=True)
    with open(USER_BINDS, "w", encoding="utf-8") as f:
        f.write(content)
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL)


def normalize(combo):
    parts = [p.strip() for p in str(combo).split("+") if p.strip()]
    return " + ".join(parts)


def conflict(combo):
    """Atalho já usado pelo rice? Avisar é melhor do que sobrescrever calado."""
    try:
        raw = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True,
                             text=True, timeout=5).stdout
        data = json.loads(raw)
    except Exception:
        return None
    mods = {"SUPER": 64, "ALT": 8, "CTRL": 4, "SHIFT": 1}
    parts = [p.strip().upper() for p in combo.split("+")]
    key = parts[-1] if parts else ""
    mask = sum(mods.get(p, 0) for p in parts[:-1])
    for b in data:
        if b.get("modmask") == mask and str(b.get("key", "")).lower() == key.lower():
            return combo
    return None


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "list"

    if cmd == "list":
        mine = load_binds()
        for b in mine:
            b["source"] = "managed"
        taken = {b["combo"] for b in mine}
        others = [b for b in scan_external() if b["combo"] not in taken]
        print(json.dumps({"binds": mine + others, "file": USER_BINDS},
                         ensure_ascii=False))
        return 0

    if cmd == "system-list":
        overrides = load_overrides()
        out = []
        for b in system_binds():
            ov = overrides.get(b["combo"])
            out.append({
                "combo": b["combo"],
                "current": ov["new"] if ov else b["combo"],
                "customizable": b["customizable"],
                "overridden": ov is not None,
            })
        print(json.dumps({"binds": out}, ensure_ascii=False))
        return 0

    if cmd == "override":
        if len(args) < 3:
            print("Uso: rice-app-binds override <combinação original> <nova>",
                  file=sys.stderr)
            return 2
        old = normalize(args[1])
        new = normalize(args[2])
        target = None
        for b in system_binds():
            if b["combo"] == old:
                target = b
                break
        if target is None:
            print(json.dumps({"status": "error", "message": "atalho não encontrado"}))
            return 1
        if not target["customizable"]:
            print(json.dumps({"status": "error", "message": "esse atalho não pode ser trocado daqui"}))
            return 1
        overrides = load_overrides()
        overrides[old] = {"new": new, "action": target["action"]}
        save_binds(load_binds(), overrides)
        print(json.dumps({"status": "ok", "old": old, "new": new}, ensure_ascii=False))
        return 0

    if cmd == "override-reset":
        if len(args) < 2:
            return 2
        old = normalize(args[1])
        overrides = load_overrides()
        overrides.pop(old, None)
        save_binds(load_binds(), overrides)
        print(json.dumps({"status": "ok"}, ensure_ascii=False))
        return 0

    if cmd == "record":
        timeout = "12"
        if "--timeout" in args:
            try:
                timeout = args[args.index("--timeout") + 1]
            except IndexError:
                pass
        r = subprocess.run(["rice-discord-binds", "record", "--timeout", timeout],
                           capture_output=True, text=True)
        out = (r.stdout or "").strip() or '{"status": "error"}'
        try:
            data = json.loads(out)
        except ValueError:
            data = {"status": "error"}
        if data.get("status") == "ok":
            data["conflict"] = conflict(normalize(data.get("key", "")))
        print(json.dumps(data, ensure_ascii=False))
        return 0

    if cmd == "add":
        if len(args) < 3:
            print("Uso: rice-app-binds add <combinação> <comando> [--name Nome]",
                  file=sys.stderr)
            return 2
        combo = normalize(args[1])
        command = args[2]
        name = command
        if "--name" in args:
            try:
                name = args[args.index("--name") + 1]
            except IndexError:
                pass
        if '"' in combo or '"' in command:
            print("aspas não são aceitas", file=sys.stderr)
            return 2
        binds = [b for b in load_binds() if b["combo"] != combo]
        binds.append({"combo": combo, "command": command, "name": name})
        save_binds(binds)
        print(json.dumps({"status": "ok", "combo": combo}, ensure_ascii=False))
        return 0

    if cmd == "remove":
        if len(args) < 2:
            return 2
        combo = normalize(args[1])
        binds = [b for b in load_binds() if b["combo"] != combo]
        save_binds(binds)
        print(json.dumps({"status": "ok"}, ensure_ascii=False))
        return 0

    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
