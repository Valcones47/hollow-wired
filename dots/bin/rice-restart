#!/usr/bin/env bash
# Botão de emergência: reinicia a interface (quickshell + waybar, se existir)
# sem precisar abrir terminal. Bind: Super+Ctrl+R.
pkill -x quickshell
pkill -x waybar
sleep 0.5
hyprctl dispatch 'hl.dsp.exec_cmd("quickshell")' >/dev/null
if [ -f "$HOME/.config/waybar/config.jsonc" ] && grep -qE "^[[:space:]]*hl.exec_cmd\(\"waybar\"\)" "$HOME/.config/hypr/hyprland.lua"; then
    hyprctl dispatch 'hl.dsp.exec_cmd("waybar")' >/dev/null
fi
notify-send -a "Rice" -t 2000 "Interface reiniciada"
