#!/usr/bin/env bash
# rice-record v2
# Backend avançado de gravação de tela para Hyprland / Quickshell
# Suporta: Tela Inteira, Janela/App, Região, Áudio Desktop, Microfone, Mixagem PipeWire.

set -e

# $XDG_VIDEOS_DIR nunca é exportado na sessão Hyprland — usa xdg-user-dir, que lê
# ~/.config/user-dirs.dirs direto e resolve certo em qualquer idioma/locale.
DIR="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Vídeos")/Gravações"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"

# Escolhe o encoder pela placa que DESENHA A TELA, não pela mais forte.
#
# O wf-recorder copia cada quadro do compositor. Se o encoder está em outra
# placa, cada quadro (60 por segundo, em 1080p) sai da placa da tela, passa
# pela memória do sistema e sobe para a outra — em notebook híbrido isso é a
# Intel mandando tudo para a NVIDIA. Medido aqui: com NVENC o wf-recorder
# ficava em 19% de CPU e 827 MB, e o Hyprland subia de 9% para 14% (o lag ao
# começar a gravar). Com VAAPI na própria Intel, sem cópia nenhuma: 3% e 95 MB,
# e o Hyprland nem se mexe.
#
# Monitor ligado na NVIDIA → h264_nvenc | na Intel/AMD → h264_vaapi no nó
# dela | nada disso → CPU (libx264).
display_render_node() {
    # Placa com um conector de monitor ligado.
    local st card
    for st in /sys/class/drm/card*-*/status; do
        [ "$(cat "$st" 2>/dev/null)" = "connected" ] || continue
        card="$(basename "$(dirname "$st")")"
        card="${card%%-*}"
        ls "/sys/class/drm/$card/device/drm/" 2>/dev/null | grep -m1 '^renderD' && return 0
    done
    return 1
}

detect_codec() {
    local encoders="" node vendor
    command -v ffmpeg >/dev/null 2>&1 && encoders="$(ffmpeg -hide_banner -encoders 2>/dev/null)"
    has() { [ -z "$encoders" ] || printf '%s' "$encoders" | grep -q "$1"; }

    node="$(display_render_node || true)"
    vendor="$( [ -n "$node" ] && cat "/sys/class/drm/$node/device/vendor" 2>/dev/null || true)"

    if [ "$vendor" = "0x10de" ] && has h264_nvenc; then
        echo "h264_nvenc"; return
    fi
    if [ -n "$node" ] && [ "$vendor" != "0x10de" ] && has h264_vaapi; then
        VAAPI_NODE="/dev/dri/$node"
        echo "h264_vaapi"; return
    fi
    # Sem como saber a placa da tela: o comportamento antigo.
    if { [ -e /dev/nvidiactl ] || [ -d /proc/driver/nvidia ]; } && has h264_nvenc; then
        echo "h264_nvenc"; return
    fi
    if ls /dev/dri/renderD* >/dev/null 2>&1 && has h264_vaapi; then
        echo "h264_vaapi"; return
    fi
    echo "libx264"
}
PIDFILE="$RUNTIME_DIR/rice-record.pid"
INFOFILE="$RUNTIME_DIR/rice-record.info"

mkdir -p "$DIR"

get_active_sink() {
    local s
    s=$(pactl list short sinks 2>/dev/null | awk '$4 == "RUNNING" && $2 !~ /CallApp/ {print $2}' | head -1)
    if [ -n "$s" ]; then echo "$s"; return; fi
    s=$(pactl list short sinks 2>/dev/null | awk '$2 ~ /alsa_output/ {print $2}' | head -1)
    if [ -n "$s" ]; then echo "$s"; return; fi
    s=$(pactl get-default-sink 2>/dev/null || true)
    if [ -n "$s" ] && [[ "$s" != *"CallApp"* ]]; then echo "$s"; return; fi
    pactl list short sinks 2>/dev/null | awk '{print $2}' | head -1
}

get_active_mic() {
    local m
    m=$(pactl list short sources 2>/dev/null | awk '$2 ~ /alsa_input/ {print $2}' | head -1)
    if [ -n "$m" ]; then echo "$m"; return; fi
    pactl get-default-source 2>/dev/null || echo "default"
}

cleanup_audio_modules() {
    if [ -f "$INFOFILE" ]; then
        local mod_sink mod_l1 mod_l2
        mod_sink=$(jq -r '.audio_mods.sink // empty' "$INFOFILE" 2>/dev/null || true)
        mod_l1=$(jq -r '.audio_mods.l1 // empty' "$INFOFILE" 2>/dev/null || true)
        mod_l2=$(jq -r '.audio_mods.l2 // empty' "$INFOFILE" 2>/dev/null || true)

        [ -n "$mod_l1" ] && pactl unload-module "$mod_l1" 2>/dev/null || true
        [ -n "$mod_l2" ] && pactl unload-module "$mod_l2" 2>/dev/null || true
        [ -n "$mod_sink" ] && pactl unload-module "$mod_sink" 2>/dev/null || true
    fi
}

do_stop() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill -INT "$pid" 2>/dev/null || true
            # Aguarda o ffmpeg/wf-recorder finalizar o arquivo mp4
            local i=0
            while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 60 ]; do
                sleep 0.1
                i=$((i + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -9 "$pid" 2>/dev/null || true
            fi
        fi
        rm -f "$PIDFILE"
    fi

    local rec_file=""
    if [ -f "$INFOFILE" ]; then
        rec_file=$(jq -r '.file // empty' "$INFOFILE" 2>/dev/null || true)
        cleanup_audio_modules
        rm -f "$INFOFILE"
    fi

    local last_file
    last_file=$(ls -t "$DIR"/*.mp4 2>/dev/null | head -1 || true)
    local display_file="${rec_file:-$last_file}"
    local filename
    filename=$(basename "${display_file:-gravacao.mp4}")

    notify-send -a "Gravação" -i media-record "Gravação concluída" "$filename salva em Vídeos/Gravações" 2>/dev/null || true
    echo "{\"status\": \"stopped\", \"file\": \"$display_file\"}"
    exit 0
}

do_status() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            local start_time file mode audio_desk audio_mic now elapsed size_human
            now=$(date +%s)
            start_time=$(jq -r '.start_time // 0' "$INFOFILE" 2>/dev/null || echo "$now")
            file=$(jq -r '.file // ""' "$INFOFILE" 2>/dev/null || echo "")
            mode=$(jq -r '.mode // "screen"' "$INFOFILE" 2>/dev/null || echo "screen")
            audio_desk=$(jq -r '.audio_desktop // false' "$INFOFILE" 2>/dev/null || echo "false")
            audio_mic=$(jq -r '.audio_mic // false' "$INFOFILE" 2>/dev/null || echo "false")
            elapsed=$((now - start_time))
            if [ "$elapsed" -lt 0 ]; then elapsed=0; fi

            size_human="0 B"
            if [ -f "$file" ]; then
                size_human=$(ls -lh "$file" 2>/dev/null | awk '{print $5}')
            fi

            cat <<EOF
{
  "recording": true,
  "pid": $pid,
  "start_time": $start_time,
  "elapsed": $elapsed,
  "file": "$file",
  "size": "$size_human",
  "mode": "$mode",
  "audio_desktop": $audio_desk,
  "audio_mic": $audio_mic
}
EOF
            return 0
        fi
    fi

    # Não está gravando
    rm -f "$PIDFILE" "$INFOFILE" 2>/dev/null || true
    cat <<EOF
{
  "recording": false,
  "pid": 0,
  "elapsed": 0,
  "file": "",
  "size": "0 B"
}
EOF
}

# list [N]: gravações mais recentes (padrão 20; "all" = todas), com duração,
# altura do vídeo e bytes para a aba Gravações do Hub.
do_list() {
    local limit="${1:-20}"
    [ "$limit" = "all" ] && limit=100000
    local files_json="[]"
    if compgen -G "$DIR/*.mp4" > /dev/null; then
        files_json=$(ls -t "$DIR"/*.mp4 2>/dev/null | head -n "$limit" | while read -r f; do
            local probe dur h
            probe=$(ffprobe -v error -select_streams v:0 -show_entries stream=height:format=duration \
                -of default=nw=1 "$f" 2>/dev/null)
            dur=$(printf '%s\n' "$probe" | sed -n 's/^duration=//p' | cut -d. -f1)
            h=$(printf '%s\n' "$probe" | sed -n 's/^height=//p')
            jq -n \
                --arg n "$(basename "$f")" \
                --arg p "$f" \
                --arg s "$(du -h "$f" 2>/dev/null | cut -f1)" \
                --argjson b "$(stat -c %s "$f" 2>/dev/null || echo 0)" \
                --arg d "$(date -r "$f" "+%d/%m %H:%M" 2>/dev/null || echo "")" \
                --argjson dur "${dur:-0}" \
                --argjson h "${h:-0}" \
                '{name: $n, path: $p, size: $s, bytes: $b, date: $d, duration: $dur, height: $h}'
        done | jq -s '.')
    fi
    echo "$files_json"
}

do_list_windows() {
    hyprctl clients -j 2>/dev/null | jq '[.[] | select(.mapped == true and .size[0] > 50 and .size[1] > 50) | {
        class: .class,
        title: (.title | if length > 40 then .[0:37] + "..." else . end),
        geom: "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])",
        workspace: .workspace.name
    }]' 2>/dev/null || echo "[]"
}

do_select_geom() {
    slurp 2>/dev/null || true
}

# Formato do geom que chega do painel/slurp: "X,Y WxH". O gpu-screen-recorder
# quer "WxH+X+Y".
geom_to_gsr() {
    local g="$1" xy wh
    xy="${g%% *}"; wh="${g##* }"
    echo "${wh}+${xy%%,*}+${xy##*,}"
}

start_gsr() {
    local mode="$1" geom="$2" audio_desktop="$3" audio_mic="$4" fps="${5:-60}" kbps="${6:-0}"
    # AAC em vez do Opus padrão: MP4 com Opus não abre em todo lugar (prévia
    # de mensageiros, alguns editores).
    local args=(-f "$fps" -cursor yes -k auto -ac aac)
    # Bitrate fixo (kbps) escolhido no Hub; 0 = qualidade constante (padrão do
    # gpu-screen-recorder, arquivo grande em cena com muito movimento).
    if [ "${kbps:-0}" -gt 0 ] 2>/dev/null; then
        args+=(-bm cbr -q "$kbps")
    fi

    if [ "$mode" = "region" ] || [ "$mode" = "window" ]; then
        if [ -z "$geom" ]; then
            geom=$(slurp) || exit 1
        fi
        args+=(-w region -region "$(geom_to_gsr "$geom")")
    else
        local mon
        mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' | head -1)
        args+=(-w "${mon:-screen}")
    fi

    # Áudio: o gpu-screen-recorder mistura sozinho com "a|b" — não precisa do
    # sink nulo + loopbacks que o caminho do wf-recorder monta.
    local active_sink active_mic audio=""
    active_sink=$(get_active_sink)
    active_mic=$(get_active_mic)
    if [ "$audio_desktop" = "1" ]; then
        audio="${active_sink:+${active_sink}.monitor}"
        [ -n "$audio" ] || audio="default_output"
    fi
    if [ "$audio_mic" = "1" ]; then
        audio="${audio:+$audio|}${active_mic:-default_input}"
    fi
    [ -n "$audio" ] && args+=(-a "$audio")

    local outfile
    outfile="$DIR/$(date +%Y-%m-%d_%H-%M-%S).mp4"
    args+=(-o "$outfile")

    gpu-screen-recorder "${args[@]}" >/dev/null 2>&1 &
    local rec_pid=$!
    echo "$rec_pid" > "$PIDFILE"

    jq -n --argjson t "$(date +%s)" --arg f "$outfile" --arg m "$mode" \
        --argjson d "$([ "$audio_desktop" = "1" ] && echo true || echo false)" \
        --argjson a "$([ "$audio_mic" = "1" ] && echo true || echo false)" \
        '{start_time: $t, file: $f, mode: $m, backend: "gpu-screen-recorder",
          audio_desktop: $d, audio_mic: $a, audio_mods: {sink: "", l1: "", l2: ""}}' > "$INFOFILE"

    notify-send -a "Gravação" -i media-record -t 2500 "Gravando tela…" "Modo: $mode | Clique em Parar no Hub ou use Super+Shift+R" 2>/dev/null || true
    printf '{"status": "started", "pid": %s, "file": "%s"}\n' "$rec_pid" "$outfile"
}

do_start() {
    # Se já estiver gravando, para
    if [ -f "$PIDFILE" ]; then
        local old_pid
        old_pid=$(cat "$PIDFILE" 2>/dev/null || true)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            do_stop
            return 0
        fi
    fi

    local mode="screen"
    local geom=""
    local audio_desktop="1"
    local audio_mic="0"
    local fps="60"
    local kbps="0"
    # "auto" resolve pro melhor encoder da máquina em detect_codec(). O padrão
    # antigo era h264_nvenc fixo: em PC sem NVIDIA (a maioria) o wf-recorder
    # abortava na hora e a gravação simplesmente não acontecia, sem erro visível.
    local codec="auto"

    while [ $# -gt 0 ]; do
        case "$1" in
            --mode) mode="$2"; shift 2 ;;
            --geom) geom="$2"; shift 2 ;;
            --audio-desktop) audio_desktop="$2"; shift 2 ;;
            --audio-mic) audio_mic="$2"; shift 2 ;;
            --fps) fps="$2"; shift 2 ;;
            --bitrate) kbps="$2"; shift 2 ;;
            --codec) codec="$2"; shift 2 ;;
            full) mode="screen"; shift ;;
            *) shift ;;
        esac
    done

    # gpu-screen-recorder quando existe: captura direto da placa que desenha a
    # tela (KMS) e codifica nela, sem copiar quadro pela memória — é o que
    # tirava o lag do wf-recorder. Medido aqui: ~5% de CPU a 60 fps em 1080p.
    # --codec explícito (h264_vaapi etc.) é opção do ffmpeg: fica no wf-recorder.
    if command -v gpu-screen-recorder >/dev/null 2>&1 && [ "$codec" = "auto" ] \
        && [ "${RICE_RECORDER:-}" != "wf-recorder" ]; then
        start_gsr "$mode" "$geom" "$audio_desktop" "$audio_mic" "$fps" "$kbps"
        return 0
    fi

    local wf_args=()

    # Codec de Vídeo: acelerado por hardware quando a máquina tem, CPU quando não.
    if [ "$codec" = "auto" ] || [ -z "$codec" ]; then
        codec="$(detect_codec)"
        # detect_codec roda num subshell; o nó da VAAPI é recalculado aqui.
        [ "$codec" = "h264_vaapi" ] && VAAPI_NODE="/dev/dri/$(display_render_node || true)"
        [ "$VAAPI_NODE" = "/dev/dri/" ] && VAAPI_NODE=""
    fi
    if [ -n "$codec" ]; then
        wf_args+=(-c "$codec")
        # VAAPI (Intel/AMD) precisa saber qual nó de render usar.
        if [ "$codec" = "h264_vaapi" ]; then
            local render_node="${VAAPI_NODE:-}"
            [ -n "$render_node" ] || render_node="$(ls /dev/dri/renderD* 2>/dev/null | head -1)"
            [ -n "$render_node" ] && wf_args+=(-d "$render_node")
        fi
    fi

    # Configuração de Geometria/Vídeo
    if [ "$mode" = "region" ]; then
        if [ -z "$geom" ]; then
            geom=$(slurp) || exit 1
        fi
        wf_args+=(-g "$geom")
    elif [ "$mode" = "window" ]; then
        if [ -z "$geom" ]; then
            geom=$(slurp) || exit 1
        fi
        wf_args+=(-g "$geom")
    else
        # Screen: padrão sem -g ou com display ativo
        :
    fi

    # Configuração de Taxa de Quadros
    if [ -n "$fps" ]; then
        wf_args+=(-r "$fps")
    fi

    # Configuração de Áudio
    local mod_sink="" mod_l1="" mod_l2=""
    local active_sink active_mic
    active_sink=$(get_active_sink)
    active_mic=$(get_active_mic)

    if [ "$audio_desktop" = "1" ] && [ "$audio_mic" = "1" ]; then
        # Mixagem estéreo via módulo nulo PipeWire
        local mix_name="rec_mix_$$"
        mod_sink=$(pactl load-module module-null-sink sink_name="$mix_name" sink_properties=device.description=RecordMix 2>/dev/null || true)
        if [ -n "$active_sink" ]; then
            mod_l1=$(pactl load-module module-loopback source="${active_sink}.monitor" sink="$mix_name" latency_msec=20 2>/dev/null || true)
        fi
        if [ -n "$active_mic" ]; then
            mod_l2=$(pactl load-module module-loopback source="$active_mic" sink="$mix_name" latency_msec=20 2>/dev/null || true)
        fi
        wf_args+=("--audio=${mix_name}.monitor")
    elif [ "$audio_desktop" = "1" ]; then
        if [ -n "$active_sink" ]; then
            wf_args+=("--audio=${active_sink}.monitor")
        fi
    elif [ "$audio_mic" = "1" ]; then
        if [ -n "$active_mic" ]; then
            wf_args+=("--audio=$active_mic")
        fi
    fi

    local timestamp
    timestamp=$(date +%Y-%m-%d_%H-%M-%S)
    local outfile="$DIR/${timestamp}.mp4"
    wf_args+=(-f "$outfile")

    # Bitrate escolhido no Hub (opção "b" do codificador do ffmpeg).
    if [ "${kbps:-0}" -gt 0 ] 2>/dev/null; then
        wf_args+=(-p "b=${kbps}k")
    fi

    # Inicia wf-recorder
    wf-recorder "${wf_args[@]}" >/dev/null 2>&1 &
    local rec_pid=$!
    echo "$rec_pid" > "$PIDFILE"

    local start_epoch
    start_epoch=$(date +%s)
    cat <<EOF > "$INFOFILE"
{
  "start_time": $start_epoch,
  "file": "$outfile",
  "mode": "$mode",
  "audio_desktop": $([ "$audio_desktop" = "1" ] && echo true || echo false),
  "audio_mic": $([ "$audio_mic" = "1" ] && echo true || echo false),
  "audio_mods": {
    "sink": "$mod_sink",
    "l1": "$mod_l1",
    "l2": "$mod_l2"
  }
}
EOF

    notify-send -a "Gravação" -i media-record -t 2500 "Gravando tela…" "Modo: $mode | Clique em Parar no Hub ou use Super+Shift+R" 2>/dev/null || true
    echo "{\"status\": \"started\", \"pid\": $rec_pid, \"file\": \"$outfile\"}"
}

# compress <arquivo> [MB]: reencoda para caber no tamanho pedido (padrão 25 MB).
# O bitrate sai da duração (tamanho alvo ÷ segundos, menos o áudio); quando ele
# fica baixo demais para a resolução, a imagem é reduzida (720p, 480p), porque
# bitrate pouco em 1080p vira borrão de blocos. O bitrate fixo antigo (5 Mbit/s)
# deixava um vídeo de 300 MiB em 64 MiB, grande demais para mandar.
do_compress() {
    local input="$1" target_mb="${2:-25}"
    if [ -z "$input" ] || [ ! -f "$input" ]; then
        echo '{"status": "error", "message": "Arquivo não encontrado"}'
        exit 1
    fi
    # "720p": só reduz a resolução, com qualidade constante (tamanho livre).
    if [ "$target_mb" = "720p" ]; then
        local out="${input%.mp4}_720p.mp4"
        notify-send -a "Gravação" -i media-record -t 3000 "Comprimindo vídeo…" "720p, mesma qualidade" 2>/dev/null || true
        if ffmpeg -y -v error -i "$input" -vf "scale=-2:'min(720,ih)'" -c:v libx264 -preset medium -crf 23 \
            -c:a aac -b:a 128k -pix_fmt yuv420p -movflags +faststart "$out"; then
            local sz; sz=$(du -h "$out" | cut -f1)
            notify-send -a "Gravação" -i media-record -t 4500 "Vídeo comprimido" "$(basename "$out") · $sz" 2>/dev/null || true
            echo "{\"status\": \"compressed\", \"file\": \"$out\", \"size\": \"$sz\"}"
            return 0
        fi
        echo '{"status": "error", "message": "Falha ao codificar vídeo"}'
        exit 1
    fi
    [[ "$target_mb" =~ ^[0-9]+$ ]] && [ "$target_mb" -ge 2 ] || target_mb=25

    local dur height
    dur=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$input" 2>/dev/null)
    height=$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$input" 2>/dev/null)
    dur=${dur%.*}; [ -n "$dur" ] && [ "$dur" -gt 0 ] 2>/dev/null || dur=1
    height=${height:-1080}

    local abr=96
    # 8192 kbit por MB, 5% de folga para o contêiner.
    local vbr=$(( target_mb * 8192 * 95 / 100 / dur - abr ))
    [ "$vbr" -gt 8000 ] && vbr=8000
    if [ "$vbr" -lt 150 ]; then
        echo "{\"status\": \"error\", \"message\": \"Vídeo longo demais para ${target_mb} MB\"}"
        notify-send -a "Gravação" -i dialog-error -t 4500 "Não dá para comprimir tanto" \
            "Com $((dur / 60)) min, ${target_mb} MB deixaria a imagem ilegível. Escolha um tamanho maior." 2>/dev/null || true
        exit 1
    fi

    local scale=""
    if [ "$vbr" -lt 900 ] && [ "$height" -gt 480 ]; then scale="scale=-2:480"
    elif [ "$vbr" -lt 2500 ] && [ "$height" -gt 720 ]; then scale="scale=-2:720"
    fi

    local dir base output
    dir="$(dirname "$input")"
    base="$(basename "$input" .mp4)"
    output="${dir}/${base}_${target_mb}MB.mp4"

    notify-send -a "Gravação" -i media-record -t 3000 "Comprimindo vídeo…" \
        "Alvo: ${target_mb} MB · ${vbr} kbit/s${scale:+ · ${scale##*:}p}" 2>/dev/null || true

    local -a vf=()
    [ -n "$scale" ] && vf=(-vf "$scale")
    local -a common=(-c:a aac -b:a "${abr}k" -pix_fmt yuv420p -movflags +faststart)
    local ok=0
    if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_nvenc && [ -e /dev/nvidiactl ]; then
        ffmpeg -y -v error -i "$input" "${vf[@]}" -c:v h264_nvenc -preset p5 -rc vbr \
            -b:v "${vbr}k" -maxrate "$(( vbr * 3 / 2 ))k" -bufsize "$(( vbr * 2 ))k" \
            "${common[@]}" "$output" && ok=1
    fi
    if [ "$ok" -eq 0 ]; then
        # CPU em duas passadas: acerta o tamanho bem melhor que uma só.
        local log="${XDG_RUNTIME_DIR:-/tmp}/rice-compress-$$"
        ffmpeg -y -v error -i "$input" "${vf[@]}" -c:v libx264 -preset medium -b:v "${vbr}k" \
            -pass 1 -passlogfile "$log" -an -f mp4 /dev/null \
        && ffmpeg -y -v error -i "$input" "${vf[@]}" -c:v libx264 -preset medium -b:v "${vbr}k" \
            -pass 2 -passlogfile "$log" "${common[@]}" "$output" && ok=1
        rm -f "$log"*
    fi

    if [ "$ok" -eq 1 ] && [ -f "$output" ]; then
        local size
        size=$(du -h "$output" | cut -f1)
        notify-send -a "Gravação" -i media-record -t 4500 "Vídeo comprimido" "$(basename "$output") · $size" 2>/dev/null || true
        echo "{\"status\": \"compressed\", \"file\": \"$output\", \"size\": \"$size\"}"
    else
        notify-send -a "Gravação" -i dialog-error -t 4500 "Erro na compressão" "Não foi possível comprimir o vídeo." 2>/dev/null || true
        echo '{"status": "error", "message": "Falha ao codificar vídeo"}'
        exit 1
    fi
}

# --- Roteamento de Subcomandos ---
cmd="${1:-toggle}"
case "$cmd" in
    start)
        shift
        do_start "$@"
        ;;
    stop)
        do_stop
        ;;
    status)
        do_status
        ;;
    list)
        shift
        do_list "$@"
        ;;
    list-windows)
        do_list_windows
        ;;
    select-geom)
        do_select_geom
        ;;
    open-folder)
        xdg-open "$DIR" >/dev/null 2>&1 &
        ;;
    play)
        shift
        if [ -n "$1" ] && [ -f "$1" ]; then
            xdg-open "$1" >/dev/null 2>&1 &
        fi
        ;;
    compress)
        shift
        do_compress "$@"
        ;;
    delete)
        shift
        # Vai para a lixeira (dá para recuperar); rm só se não houver gio.
        if [ -n "$1" ] && [ -f "$1" ]; then
            gio trash "$1" 2>/dev/null || rm -f "$1"
            echo "{\"status\": \"deleted\"}"
        fi
        ;;
    reveal)
        shift
        # Abre a pasta com o arquivo selecionado (Dolphin, Nautilus...).
        if [ -n "$1" ] && [ -f "$1" ]; then
            gdbus call --session --dest org.freedesktop.FileManager1 --object-path /org/freedesktop/FileManager1 \
                --method org.freedesktop.FileManager1.ShowItems "['file://$1']" "" >/dev/null 2>&1 \
                || xdg-open "$(dirname "$1")" >/dev/null 2>&1 &
        fi
        ;;
    copy)
        shift
        # Copia o arquivo (não o caminho): cola em chat, navegador, gerenciador de arquivos.
        if [ -n "$1" ] && [ -f "$1" ]; then
            printf 'file://%s\n' "$1" | wl-copy --type text/uri-list
            notify-send -a "Gravação" -i edit-copy -t 2500 "Vídeo copiado" "$(basename "$1")" 2>/dev/null || true
        fi
        ;;
    toggle)
        shift 2>/dev/null || true
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            do_stop
        else
            if [ $# -eq 0 ]; then
                do_start --mode screen
            else
                do_start "$@"
            fi
        fi
        ;;
    full)
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
            do_stop
        else
            do_start --mode screen
        fi
        ;;
    *)
        echo "Uso: rice-record {start|stop|status|list|list-windows|select-geom|open-folder|play <file>|compress <file> [MB|720p]|reveal <file>|copy <file>|delete <file>|toggle|full}"
        exit 1
        ;;
esac
