#!/usr/bin/env python3
"""rice-wallpaper-current: imprime o caminho da imagem que representa o
wallpaper ativo no desktop.

Resolvedor único usado por quem precisa da "cara" do wallpaper sem depender
de captura de tela: rice-wallust-refresh (paleta de cores), rice-sddm-sync-wallpaper
(fundo da tela de login) e rice-wallpaper-set (wallpaper estático).

Ordem de resolução:
  1. Wallpaper estático escolhido pelo usuário (~/.config/hypr/wallpaper.path,
     escrito pelo rice-wallpaper-set) — quem não tem Wallpaper Engine usa esse.
  2. Preview do wallpaper ativo do Waywallen (Wallpaper Engine via Flatpak).
  3. hyprpaper.conf (caso o usuário tenha configurado à mão).
  4. Primeira imagem numa pasta de wallpapers do usuário (XDG Pictures/Wallpapers).
  5. Wallpaper padrão que acompanha o rice.

Saída: caminho absoluto na stdout, código 0. Sem nada encontrado: código 1.
Opções: --kind imprime também a origem (ex.: "waywallen\t/caminho").
       --media imprime o arquivo de vídeo do wallpaper ativo (código 1 se não for vídeo).
"""
import os
import sqlite3
import sys
import subprocess

HOME = os.path.expanduser("~")
FLATPAK_ROOT = os.path.join(HOME, ".var/app/org.waywallen.waywallen")
WAYWALLEN_DB = os.path.join(FLATPAK_ROOT, "data/waywallen/waywallen-v2.db")
WAYWALLEN_CFG = os.path.join(FLATPAK_ROOT, "config/waywallen/config.toml")
STATIC_POINTER = os.path.join(HOME, ".config/hypr/wallpaper.path")
HYPRPAPER_CONF = os.path.join(HOME, ".config/hypr/hyprpaper.conf")

IMAGE_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif")


def xdg_dir(name, fallback):
    """Resolve uma pasta XDG pelo binário xdg-user-dir (respeita o idioma do sistema)."""
    try:
        out = subprocess.run(
            ["xdg-user-dir", name], capture_output=True, text=True, timeout=5
        ).stdout.strip()
        if out and os.path.isdir(out):
            return out
    except (OSError, subprocess.SubprocessError):
        pass
    return os.path.join(HOME, fallback)


def from_static_pointer():
    """Wallpaper estático definido pelo rice-wallpaper-set."""
    try:
        with open(STATIC_POINTER, "r", encoding="utf-8") as f:
            path = f.read().strip()
    except OSError:
        return None
    return path if path and os.path.isfile(path) else None


def waywallen_last_id():
    if not os.path.isfile(WAYWALLEN_CFG):
        return None
    try:
        import tomllib

        with open(WAYWALLEN_CFG, "rb") as f:
            data = tomllib.load(f)
    except Exception:
        return None
    last_id = data.get("global", {}).get("last_wallpaper")
    if last_id:
        return str(last_id)
    # Configs multi-monitor guardam o id por display em vez do global.
    for value in data.get("display", {}).values():
        if isinstance(value, dict) and value.get("last_wallpaper"):
            return str(value["last_wallpaper"])
    return None


def from_waywallen():
    last_id = waywallen_last_id()
    if not last_id or not os.path.isfile(WAYWALLEN_DB):
        return None
    try:
        conn = sqlite3.connect(f"file:{WAYWALLEN_DB}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        row = conn.execute(
            "SELECT item.preview_path, item.path, library.path AS lib_path "
            "FROM item JOIN library ON library.id = item.library_id "
            "WHERE item.id = ?",
            (last_id,),
        ).fetchone()
        conn.close()
    except sqlite3.Error:
        return None
    if not row:
        return None
    lib = (row["lib_path"] or "").rstrip("/")
    if row["preview_path"]:
        path = os.path.join(lib, row["preview_path"])
        if os.path.isfile(path):
            return path
    # Vídeo ou imagem de pasta comum do Waywallen (sem preview): a imagem é o
    # próprio arquivo; o vídeo vira um quadro extraído (rice-wallpaper-frame).
    media = os.path.join(lib, row["path"]) if row["path"] else ""
    if media and os.path.isfile(media):
        helper = os.path.expanduser("~/.local/bin/rice-wallpaper-frame")
        try:
            out = subprocess.run([helper, media], capture_output=True, text=True,
                                 timeout=25).stdout.strip()
            if out and os.path.isfile(out):
                return out
        except Exception:
            pass
    return None


def from_hyprpaper():
    try:
        with open(HYPRPAPER_CONF, "r", encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return None
    for line in lines:
        line = line.strip()
        if not line.startswith("wallpaper"):
            continue
        # formato: wallpaper = <monitor>,<caminho>   (o caminho pode vir com "contain:")
        _, _, value = line.partition("=")
        path = value.split(",", 1)[-1].strip().lstrip("~")
        for prefix in ("contain:", "cover:", "tile:"):
            if path.startswith(prefix):
                path = path[len(prefix):]
        path = os.path.expanduser(path if path.startswith("/") else "~" + path)
        if os.path.isfile(path):
            return path
    return None


def from_pictures():
    pictures = xdg_dir("PICTURES", "Pictures")
    for folder in (os.path.join(pictures, "Wallpapers"), os.path.join(pictures, "wallpapers"), pictures):
        if not os.path.isdir(folder):
            continue
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            if name.lower().endswith(IMAGE_EXTS):
                path = os.path.join(folder, name)
                if os.path.isfile(path):
                    return path
    return None


def from_shipped_default():
    candidates = [
        os.path.join(HOME, ".local/share/hollow-wired/wallpapers"),
        "/usr/share/hollow-wired/wallpapers",
    ]
    for folder in candidates:
        if not os.path.isdir(folder):
            continue
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            continue
        for name in names:
            if name.lower().endswith(IMAGE_EXTS):
                path = os.path.join(folder, name)
                if os.path.isfile(path):
                    return path
    return None


RESOLVERS = (
    ("estatico", from_static_pointer),
    ("waywallen", from_waywallen),
    ("hyprpaper", from_hyprpaper),
    ("pasta-wallpapers", from_pictures),
    ("padrao-do-rice", from_shipped_default),
)


def resolve():
    for kind, fn in RESOLVERS:
        try:
            path = fn()
        except Exception:
            path = None
        if path:
            return kind, path
    return None, None


VIDEO_EXTS = (".mp4", ".webm", ".mkv", ".mov", ".m4v")


def waywallen_video():
    """Arquivo de vídeo do wallpaper ativo do Waywallen, quando ele é um vídeo."""
    last_id = waywallen_last_id()
    if not last_id or not os.path.isfile(WAYWALLEN_DB):
        return None
    try:
        conn = sqlite3.connect(f"file:{WAYWALLEN_DB}?mode=ro", uri=True)
        row = conn.execute(
            "SELECT item.path, library.path FROM item JOIN library ON library.id = item.library_id "
            "WHERE item.id = ?", (last_id,)).fetchone()
        conn.close()
    except sqlite3.Error:
        return None
    if not row or not row[0]:
        return None
    media = os.path.join((row[1] or "").rstrip("/"), row[0])
    return media if media.lower().endswith(VIDEO_EXTS) and os.path.isfile(media) else None


def main():
    if "--media" in sys.argv[1:]:
        # Só o vídeo (a tela de bloqueio toca ele no fundo). Sem vídeo: código 1.
        if from_static_pointer():
            return 1
        video = waywallen_video()
        if not video:
            return 1
        print(video)
        return 0
    show_kind = "--kind" in sys.argv[1:]
    kind, path = resolve()
    if not path:
        print("nenhum wallpaper encontrado", file=sys.stderr)
        return 1
    print(f"{kind}\t{path}" if show_kind else path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
