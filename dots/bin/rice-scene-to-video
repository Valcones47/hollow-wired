#!/usr/bin/env python3
"""
rice-scene-to-video
Converte wallpapers Scene (.pkg) do Wallpaper Engine em papéis de parede
de Vídeo MP4 nativos 1080p 60 FPS com aceleração de hardware VA-API no Waywallen
(0% CPU, 0% GPU 3D).
"""

import os
import sys
import time
import json
import sqlite3
import struct
import subprocess
import signal
import shutil
from pathlib import Path

FLATPAK_ROOT = Path.home() / ".var/app/org.waywallen.waywallen"
DB_PATH = FLATPAK_ROOT / "data/waywallen/waywallen-v2.db"
WORKSHOP_DIR = Path.home() / ".local/share/Steam/steamapps/workshop/content/431960"

def get_all_items():
    if not DB_PATH.exists():
        print("Erro: Banco de dados do Waywallen não encontrado.")
        sys.exit(1)
    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    cur.execute("SELECT id, display_name, path, type FROM item ORDER BY id ASC")
    rows = cur.fetchall()
    con.close()
    return rows

def get_item_info(target):
    if not DB_PATH.exists():
        print("Erro: Banco de dados do Waywallen não encontrado.")
        sys.exit(1)

    con = sqlite3.connect(DB_PATH)
    cur = con.cursor()
    target_str = str(target)
    cur.execute("SELECT id, display_name, path, type FROM item WHERE path LIKE ? OR id = ? OR display_name LIKE ?", 
                (f"%{target_str}%", target_str, f"%{target_str}%"))
    row = cur.fetchone()
    con.close()
    return row

def extract_audio_from_pkg(pkg_path, out_wav):
    if not pkg_path.exists():
        return None
    try:
        with open(pkg_path, "rb") as f:
            magic_len = struct.unpack("<I", f.read(4))[0]
            magic = f.read(magic_len)
            file_count = struct.unpack("<I", f.read(4))[0]
            entries = []
            for _ in range(file_count):
                nl = struct.unpack("<I", f.read(4))[0]
                name = f.read(nl).decode("utf-8", errors="ignore")
                offset = struct.unpack("<I", f.read(4))[0]
                length = struct.unpack("<I", f.read(4))[0]
                entries.append((name, offset, length))
            data_start = f.tell()

            audio_entries = [e for e in entries if e[0].lower().endswith((".wav", ".mp3", ".ogg", ".flac"))]
            if not audio_entries:
                return None
            audio_entries.sort(key=lambda x: x[2], reverse=True)
            best_audio = audio_entries[0]
            f.seek(data_start + best_audio[1])
            audio_bytes = f.read(best_audio[2])
            with open(out_wav, "wb") as out:
                out.write(audio_bytes)
            print(f"  🎵 Trilha sonora extraída com sucesso: {best_audio[0]} ({len(audio_bytes)/1024/1024:.1f} MB)")
            return out_wav
    except Exception as e:
        print(f"  ⚠️  Não foi possível extrair áudio do .pkg: {e}")
        return None

def apply_by_dbus(item_id):
    cmd = [
        "gdbus", "call", "--session",
        "--dest", "org.waywallen.waywallen.Daemon",
        "--object-path", "/org/waywallen/waywallen/Daemon",
        "--method", "org.waywallen.waywallen.Daemon1.ApplyById",
        str(item_id)
    ]
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

def convert_wallpaper(item, duration=35, force=False):
    item_id, display_name, rel_path, item_type = item
    print(f"\n🎬 Iniciando conversão para Vídeo MP4:")
    print(f"  • Wallpaper: {display_name} (ID: {item_id})")
    print(f"  • Caminho original: {rel_path}")
    print(f"  • Duração da captura: {duration} segundos")

    # Descobre pasta absoluta
    folder_path = None
    for part in Path(rel_path).parts:
        if part.isdigit() and len(part) >= 8:
            folder_path = WORKSHOP_DIR / part
            break
    if not folder_path or not folder_path.exists():
        folder_path = (Path.home() / ".local/share" / rel_path).parent

    pkg_path = folder_path / "scene.pkg"

    final_video = folder_path / "video.mp4"
    need_record = True
    if final_video.exists() and final_video.stat().st_size > 1000000 and not force:
        print(f"  ✓ Vídeo 1080p já existente ({final_video.stat().st_size / (1024*1024):.1f} MB). Pulando etapa de gravação...")
        need_record = False

    raw_audio_path = Path("/tmp/scene_audio_extracted.tmp")
    raw_video = Path("/tmp/scene_capture_raw.mp4")

    if need_record:
        if not pkg_path.exists():
            print(f"  ❌ Erro: scene.pkg não encontrado em {folder_path} para realizar a gravação.")
            return False

        # 1. Extrai áudio se existir
        extracted_audio = extract_audio_from_pkg(pkg_path, raw_audio_path)

        # 2. Aplica o wallpaper como cena para que renderize na tela
        print("  📺 Carregando cena no compositor para captura...")
        apply_by_dbus(item_id)
        time.sleep(3.5) # Aguarda inicialização dos shaders e partículas

        # 3. Prepara tela limpa
        try:
            active_ws_res = subprocess.run(["hyprctl", "activeworkspace", "-j"], capture_output=True, text=True)
            active_ws = json.loads(active_ws_res.stdout).get("id", 1)
        except Exception:
            active_ws = 1

        print("  🧹 Ocultando interfaces e isolando tela em 1080p...")
        subprocess.run(["qs", "ipc", "call", "bar", "setBarVisible", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["qs", "ipc", "call", "frame", "setVisible", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["hyprctl", "dispatch", "hl.dsp.focus({ workspace = 99 })"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.8)

        if raw_video.exists():
            raw_video.unlink()

        # 4. Grava a tela via wf-recorder a 60 FPS 1080p
        print(f"  🔴 Gravando loop da cena ({duration}s a 60 FPS 1080p)...")
        rec_cmd = [
            "wf-recorder", "-o", "eDP-1", "-r", "60",
            "-c", "libx264", "-p", "preset=veryfast", "-p", "crf=16",
            "-f", str(raw_video)
        ]
        rec_proc = subprocess.Popen(rec_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        time.sleep(duration)
        rec_proc.send_signal(signal.SIGINT)
        try:
            rec_proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            rec_proc.kill()

        # 5. Restaura a interface do usuário
        subprocess.run(["hyprctl", "dispatch", f"hl.dsp.focus({{ workspace = {active_ws} }})"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["qs", "ipc", "call", "frame", "setVisible", "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["qs", "ipc", "call", "bar", "setBarVisible", "true"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        if not raw_video.exists() or raw_video.stat().st_size < 100000:
            print("  ❌ Erro: Falha na gravação do vídeo da cena.")
            return False

        print("  ✨ Pós-processando e multiplexando vídeo e áudio...")
        tmp_final = folder_path / "tmp_final.mp4"

        if extracted_audio and extracted_audio.exists():
            # Multiplexa com áudio em loop correspondente
            ff_cmd = [
                "ffmpeg", "-y", "-i", str(raw_video),
                "-stream_loop", "-1", "-i", str(extracted_audio),
                "-c:v", "copy", "-c:a", "aac", "-b:a", "256k",
                "-t", str(duration),
                str(tmp_final)
            ]
        else:
            ff_cmd = [
                "ffmpeg", "-y", "-i", str(raw_video),
                "-c:v", "copy",
                str(tmp_final)
            ]

        subprocess.run(ff_cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        tmp_final.replace(final_video)

    # 6. Atualiza project.json mantendo backup
    pj = folder_path / "project.json"
    if pj.exists():
        pj_bak = folder_path / "project.json.original"
        if not pj_bak.exists():
            shutil.copy2(pj, pj_bak)
        try:
            pj_data = json.loads(pj.read_text())
            pj_data["type"] = "video"
            pj_data["file"] = "video.mp4"
            pj.write_text(json.dumps(pj_data, indent=2))
            print("  ✓ project.json atualizado para 'type': 'video'")
        except Exception as e:
            print(f"  ⚠️  Erro ao atualizar project.json: {e}")

    # 7. Atualiza banco de dados do Waywallen
    con = sqlite3.connect(DB_PATH)
    new_rel_path = rel_path.replace("scene.pkg", "video.mp4")
    if not new_rel_path.endswith(".mp4"):
        new_rel_path = str(Path(new_rel_path).parent / "video.mp4")
    con.execute("UPDATE item SET type = 'video', path = ? WHERE id = ?", (new_rel_path, item_id))
    con.commit()
    con.close()
    print("  ✓ Banco de dados do Waywallen atualizado para tipo vídeo")

    # 8. Re-aplica como vídeo com VA-API
    print("  ⚡ Reaplicando wallpaper com aceleração de hardware (VA-API)...")
    apply_by_dbus(item_id)
    time.sleep(1.0)

    # Limpeza
    if raw_video.exists(): raw_video.unlink()
    if raw_audio_path.exists(): raw_audio_path.unlink()

    print(f"\n🎉 CONVERSÃO CONCLUÍDA COM SUCESSO!")
    print(f"  • Wallpaper: '{display_name}'")
    print(f"  • Formato: Vídeo MP4 1080p 60 FPS nativo.")
    print(f"  • Decodificação: Intel VA-API por Hardware (0% CPU, 0% GPU 3D).")
    return True

def list_wallpapers():
    items = get_all_items()
    print("\n📦 Catálogo de Wallpapers do Waywallen:")
    print(f"{'ID':<4} | {'Tipo':<6} | {'Status Hardware':<22} | {'Nome'}")
    print("-" * 75)
    for it in items:
        iid, name, path, itype = it
        status = "VA-API Hardware (0%)" if itype == "video" else "Scene 3D (Carga GPU)"
        print(f"{iid:<4} | {itype:<6} | {status:<22} | {name}")
    print("\n💡 Para converter uma cena para vídeo MP4 1080p 60 FPS:")
    print("   rice-scene-to-video <ID_OU_NOME> [duracao_segundos]")
    print("   Exemplo: rice-scene-to-video 2633833141 35\n")

def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Uso: rice-scene-to-video <ID|NOME|--list|--all> [duracao_segundos] [--force]")
        print("\nComandos:")
        print("  --list, -l           Lista todos os wallpapers e seus formatos atuais")
        print("  --all [segundos]     Converte todas as cenas 3D pendentes em sequência")
        print("  <ID> [segundos]      Converte uma cena específica (padrão: 35 segundos)")
        print("  --force              Força regravação mesmo se video.mp4 já existir")
        print("\nExemplo:")
        print("  rice-scene-to-video --list")
        print("  rice-scene-to-video 2633833141 35")
        sys.exit(0)

    if sys.argv[1] in ("--list", "-l"):
        list_wallpapers()
        sys.exit(0)

    force = "--force" in sys.argv
    clean_args = [a for a in sys.argv[1:] if a != "--force"]

    duration = 35
    if len(clean_args) >= 2 and clean_args[1].isdigit():
        duration = int(clean_args[1])

    if clean_args[0] == "--all":
        items = [it for it in get_all_items() if it[3] == "scene"]
        if not items:
            print("Todos os wallpapers já estão convertidos para vídeo!")
            sys.exit(0)
        print(f"Encontradas {len(items)} cenas para converter.")
        for it in items:
            convert_wallpaper(it, duration=duration, force=force)
        sys.exit(0)

    target_query = clean_args[0]
    item = get_item_info(target_query)
    if not item:
        print(f"Erro: Wallpaper '{target_query}' não encontrado no catálogo do Waywallen.")
        sys.exit(1)

    convert_wallpaper(item, duration=duration, force=force)

if __name__ == "__main__":
    main()
