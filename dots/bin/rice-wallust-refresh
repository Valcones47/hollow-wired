#!/usr/bin/env bash
# rice-wallust-refresh: Regenera as cores do Wallust a partir do wallpaper atual do Waywallen.

set -euo pipefail

# Toggle "as cores seguem o wallpaper" (painel > Cores & Wallust). Desligado,
# trocar de papel de parede não mexe mais na paleta — quem escolheu as cores à
# mão não perde tudo ao trocar o wallpaper. O botão "Regenerar Cores" do painel
# passa --force e continua funcionando mesmo com o toggle desligado.
FORCE="false"
[ "${1:-}" = "--force" ] && FORCE="true"

if [ "$FORCE" != "true" ] && command -v rice-colors >/dev/null 2>&1; then
    if [ "$(rice-colors auto 2>/dev/null || echo 1)" = "0" ]; then
        echo "[·] Cores travadas pelo usuário — wallpaper trocado sem mexer na paleta."
        exit 0
    fi
fi

preview=$(python3 -c '
import sqlite3, os, tomllib

cfg_file = os.path.expanduser("~/.var/app/org.waywallen.waywallen/config/waywallen/config.toml")
db_file = os.path.expanduser("~/.var/app/org.waywallen.waywallen/data/waywallen/waywallen-v2.db")

last_id = None
if os.path.isfile(cfg_file):
    try:
        with open(cfg_file, "rb") as f:
            data = tomllib.load(f)
            last_id = data.get("global", {}).get("last_wallpaper")
            if not last_id:
                for k, v in data.get("display", {}).items():
                    if isinstance(v, dict) and v.get("last_wallpaper"):
                        last_id = v["last_wallpaper"]
                        break
    except Exception:
        pass

preview_path = None
if last_id and os.path.isfile(db_file):
    try:
        conn = sqlite3.connect(f"file:{db_file}?mode=ro", uri=True)
        conn.row_factory = sqlite3.Row
        r = conn.execute(
            "SELECT item.preview_path, item.path, library.path AS lib_path FROM item JOIN library ON library.id = item.library_id WHERE item.id = ?",
            (str(last_id),)
        ).fetchone()
        if r and r["preview_path"]:
            p = os.path.join(r["lib_path"].rstrip("/"), r["preview_path"])
            if os.path.isfile(p):
                preview_path = p
        # Vídeo/imagem de pasta comum do Waywallen: sem preview; usa o arquivo
        # (imagem) ou um quadro extraído dele (vídeo).
        if not preview_path and r and r["path"]:
            import subprocess
            media = os.path.join(r["lib_path"].rstrip("/"), r["path"])
            if os.path.isfile(media):
                out = subprocess.run([os.path.expanduser("~/.local/bin/rice-wallpaper-frame"), media],
                                     capture_output=True, text=True, timeout=25).stdout.strip()
                if out and os.path.isfile(out):
                    preview_path = out
    except Exception:
        pass

if not preview_path:
    fallbacks = [
        os.path.expanduser("~/.config/quickshell/wallpaper.png"),
        os.path.expanduser("~/Imagens/Wallpapers/wallpaper.png"),
        os.path.expanduser("~/Imagens/Wallpapers/current.png"),
        "/usr/share/sddm/themes/SilentSDDM/backgrounds/current.png"
    ]
    for fb in fallbacks:
        if os.path.isfile(fb):
            preview_path = fb
            break

if preview_path:
    print(preview_path)
' 2>/dev/null || true)

if ! command -v wallust >/dev/null 2>&1; then
    echo "[-] wallust não encontrado. Instale com: yay -S wallust-git"
    notify-send -a "Wallust" -u normal -i dialog-warning -r 91199 -t 4000 "Wallust não encontrado" "Instale com: yay -S wallust-git para cores dinâmicas do wallpaper"
    exit 1
fi

# O preview do Wallpaper Engine é um thumbnail quadrado (140x140 a 1024x1024):
# como fonte de paleta ele representa mal o wallpaper. Quando o item é vídeo,
# usa um quadro na resolução real.
if [ -n "$preview" ] && [ -f "$preview" ] && command -v rice-wallpaper-frame >/dev/null 2>&1; then
    better=$(rice-wallpaper-frame "$(dirname "$preview")" "$preview" 2>/dev/null)
    [ -n "$better" ] && [ -f "$better" ] && preview="$better"
fi

if [ -n "$preview" ] && [ -f "$preview" ]; then
    # Ajustes avançados do painel (rice-wallust-config): o toml do rice mais as
    # escolhas do usuário, numa cópia no cache — o wallust.toml em si é
    # substituído a cada rice-update e não guarda escolha nenhuma.
    if command -v rice-wallust-config >/dev/null 2>&1; then
        rice-wallust-config run "$preview" || true
    else
        wallust run "$preview" >/dev/null 2>&1
    fi
    # A paleta recém-extraída vira a "base". Em seguida o rice-colors regrava os
    # mesmos arquivos aplicando as cores que o usuário trocou à mão no painel —
    # sem isso, cada troca de wallpaper apagaria as escolhas dele.
    if command -v rice-colors >/dev/null 2>&1; then
        rice-colors snapshot >/dev/null 2>&1 || true
        rice-colors apply >/dev/null 2>&1 || true
    fi
    notify-send -a "Wallust" -i preferences-desktop-color -r 91199 -t 2500 "Paleta de Cores Atualizada" "Cores sincronizadas com o wallpaper ativo"
    echo "[✓] Wallust atualizado com: $preview"
else
    echo "[-] Wallpaper atual não encontrado"
    exit 1
fi
