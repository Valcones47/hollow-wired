#!/usr/bin/env bash
# ==============================================================================
# rice-update
# Atualizador inteligente de Dotfiles e Utilitários do Rice (Hyprland + Quickshell)
# ==============================================================================
set -euo pipefail

REPO_FILE="$HOME/.config/hollow-wired-repo"
DEFAULT_REPO="$HOME/projetos/hyprland-setup"

# Determina o diretório do repositório git clonado
if [ -f "$REPO_FILE" ] && [ -d "$(cat "$REPO_FILE")" ]; then
    REPO_DIR="$(cat "$REPO_FILE")"
elif [ -f "$HOME/.config/hyprland-setup-repo" ] && [ -d "$(cat "$HOME/.config/hyprland-setup-repo")" ]; then
    REPO_DIR="$(cat "$HOME/.config/hyprland-setup-repo")"
# Onde o instalador por curl clona (ver install.sh). Vem antes dos caminhos
# antigos: numa instalação migrada, o ponteiro acima pode apontar para a pasta
# que foi movida para cá.
elif [ -d "${XDG_DATA_HOME:-$HOME/.local/share}/hollow-wired/.git" ]; then
    REPO_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hollow-wired"
elif [ -d "$DEFAULT_REPO/.git" ]; then
    REPO_DIR="$DEFAULT_REPO"
elif [ -d "$HOME/projetos/hollow-wired/.git" ]; then
    REPO_DIR="$HOME/projetos/hollow-wired"
elif [ -d "$HOME/.hollow-wired/.git" ]; then
    REPO_DIR="$HOME/.hollow-wired"
elif [ -d "$HOME/.hyprland-setup/.git" ]; then
    REPO_DIR="$HOME/.hyprland-setup"
else
    REPO_DIR=""
fi

check_updates() {
    if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
        echo '{"status": "error", "message": "Repositório git local não encontrado", "count": 0}'
        return 0
    fi

    # Atualiza refs remotas silenciosamente
    git -C "$REPO_DIR" fetch --quiet origin main 2>/dev/null || {
        echo '{"status": "fetch_failed", "message": "Sem conexão ou falha no git fetch", "count": 0}'
        return 0
    }

    LOCAL_HASH=$(git -C "$REPO_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
    REMOTE_HASH=$(git -C "$REPO_DIR" rev-parse --short origin/main 2>/dev/null || echo "unknown")

    # Data do commit instalado: o painel mostra "versão X · de DD/MM" pra pessoa
    # saber de quando é a instalação dela, não só um hash solto.
    LOCAL_DATE=$(git -C "$REPO_DIR" log -1 --format=%cd --date=format:'%d/%m/%Y' 2>/dev/null || echo "")

    if installed_is_newer origin/main; then
        jq -n --arg hash "$LOCAL_HASH" --arg local_date "$LOCAL_DATE" \
              '{status: "up_to_date", count: 0, hash: $hash, local: $hash, local_date: $local_date, commits: [],
                message: "A versão instalada é mais nova que a do GitHub"}'
    elif [ "$LOCAL_HASH" != "$REMOTE_HASH" ]; then
        COUNT=$(git -C "$REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
        COMMITS=$(git -C "$REPO_DIR" log --format=%s -n 5 HEAD..origin/main 2>/dev/null | jq -R . | jq -s . 2>/dev/null || echo "[]")
        REMOTE_DATE=$(git -C "$REPO_DIR" log -1 --format=%cd --date=format:'%d/%m/%Y' origin/main 2>/dev/null || echo "")
        jq -n --argjson count "${COUNT:-0}" --arg local "$LOCAL_HASH" --arg remote "$REMOTE_HASH" \
              --arg local_date "$LOCAL_DATE" --arg remote_date "$REMOTE_DATE" --argjson commits "$COMMITS" \
              '{status: "update_available", count: $count, local: $local, remote: $remote,
                local_date: $local_date, remote_date: $remote_date, hash: $local, commits: $commits}'
    else
        jq -n --arg hash "$LOCAL_HASH" --arg local_date "$LOCAL_DATE" \
              '{status: "up_to_date", count: 0, hash: $hash, local: $hash, local_date: $local_date, commits: []}'
    fi
}

# Marcador da última sincronização que chegou ao fim. Se o HEAD do repositório
# mudou mas este arquivo não, a atualização anterior morreu no meio (foi o que
# aconteceu com o ETXTBSY do waywallen-layer-shell): o git já estava atualizado,
# então o `rice-update` seguinte dizia "já está na versão mais recente" e nunca
# terminava o serviço. Agora ele percebe e refaz a sincronização sozinho.
SYNC_MARKER="$HOME/.config/hollow-wired/last-sync"

needs_resync() {
    [ -n "$REPO_DIR" ] || return 1
    local head marked
    head=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null || echo "")
    marked=$(cat "$SYNC_MARKER" 2>/dev/null || echo "")
    [ -n "$head" ] && [ "$head" != "$marked" ]
}

# Versão instalada mais nova que a do repositório? Acontece quando o que está
# em ~/.config veio de outro clone (o de desenvolvimento, com commits ainda não
# enviados ao GitHub) e o repositório configurado ficou para trás. Sem esta
# checagem o "Atualizar o rice" copiava a versão velha por cima de tudo — foi
# o que trouxe de volta o seletor de wallpaper antigo, duplicou a barra e
# religou o blur. Retorna 0 quando instalar o HEAD do repositório seria voltar.
installed_is_newer() {
    local ref="${1:-HEAD}" marked
    marked=$(cat "$SYNC_MARKER" 2>/dev/null || echo "")
    [ -n "$marked" ] || return 1
    # Commit instalado desconhecido aqui: veio de um clone mais novo.
    git -C "$REPO_DIR" cat-file -e "${marked}^{commit}" 2>/dev/null || return 0
    # Conhecido, mas o alvo não o contém: seria voltar no tempo.
    git -C "$REPO_DIR" merge-base --is-ancestor "$marked" "$ref" 2>/dev/null && return 1
    return 0
}

mark_synced() {
    mkdir -p "$(dirname "$SYNC_MARKER")"
    git -C "$REPO_DIR" rev-parse HEAD > "$SYNC_MARKER" 2>/dev/null || true
}

# Pacotes novos: o packages.txt do repositório é a lista do instalador. Quem
# instalou o rice antes de um pacote entrar nela nunca o recebia (a luz
# noturna, por exemplo, depende do hyprsunset). Na atualização pela janela do
# terminal, instala o que falta pedindo a senha; no modo silencioso só avisa.
install_new_packages() {
    local interactive="$1" list="$REPO_DIR/packages.txt" line pkg
    [ -f "$list" ] || return 0
    command -v pacman >/dev/null 2>&1 || return 0
    local missing=() repo=() aur=()
    while IFS= read -r line || [ -n "$line" ]; do
        pkg="${line%%#*}"
        pkg="${pkg//[[:space:]]/}"
        [ -n "$pkg" ] || continue
        if [ "$pkg" = "wallust-git" ] && command -v wallust >/dev/null 2>&1; then continue; fi
        pacman -T "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
    done < "$list"
    [ ${#missing[@]} -eq 0 ] && return 0

    for pkg in "${missing[@]}"; do
        if pacman -Si "$pkg" >/dev/null 2>&1; then repo+=("$pkg"); else aur+=("$pkg"); fi
    done
    echo -e "\n\e[1;36m[*] Programas novos que o rice passou a usar:\e[0m ${missing[*]}"
    if [ "$interactive" != "true" ]; then
        notify-send -a "Rice Updater" -i system-software-update \
            "Faltam ${#missing[@]} programa(s) do rice" "Abra Atualizar o rice na barra lateral para instalar." 2>/dev/null || true
        return 0
    fi
    read -r -p "Instalar agora? (pede a sua senha) [S/n]: " ans || ans=n
    [[ "${ans:-s}" =~ ^[SsYy]$ ]] || return 0
    if [ ${#repo[@]} -gt 0 ]; then
        # Um conflito derruba a transação inteira; aí tenta um por vez.
        sudo pacman -S --needed --noconfirm "${repo[@]}" || for pkg in "${repo[@]}"; do
            sudo pacman -S --needed --noconfirm "$pkg" >/dev/null 2>&1 || echo "  não instalado: $pkg"
        done
    fi
    if [ ${#aur[@]} -gt 0 ]; then
        local helper=""
        command -v yay >/dev/null 2>&1 && helper=yay
        [ -z "$helper" ] && command -v paru >/dev/null 2>&1 && helper=paru
        if [ -n "$helper" ]; then
            "$helper" -S --needed --noconfirm "${aur[@]}" || true
        else
            echo "  Sem yay/paru para instalar do AUR: ${aur[*]}"
        fi
    fi
    # Serviços que chegam junto e precisam ser ligados.
    for svc in NetworkManager bluetooth power-profiles-daemon; do
        systemctl list-unit-files "$svc.service" 2>/dev/null | grep -q "^$svc.service" || continue
        systemctl is-enabled --quiet "$svc.service" 2>/dev/null || sudo systemctl enable --now "$svc.service" >/dev/null 2>&1 || true
    done
}

apply_updates() {
    local interactive="${1:-true}"
    local force="${2:-false}"

    if [ -z "$REPO_DIR" ] || [ ! -d "$REPO_DIR/.git" ]; then
        echo -e "\e[1;31m[!] Erro: Diretório do repositório não encontrado.\e[0m" >&2
        exit 1
    fi

    echo -e "\e[1;36m====================================================\e[0m"
    echo -e "\e[1;32m   Atualizador de Dotfiles (Hyprland & Quickshell)  \e[0m"
    echo -e "\e[1;36m====================================================\e[0m"
    echo ""
    echo -e "Diretório local: \e[1;34m$REPO_DIR\e[0m"

    # Busca novidades
    echo -e "Verificando novidades no GitHub..."
    git -C "$REPO_DIR" fetch --quiet origin main

    LOCAL_HASH=$(git -C "$REPO_DIR" rev-parse --short HEAD)
    REMOTE_HASH=$(git -C "$REPO_DIR" rev-parse --short origin/main)
    COUNT=$(git -C "$REPO_DIR" rev-list --count HEAD..origin/main 2>/dev/null || echo 0)

    if [ "$COUNT" -eq 0 ] && [ "$force" != "true" ] && ! needs_resync; then
        echo -e "\n\e[1;32m[✓] O seu rice já está na versão mais recente!\e[0m (Commit: $LOCAL_HASH)"
        run_health_checks
        if [ "$interactive" = "true" ]; then
            echo ""
            read -r -p "Pressione ENTER para fechar..." _ || true
        fi
        return 0
    fi

    if [ "$COUNT" -eq 0 ]; then
        echo -e "\n\e[1;33m[!] O código já está atualizado, mas a última sincronização"
        echo -e "    não chegou ao fim. Vou refazer a cópia dos arquivos agora.\e[0m"
    else
        echo -e "\n\e[1;33m[!] Existem $COUNT nova(s) atualização(ões) disponíveis:\e[0m"
        git -C "$REPO_DIR" log --oneline --color=always -n 8 HEAD..origin/main
    fi
    echo ""

    if [ "$interactive" = "true" ]; then
        read -r -p "Deseja aplicar as atualizações e sincronizar agora? [S/n]: " CONFIRM || true
        CONFIRM=${CONFIRM:-S}
        if [[ ! "$CONFIRM" =~ ^[Ss]$ ]]; then
            echo -e "\e[1;33mAtualização cancelada pelo usuário.\e[0m"
            return 0
        fi
    fi

    # 1. Backup de segurança
    BACKUP_DIR="$HOME/.config/rice-backup-$(date +%Y%m%d_%H%M%S)"
    echo -e "\n\e[1;34m[*] Criando backup de segurança em: $BACKUP_DIR\e[0m"
    mkdir -p "$BACKUP_DIR"
    for d in hypr quickshell kitty wallust xdg-desktop-portal fastfetch; do
        if [ -d "$HOME/.config/$d" ]; then
            cp -a "$HOME/.config/$d" "$BACKUP_DIR/" 2>/dev/null || true
        fi
    done

    # 2. Puxar alterações do git
    echo -e "\e[1;34m[*] Puxando alterações do GitHub...\e[0m"
    git -C "$REPO_DIR" pull --ff-only origin main 2>/dev/null || {
        # `reset --hard` só num clone limpo e sem commits próprios. Num
        # repositório de desenvolvimento ele apagaria o trabalho não enviado.
        local dirty ahead
        dirty=$(git -C "$REPO_DIR" status --porcelain 2>/dev/null | head -1)
        ahead=$(git -C "$REPO_DIR" rev-list --count origin/main..HEAD 2>/dev/null || echo 1)
        if [ -z "$dirty" ] && [ "$ahead" = "0" ]; then
            echo -e "\e[1;33m[*] Sincronizando com a árvore remota limpa...\e[0m"
            git -C "$REPO_DIR" reset --hard origin/main
        else
            echo -e "\e[1;31m[!] $REPO_DIR tem mudanças locais ou commits não enviados;"
            echo -e "    não vou descartá-los. Atualização cancelada.\e[0m" >&2
            notify-send -a "Rice Updater" -u critical -t 6000 "Atualização cancelada" \
                "O repositório tem mudanças locais que não foram enviadas ao GitHub." 2>/dev/null || true
            return 1
        fi
    }

    if installed_is_newer HEAD && [ "${HOLLOW_ALLOW_DOWNGRADE:-0}" != "1" ]; then
        echo -e "\e[1;31m[!] A versão instalada é mais nova que a de $REPO_DIR."
        echo -e "    Copiar agora voltaria o rice para uma versão antiga. Nada foi alterado."
        echo -e "    (Para forçar mesmo assim: HOLLOW_ALLOW_DOWNGRADE=1 rice-update)\e[0m" >&2
        notify-send -a "Rice Updater" -t 6000 "Nada para atualizar" \
            "A versão instalada já é mais nova que a do repositório." 2>/dev/null || true
        rm -rf "$BACKUP_DIR"
        return 0
    fi

    # 3. Sincronizar dotfiles com proteção total das preferências do usuário
    echo -e "\e[1;34m[*] Sincronizando arquivos de configuração e scripts...\e[0m"

    # Salva em memória as configurações e preferências pessoais do usuário
    local saved_dock="" saved_widgets="" saved_shell="" saved_locale="" saved_kitty="" saved_user_binds=""
    [ -f "$HOME/.config/quickshell/dock.json" ] && saved_dock=$(cat "$HOME/.config/quickshell/dock.json")
    [ -f "$HOME/.config/quickshell/desktop-widgets.json" ] && saved_widgets=$(cat "$HOME/.config/quickshell/desktop-widgets.json")
    [ -f "$HOME/.config/quickshell/shell-customization.json" ] && saved_shell=$(cat "$HOME/.config/quickshell/shell-customization.json")
    [ -f "$HOME/.config/quickshell/locale.json" ] && saved_locale=$(cat "$HOME/.config/quickshell/locale.json")
    [ -f "$HOME/.config/kitty/kitty.conf" ] && saved_kitty=$(cat "$HOME/.config/kitty/kitty.conf")
    [ -f "$HOME/.config/hypr/user-binds.lua" ] && saved_user_binds=$(cat "$HOME/.config/hypr/user-binds.lua")
    # colors.conf é gerado pelo wallust a partir do wallpaper do usuário; o
    # repositório carrega uma cópia só pra primeira instalação. Sem salvar aqui,
    # toda atualização jogava a paleta do autor por cima das cores do usuário.
    local saved_colors=""
    [ -f "$HOME/.config/hypr/colors.conf" ] && saved_colors=$(cat "$HOME/.config/hypr/colors.conf")
    # Mesma história do colors.conf: o hyprlock-colors.conf é gerado pelo
    # wallust a partir do wallpaper do usuário, e o repositório só carrega uma
    # cópia pra primeira instalação.
    local saved_lock_colors=""
    [ -f "$HOME/.config/hypr/hyprlock-colors.conf" ] && saved_lock_colors=$(cat "$HOME/.config/hypr/hyprlock-colors.conf")

    # Copia as atualizações de componentes, temas e scripts
    # --remove-destination: sobrescrever um script que está rodando (como o
    # blur-fullscreen-toggle.sh, que fica em loop) corrompe a execução em curso.
    cp -a --remove-destination "$REPO_DIR/dots/hypr" "$HOME/.config/"
    cp -a --remove-destination "$REPO_DIR/dots/quickshell" "$HOME/.config/"
    cp -a --remove-destination "$REPO_DIR/dots/kitty" "$HOME/.config/"
    [ -d "$REPO_DIR/dots/wallust" ] && cp -a "$REPO_DIR/dots/wallust" "$HOME/.config/"
    [ -d "$REPO_DIR/dots/xdg-desktop-portal" ] && cp -a "$REPO_DIR/dots/xdg-desktop-portal" "$HOME/.config/"
    # fastfetch: o repositório traz módulos e cores novos, mas o bloco "logo"
    # é escolha do usuário (imagem, tamanho, padding). Um `cp -a` direto jogava
    # o config.jsonc do repo por cima e o ícone voltava pro padrão da distro a
    # cada atualização — e, como o repo não grava width/height, o logo
    # reaparecia no tamanho nativo, ocupando o terminal inteiro.
    if [ -d "$REPO_DIR/dots/fastfetch" ]; then
        local ff_user="$HOME/.config/fastfetch/config.jsonc"
        local ff_logo=""
        [ -f "$ff_user" ] && ff_logo=$(python3 - "$ff_user" <<'PYFF' 2>/dev/null || true
import json, re, sys
try:
    raw = open(sys.argv[1], encoding="utf-8").read()
    raw = re.sub(r'^\s*//.*$', '', raw, flags=re.MULTILINE)
    logo = json.loads(raw).get("logo")
    if logo and logo.get("source"):
        print(json.dumps(logo))
except Exception:
    pass
PYFF
)
        cp -a "$REPO_DIR/dots/fastfetch" "$HOME/.config/"
        if [ -n "$ff_logo" ]; then
            FF_LOGO="$ff_logo" python3 - "$ff_user" <<'PYFF' 2>/dev/null || true
import json, os, re, sys
try:
    path = sys.argv[1]
    raw = open(path, encoding="utf-8").read()
    raw = re.sub(r'^\s*//.*$', '', raw, flags=re.MULTILINE)
    cfg = json.loads(raw)
    cfg["logo"] = json.loads(os.environ["FF_LOGO"])
    with open(path, "w", encoding="utf-8") as f:
        json.dump(cfg, f, indent=4, ensure_ascii=False)
except Exception:
    pass
PYFF
        fi
    fi
    # mako: só instala se ainda não existir, pra não apagar os ajustes que o
    # usuário fez pela aba de Notificações do painel (rice-mako-apply).
    if [ -d "$REPO_DIR/dots/mako" ] && [ ! -f "$HOME/.config/mako/config" ]; then
        cp -a "$REPO_DIR/dots/mako" "$HOME/.config/"
    fi
    [ -d "$REPO_DIR/dots/applications" ] && cp -a "$REPO_DIR/dots/applications/"* "$HOME/.local/share/applications/" 2>/dev/null || true

    # [fix] Antes era um `cp -a` direto na pasta inteira. Quando um dos binários
    # estava EM EXECUÇÃO (o caso clássico é o waywallen-layer-shell, que fica
    # rodando o tempo todo desenhando o wallpaper), o kernel recusa a escrita com
    # "Área de texto ocupada" (ETXTBSY) — e, com `set -e`, a atualização inteira
    # abortava ali: as configurações novas já tinham sido copiadas, mas os
    # scripts de ~/.local/bin ficavam velhos e nem o `rice-hypr-prefs apply` nem
    # o `rice-restart` do final chegavam a rodar. O resultado era um sistema meio
    # atualizado, com toggles (blur, por exemplo) fora de sincronia.
    #
    # Apagar a entrada antiga antes de escrever resolve: o processo em execução
    # continua usando o inode antigo e o arquivo novo entra no lugar.
    mkdir -p "$HOME/.local/bin"
    busy_files=""
    for src in "$REPO_DIR/dots/bin/"*; do
        [ -f "$src" ] || continue
        name=$(basename "$src")
        dest="$HOME/.local/bin/$name"
        if ! install -m755 "$src" "$dest" 2>/dev/null; then
            rm -f "$dest" 2>/dev/null || true
            install -m755 "$src" "$dest" 2>/dev/null || busy_files="$busy_files $name"
        fi
    done
    if [ -n "$busy_files" ]; then
        echo -e "\e[1;33m[!] Não consegui atualizar agora:$busy_files\e[0m"
        echo -e "\e[1;33m    (estavam em uso — o próprio rice-update tenta de novo depois)\e[0m"
        mkdir -p "$HOME/.config/hollow-wired"
        printf '%s\n' $busy_files > "$HOME/.config/hollow-wired/pending-bins"
    else
        rm -f "$HOME/.config/hollow-wired/pending-bins" 2>/dev/null || true
    fi

    # Restaura imediatamente as configurações pessoais do usuário (NUNCA reseta o que foi customizado)
    [ -n "$saved_dock" ] && echo "$saved_dock" > "$HOME/.config/quickshell/dock.json"
    [ -n "$saved_widgets" ] && echo "$saved_widgets" > "$HOME/.config/quickshell/desktop-widgets.json"
    [ -n "$saved_shell" ] && echo "$saved_shell" > "$HOME/.config/quickshell/shell-customization.json"
    [ -n "$saved_locale" ] && echo "$saved_locale" > "$HOME/.config/quickshell/locale.json"
    [ -n "$saved_kitty" ] && echo "$saved_kitty" > "$HOME/.config/kitty/kitty.conf"
    [ -n "$saved_user_binds" ] && echo "$saved_user_binds" > "$HOME/.config/hypr/user-binds.lua"
    [ -n "$saved_colors" ] && echo "$saved_colors" > "$HOME/.config/hypr/colors.conf"
    [ -n "$saved_lock_colors" ] && echo "$saved_lock_colors" > "$HOME/.config/hypr/hyprlock-colors.conf"

    # 4. Correção automática de preferências (elimina flickering por VRR e bug de zoom 300%)
    for p_file in "$HOME/.config/hypr/user-prefs.json" "$HOME/.config/hypr/prefs.json"; do
        if [ -f "$p_file" ] && command -v jq >/dev/null 2>&1; then
            tmp_prefs=$(jq '.vrr = 0 | .monitor_scale = (.monitor_scale // 1)' "$p_file" 2>/dev/null || true)
            [ -n "$tmp_prefs" ] && echo "$tmp_prefs" > "$p_file"
        fi
    done

    install_new_packages "$interactive"

    # 5. Recarregar Hyprland ao vivo sem reiniciar a sessão nem fechar aplicativos
    echo -e "\e[1;34m[*] Recarregando compositor Hyprland...\e[0m"
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
        hyprctl eval "hl.config({ misc = { vrr = 0 }, render = { direct_scanout = 0 } })" >/dev/null 2>&1 || true
        hyprctl eval "hl.monitor({ output = '', mode = 'preferred', position = 'auto', scale = '1' })" >/dev/null 2>&1 || true
    fi
    "$HOME/.local/bin/rice-hypr-prefs" apply >/dev/null 2>&1 || true

    # 6. Reiniciar interface gráfica do Quickshell (0.5s de transição transparente)
    echo -e "\e[1;34m[*] Recarregando interface gráfica (Quickshell)...\e[0m"
    "$HOME/.local/bin/rice-restart" >/dev/null 2>&1 || true

    run_health_checks
    mark_synced

    notify-send -a "Rice Updater" -i system-software-update -r 91199 -t 4000 "Setup Atualizado com Sucesso!" "$COUNT novas melhorias foram aplicadas."

    echo -e "\n\e[1;32m════════════════════════════════════════════════════\e[0m"
    echo -e "\e[1;32m  [✓] ATUALIZAÇÃO CONCLUÍDA COM SUCESSO!\e[0m"
    echo -e "\e[1;32m════════════════════════════════════════════════════\e[0m"
    echo -e "Versão atual: \e[1;36m$REMOTE_HASH\e[0m"
    echo -e "Backup salvo em: \e[1;33m$BACKUP_DIR\e[0m"

    if [ "$interactive" = "true" ]; then
        echo ""
        read -r -p "Pressione ENTER para fechar..." _ || true
    fi
}

# ==============================================================================
# Passo de conserto (rice-doctor embutido).
#
# Pedido do usuário: "o rice-update tem que corrigir esse tipo de bug sozinho,
# além de achar bugs quando usa ele; o rice-update tem que ser um fix de
# problemas também". Cada verificação abaixo nasceu de um problema real
# relatado por alguém usando o rice.
#
# Regra de ouro: nada aqui pode derrubar a atualização. Tudo roda com `|| true`.
# ==============================================================================
FIXED_LIST=""
PROBLEM_LIST=""

fix_note() { FIXED_LIST="$FIXED_LIST
  \e[1;32m✓\e[0m $1"; }
problem_note() { PROBLEM_LIST="$PROBLEM_LIST
  \e[1;33m!\e[0m $1"; }

# 1. Binários que estavam em uso na última atualização (ETXTBSY). Ficam
#    anotados e são reinstalados assim que param de rodar.
retry_pending_bins() {
    local pend="$HOME/.config/hollow-wired/pending-bins"
    [ -f "$pend" ] || return 0
    local still=""
    while read -r name; do
        [ -n "$name" ] || continue
        local src="$REPO_DIR/dots/bin/$name"
        [ -f "$src" ] || continue
        if install -m755 "$src" "$HOME/.local/bin/$name" 2>/dev/null; then
            fix_note "utilitário pendente instalado: $name"
        else
            still="$still$name
"
        fi
    done < "$pend"
    printf '%s' "$still" > "$pend"
}

# 2. Notificações presas na tela / configuração do mako ignorada.
fix_notifications() {
    command -v rice-mako-apply >/dev/null 2>&1 || return 0
    local out
    out=$(rice-mako-apply doctor 2>/dev/null || true)
    case "$out" in
        *'"problems": []'*|"") return 0 ;;
    esac
    out=$(rice-mako-apply doctor --fix 2>/dev/null || true)
    if command -v jq >/dev/null 2>&1; then
        echo "$out" | jq -r '.fixed[]?' 2>/dev/null | while read -r line; do
            [ -n "$line" ] && echo "  notificações: $line"
        done
    fi
    fix_note "notificações verificadas e corrigidas"
}

# 3. Arquivos de estado do usuário corrompidos (JSON truncado depois de um
#    desligamento no meio de uma escrita) — o shell subia sem dock/widgets.
fix_broken_state() {
    command -v jq >/dev/null 2>&1 || return 0
    local f
    for f in "$HOME/.config/quickshell/dock.json" \
             "$HOME/.config/quickshell/desktop-widgets.json" \
             "$HOME/.config/quickshell/shell-customization.json" \
             "$HOME/.config/quickshell/locale.json" \
             "$HOME/.config/hypr/user-prefs.json" \
             "$HOME/.config/hypr/color-overrides.json"; do
        [ -f "$f" ] || continue
        if ! jq -e . "$f" >/dev/null 2>&1; then
            mv "$f" "$f.corrompido" 2>/dev/null || true
            local base="$REPO_DIR/dots/quickshell/$(basename "$f")"
            if [ -f "$base" ]; then
                cp "$base" "$f" 2>/dev/null || true
            else
                echo '{}' > "$f"
            fi
            fix_note "$(basename "$f") estava corrompido e foi restaurado"
        fi
    done
}

# 4. Scripts sem bit de execução (acontece ao copiar de FAT/pendrive ou ao
#    restaurar um backup).
fix_exec_bits() {
    local f fixed=0
    for f in "$HOME/.local/bin/rice-"* "$HOME/.config/hypr/scripts/"*.sh; do
        [ -f "$f" ] || continue
        if [ ! -x "$f" ]; then
            chmod +x "$f" 2>/dev/null && fixed=$((fixed + 1))
        fi
    done
    [ "$fixed" -gt 0 ] && fix_note "$fixed script(s) sem permissão de execução corrigidos"
    return 0
}

# 5. ~/.local/bin fora do PATH: os comandos rice-* simplesmente "não existem".
fix_path() {
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) return 0 ;;
    esac
    local line='set -gx PATH $HOME/.local/bin $PATH'
    local fishconf="$HOME/.config/fish/config.fish"
    if [ -f "$fishconf" ] && ! grep -q '.local/bin' "$fishconf" 2>/dev/null; then
        printf '\n# adicionado pelo rice-update\n%s\n' "$line" >> "$fishconf"
        fix_note "~/.local/bin adicionado ao PATH do fish (reabra o terminal)"
    fi
    if [ -f "$HOME/.bashrc" ] && ! grep -q '.local/bin' "$HOME/.bashrc" 2>/dev/null; then
        printf '\n# adicionado pelo rice-update\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$HOME/.bashrc"
        fix_note "~/.local/bin adicionado ao PATH do bash"
    fi
}

# 6. Serviços de fundo que caíram (ou foram mortos por uma atualização
#    anterior no meio do caminho).
fix_daemons() {
    [ -n "${WAYLAND_DISPLAY:-}" ] || return 0

    if command -v mako >/dev/null 2>&1 && ! pgrep -x mako >/dev/null 2>&1; then
        setsid mako >/dev/null 2>&1 &
        fix_note "serviço de notificações (mako) reiniciado"
    fi
    if command -v hypridle >/dev/null 2>&1 && ! pgrep -x hypridle >/dev/null 2>&1; then
        setsid hypridle >/dev/null 2>&1 &
        fix_note "hypridle reiniciado"
    fi
    # wl-clip-persist mantém o que foi copiado depois que o programa fecha.
    if command -v wl-clip-persist >/dev/null 2>&1 && ! pgrep -f wl-clip-persist >/dev/null 2>&1; then
        setsid wl-clip-persist --clipboard regular >/dev/null 2>&1 &
        fix_note "persistência da área de transferência reativada"
    fi
    # O watcher de blur é o caso que quebrou na máquina de um usuário: ele fica
    # em loop e foi sobrescrito em pleno voo por um `cp` antigo.
    local blur="$HOME/.config/hypr/scripts/blur-fullscreen-toggle.sh"
    if [ -f "$blur" ]; then
        local blur_pid
        blur_pid=$(pgrep -f blur-fullscreen-toggle.sh 2>/dev/null | head -1 || true)
        if [ -z "$blur_pid" ]; then
            setsid "$blur" >/dev/null 2>&1 &
            fix_note "toggle de blur não estava rodando e foi iniciado"
        elif [ "$blur" -nt "/proc/$blur_pid" ]; then
            # O script foi atualizado depois que o processo subiu: o bash segue
            # lendo o arquivo trocado a partir do ponto antigo e executa lixo.
            pkill -f blur-fullscreen-toggle.sh >/dev/null 2>&1 || true
            setsid "$blur" >/dev/null 2>&1 &
            fix_note "toggle de blur reiniciado com a versão nova do script"
        fi
    fi
    if ! pgrep -x quickshell >/dev/null 2>&1 && ! pgrep -x qs >/dev/null 2>&1; then
        problem_note "a interface (Quickshell) não está rodando — tentando subir"
        "$HOME/.local/bin/rice-restart" >/dev/null 2>&1 || true
    fi
}

# 7. Paleta de cores ausente (o Hyprland sobe sem cores e tudo fica cinza).
fix_colors() {
    if [ ! -s "$HOME/.config/hypr/colors.conf" ] && command -v rice-colors >/dev/null 2>&1; then
        rice-colors apply >/dev/null 2>&1 || true
        fix_note "paleta de cores regenerada"
    fi
}

fix_electron_gpu() {
    # Aplicativos Electron (Discord, principalmente) travando na abertura sem
    # mostrar nada.
    #
    # Dois problemas distintos, que juntos deixam o Discord rodando com 11
    # processos e nenhuma janela:
    #
    # 1. o settings.json do Discord traz `ozone-platform` dentro de
    #    chromiumSwitches. Junto com o que o Electron já passa por conta
    #    própria, o Chromium recebe `--ozone-platform` SEM valor e morre com
    #    "FATAL: Invalid ozone platform:";
    # 2. em laptop híbrido, o Chromium escolhia a dGPU NVIDIA e o processo de
    #    GPU morria com "GPU process isn't usable. Goodbye.". O DRI_PRIME=0 que
    #    o hyprland.lua passou a definir resolve isso para sessões novas.
    #
    # Aqui só o (1) é consertável sem reiniciar a sessão.
    local ds="$HOME/.config/discord/settings.json"
    [ -f "$ds" ] || return 0
    local out
    out=$(python3 - "$ds" <<'PYFIX' 2>/dev/null || true
import json, sys
path = sys.argv[1]
try:
    with open(path, encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
switches = data.get("chromiumSwitches")
if not isinstance(switches, dict) or "ozone-platform" not in switches:
    sys.exit(0)
switches.pop("ozone-platform", None)
data["chromiumSwitches"] = switches
with open(path, "w", encoding="utf-8") as f:
    json.dump(data, f, indent=2, ensure_ascii=False)
print("discord")
PYFIX
)
    [ -n "$out" ] && fix_note "Discord: removida a flag de ozone que impedia a janela de abrir"
    return 0
}

run_health_checks() {
    echo -e "\n\e[1;34m[*] Procurando e consertando problemas conhecidos...\e[0m"
    retry_pending_bins || true
    fix_notifications || true
    fix_broken_state || true
    fix_exec_bits || true
    fix_path || true
    fix_colors || true
    fix_daemons || true
    fix_electron_gpu || true

    if [ -n "$FIXED_LIST" ]; then
        echo -e "\e[1;32m[✓] Consertado:\e[0m$FIXED_LIST"
    else
        echo -e "\e[1;32m[✓] Nenhum problema encontrado.\e[0m"
    fi
    [ -n "$PROBLEM_LIST" ] && echo -e "\e[1;33m[!] Atenção:\e[0m$PROBLEM_LIST"
    return 0
}

cmd="${1:-apply}"

case "$cmd" in
    check|status)
        check_updates
        ;;
    apply|run)
        apply_updates true
        ;;
    apply-silent|auto)
        apply_updates false
        ;;
    sync|repair-sync|force)
        # Refaz a cópia das dotfiles mesmo sem commits novos (usado quando uma
        # atualização anterior morreu no meio).
        apply_updates true true
        ;;
    fix|doctor|conserta)
        # Só o passo de conserto, sem mexer no git.
        run_health_checks
        if [ "${2:-}" != "--quiet" ]; then
            echo ""
            read -r -p "Pressione ENTER para fechar..." _ || true
        fi
        ;;
    fix-gui)
        kitty --title "Consertando o rice" -e "$HOME/.local/bin/rice-update" fix &
        ;;
    gui)
        # Abre em janela dedicada do Kitty
        kitty --title "Atualizador de Dotfiles" -e "$HOME/.local/bin/rice-update" apply &
        ;;
    *)
        echo "Uso: $(basename "$0") [check|apply|sync|fix|gui|fix-gui]"
        exit 1
        ;;
esac
