#!/usr/bin/env bash
# ==============================================================================
# Gerenciador de Ações de Sessão do Rice
# ==============================================================================
ACTION="${1:-}"

case "$ACTION" in
    switch-user|greeter|login-screen)
        # "Encerrar sessão" não deveria fechar o que está aberto — a expectativa
        # (a mesma do Windows) é só voltar para a tela de login. O SDDM expõe
        # exatamente isso pelo D-Bus: um greeter novo num VT separado, com a
        # sessão atual intacta atrás dele. Entrando de novo, tudo volta como
        # estava. Fechar tudo de verdade virou uma ação separada (logout).
        if command -v hyprlock >/dev/null 2>&1 && ! pgrep -x hyprlock >/dev/null 2>&1; then
            hyprlock >/dev/null 2>&1 &
            sleep 0.3
        fi

        SEAT="${XDG_SEAT:-seat0}"
        SEAT_PATH="/org/freedesktop/DisplayManager/Seat${SEAT#seat}"
        if command -v busctl >/dev/null 2>&1 && busctl --system call \
                org.freedesktop.DisplayManager "$SEAT_PATH" \
                org.freedesktop.DisplayManager.Seat SwitchToGreeter >/dev/null 2>&1; then
            exit 0
        fi

        # LightDM, para quem não usa SDDM.
        if command -v dm-tool >/dev/null 2>&1 && dm-tool switch-to-greeter >/dev/null 2>&1; then
            exit 0
        fi

        # Sem gerenciador de login que saiba trocar de sessão: a tela fica
        # bloqueada, que é o mais próximo disso — e melhor do que fechar tudo
        # sem a pessoa ter pedido.
        loginctl lock-session "${XDG_SESSION_ID:-self}" 2>/dev/null || true
        notify-send -a "Sessão" -i system-lock-screen -t 6000 \
            "Tela bloqueada" \
            "O gerenciador de login não permite trocar de usuário sem fechar a sessão." 2>/dev/null || true
        ;;
    logout)
        # Encerrar a sessão deixava o PC numa tela preta para sempre, sem voltar
        # para a tela de login. O motivo estava aqui: o script mandava o
        # Hyprland sair, esperava 0,5s e disparava `loginctl terminate-session`
        # de qualquer jeito. Meio segundo não cobre o encerramento do Xwayland,
        # dos portals e do wallpaper, então o terminate-session sempre chegava no
        # meio do caminho e matava o `sddm-helper` junto com o resto da sessão.
        # O SDDM lê isso como "Process crashed", entra em estado de erro e não
        # reabre o greeter:
        #
        #     session-2.scope: Killing process 1601 (sddm-helper) with SIGTERM
        #     sddm: Auth: sddm-helper ... crashed (exit code 1)
        #
        # Saindo limpo, o Hyprland devolve o controle ao start-hyprland, o
        # sddm-helper termina com 0 e o SDDM traz a tela de login de volta
        # sozinho. O loginctl fica só como último recurso, quando o compositor
        # realmente travou.
        wait_hyprland_exit() {
            local tries="$1"
            while [ "$tries" -gt 0 ]; do
                pgrep -x Hyprland >/dev/null 2>&1 || return 0
                sleep 0.25
                tries=$((tries - 1))
            done
            return 1
        }

        if command -v hyprctl >/dev/null 2>&1; then
            hyprctl dispatch exit >/dev/null 2>&1 || true
            # até 15s para o compositor encerrar sozinho
            wait_hyprland_exit 60 && exit 0
        fi

        # Não saiu: pede educadamente ao processo e espera mais 5s.
        pkill -x Hyprland >/dev/null 2>&1 || true
        wait_hyprland_exit 20 && exit 0

        # Travou de verdade — aí sim derruba a sessão inteira.
        loginctl terminate-session "${XDG_SESSION_ID:-self}" 2>/dev/null \
            || loginctl terminate-user "$USER" 2>/dev/null || true
        ;;
    suspend|sleep)
        # Bloqueia a tela antes de dormir — senão a sessão volta destravada.
        if command -v hyprlock >/dev/null 2>&1 && ! pgrep -x hyprlock >/dev/null 2>&1; then
            hyprlock &
            sleep 0.3
        fi
        systemctl suspend
        ;;
    hibernate)
        if command -v hyprlock >/dev/null 2>&1 && ! pgrep -x hyprlock >/dev/null 2>&1; then
            hyprlock &
            sleep 0.3
        fi
        systemctl hibernate
        ;;
    reboot)
        systemctl reboot
        ;;
    poweroff|shutdown)
        systemctl poweroff
        ;;
    lock)
        if command -v hyprlock >/dev/null 2>&1; then
            hyprlock &
        fi
        ;;
    *)
        echo "Uso: rice-session-action [switch-user|logout|suspend|hibernate|reboot|poweroff|lock]"
        exit 1
        ;;
esac
