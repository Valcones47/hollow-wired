#!/bin/bash
set -e
echo "==> Instalando calibração de mouse do SDDM (flat profile, sensibilidade 0)..."
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
sudo mkdir -p /etc/X11/xorg.conf.d
if [ -f "$DOTS_DIR/etc/X11/xorg.conf.d/50-mouse.conf" ]; then
    sudo cp "$DOTS_DIR/etc/X11/xorg.conf.d/50-mouse.conf" /etc/X11/xorg.conf.d/50-mouse.conf
fi
echo "==> Sucesso! Sensibilidade do mouse no SDDM agora é idêntica ao Hyprland."
