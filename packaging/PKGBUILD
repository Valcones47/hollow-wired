provides=("$_pkgname")
conflicts=("$_pkgname")
source=("git+https://github.com/Valcones47/hollow-wired.git")
sha256sums=('SKIP')
install=hollow-wired.install

pkgver() {
    cd "$srcdir/$_pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$_pkgname"

    # Install utility scripts to /usr/bin
    install -dm755 "$pkgdir/usr/bin"
    for b in dots/bin/*; do
        [ -f "$b" ] && install -m755 "$b" "$pkgdir/usr/bin/"
    done

    # Install base configuration templates to /usr/share/hollow-wired
    install -dm755 "$pkgdir/usr/share/hollow-wired"
    cp -a dots "$pkgdir/usr/share/hollow-wired/"
    install -m755 install.sh "$pkgdir/usr/share/hollow-wired/"

    # Instala entradas de aplicativo .desktop
    if [ -d "dots/applications" ]; then
        install -dm755 "$pkgdir/usr/share/applications"
        install -m644 dots/applications/*.desktop "$pkgdir/usr/share/applications/"
    fi
}
