post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;32m  hollow-wired (Hyprland + Quickshell) installed successfully!\e[0m"
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "  To deploy dotfiles and scripts to your user account, run:"
    echo -e "    \e[1;36mrice-update apply\e[0m  (or /usr/share/hollow-wired/install.sh)"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    echo -e "\e[1;36m=================================================================\e[0m"
    echo -e "\e[1;36m  hollow-wired update detected!\e[0m"
    echo -e "\e[1;36m=================================================================\e[0m"
    echo -e "  To apply new changes to your user configuration, run:"
    echo -e "    \e[1;32mrice-update apply\e[0m"
    echo -e "\e[1;36m=================================================================\e[0m"
}
