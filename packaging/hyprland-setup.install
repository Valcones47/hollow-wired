post_install() {
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "\e[1;32m  Hyprland Setup (Quickshell Rice) instalado com sucesso!\e[0m"
    echo -e "\e[1;32m=================================================================\e[0m"
    echo -e "  Para aplicar os arquivos de configuração na sua conta de usuário,"
    echo -e "  execute o comando a qualquer momento:"
    echo -e "    \e[1;36mrice-update apply\e[0m  (ou execute /usr/share/hyprland-setup/install.sh)"
    echo -e "\e[1;32m=================================================================\e[0m"
}

post_upgrade() {
    echo -e "\e[1;36m=================================================================\e[0m"
    echo -e "\e[1;36m  Atualização do Hyprland Setup detectada!\e[0m"
    echo -e "\e[1;36m=================================================================\e[0m"
    echo -e "  Para aplicar as novidades e correções no seu usuário:"
    echo -e "    \e[1;32mrice-update apply\e[0m"
    echo -e "\e[1;36m=================================================================\e[0m"
}
